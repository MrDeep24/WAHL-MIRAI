## .gitignore para Wahl Mirai (ASP.NET Core 9.0, MySQL, Android y herramientas)

# Archivos compilados y carpetas de salida (.NET)
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
**/publish/

# Binarios ejecutables locales y salida regenerada de Tailwind CSS
tailwindcss.exe
tailwindcss*.exe
wwwroot/css/site.css
**/wwwroot/css/site.css

# Archivos de configuración de IDE / Entorno de desarrollo
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
.idea/

# Logs y temporales
*.log
backup.log
*.tmp
logs/
.DS_Store
Thumbs.db

# Caché de paquetes NuGet y entorno Python
*.nuget.props
*.nuget.targets
**/packages/
venv/

# Datos sensibles, llaves Data Protection y archivos subidos (NUNCA al repositorio)
keys/
App_Data/
WahlMirai.Web/wwwroot/uploads/**
!WahlMirai.Web/wwwroot/uploads/.gitkeep
WahlMirai.Web/App_Data/candidacy-uploads/**
!WahlMirai.Web/App_Data/candidacy-uploads/.gitkeep
**/candidacy-uploads/**
*.enc

# Secretos y configuración local
appsettings.Development.json
appsettings.Production.json
secrets
secrets.json
.env*
*.env

# Respaldos y dumps operativos con datos reales (no afecta docs/wahl_mirai_db_*.sql)
*.7z
db_*.7z
files_*.7z
db_*.sql
backup_*.sql

# Salidas regenerables de auditoría i18n
scripts/missing-strings-export.json
scripts/missing-strings-filtered-out.json

# Estado local y snapshots temporales de Graphify
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/converted/

# App Móvil Android / Kotlin / Gradle (WahlMirai.Movil)
**/.gradle/
**/.kotlin/
**/local.properties
WahlMirai.Movil/**/build/
WahlMirai.Movil/captures/
WahlMirai.Movil/**/.externalNativeBuild/
WahlMirai.Movil/**/.cxx/
*.iml
*.hprof
*.apk
*.ap_
*.aab
*.dex
*.keystore
*.jks
