@model RegistroStep2ViewModel
@{
    ViewData["Title"] = "Crear mi cuenta - Paso 2";
    Layout = "_Layout";
}

<main class="min-h-screen flex items-center justify-center p-4 md:p-6 relative bg-cover bg-center bg-no-repeat" style="background-image: url('/images/login-background.jpg.jpg');">
    <div class="absolute inset-0 bg-slate-900/35 backdrop-blur-[2px]"></div>

    <div class="w-full max-w-md bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/40 p-6 md:p-8 relative z-10 overflow-hidden fade-in">
        <div class="absolute top-0 left-0 right-0 h-2 bg-primary"></div>

        <div class="mb-4">
            <a asp-controller="Auth" asp-action="Registro" class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface-variant hover:text-primary transition-colors py-2 px-2.5 min-h-[44px] rounded-lg hover:bg-surface-container-low">
                <span class="material-symbols-outlined text-base">arrow_back</span> Volver al paso 1
            </a>
        </div>

        <div class="flex flex-col items-center mb-6">
            <div class="w-16 h-16 mb-4 rounded-xl flex items-center justify-center">
                <img src="/images/logo.png" alt="Wahl Mirai Logo" class="w-16 h-16 rounded-xl object-cover shadow-sm" onerror="this.src='/images/imagen_voto.png'" />
            </div>
            <h1 class="text-2xl font-bold text-primary text-center">Crear mi cuenta</h1>
            <p class="text-sm text-on-surface-variant text-center mt-1">Sistema de Votación Estudiantil</p>
        </div>

        <div class="flex items-center gap-2 mb-6">
            <div class="flex items-center gap-2 flex-1">
                <div class="w-7 h-7 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center text-xs font-bold shrink-0">
                    <span class="material-symbols-outlined text-sm">check</span>
                </div>
                <span class="text-xs text-on-surface-variant">Documento verificado</span>
            </div>
            <div class="h-px flex-1 bg-primary"></div>
            <div class="flex items-center gap-2 flex-1 justify-end">
                <span class="text-xs font-semibold text-primary">Configurar cuenta</span>
                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center text-xs font-bold shrink-0">2</div>
            </div>
        </div>

        <div class="bg-primary/8 border border-primary/20 rounded-xl p-4 mb-5 flex items-start gap-3">
            <span class="material-symbols-outlined text-primary text-xl mt-0.5 shrink-0">verified_user</span>
            <div>
                <p class="text-xs font-semibold text-primary mb-1 uppercase tracking-wide">Datos de identidad verificados</p>
                <p class="text-sm font-semibold text-on-surface">@Model.FullName</p>
                <p class="text-xs text-on-surface-variant">Grado: @Model.GradeName</p>
                <p class="text-xs text-on-surface-variant mt-1 italic">
                    Estos datos provienen de la lista de censo autorizado y no pueden modificarse aquí.
                </p>
            </div>
        </div>

        <form asp-action="Completar" method="post" class="flex flex-col gap-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="WhitelistId" />
            <input type="hidden" asp-for="FullName" />
            <input type="hidden" asp-for="GradeName" />
            <input type="hidden" asp-for="Document" />

            <div asp-validation-summary="ModelOnly" class="text-sm text-error bg-error-container/30 border border-error/30 rounded-lg px-4 py-3 -mt-2 leading-relaxed"></div>

            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold" asp-for="ContactEmail">Correo de contacto</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">mail</span>
                    <input id="compl-email-input" asp-for="ContactEmail" type="email" class="w-full pl-10 pr-4 py-3 bg-surface border border-outline-variant rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="tu@correo.com" autocomplete="email" />
                </div>
                <span asp-validation-for="ContactEmail" class="text-xs text-error"></span>
                <p class="text-xs text-on-surface-variant">Solo se usa para recuperación de acceso. <strong>No</strong> es tu usuario de inicio de sesión.</p>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold" asp-for="Password">Contraseña</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">key</span>
                    <input id="compl-password-input" asp-for="Password" type="password" class="w-full pl-10 pr-11 py-3 bg-surface border border-outline-variant rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
                    <button type="button" id="toggle-pass-btn" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface p-1 rounded-md transition-colors flex items-center justify-center min-h-[36px] min-w-[36px]" aria-label="Mostrar u ocultar contraseña">
                        <span id="toggle-pass-icon" class="material-symbols-outlined text-xl select-none">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-xs text-error"></span>
                <ul class="text-xs text-on-surface-variant space-y-0.5 pl-1" id="pwd-hints">
                    <li id="hint-len" class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-outline">circle</span> Mínimo 8 caracteres</li>
                    <li id="hint-upper" class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-outline">circle</span> Al menos una letra mayúscula</li>
                    <li id="hint-sym" class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-outline">circle</span> Al menos un símbolo especial (!@@#$%^&*()_+-=...)</li>
                </ul>
            </div>

            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold" asp-for="ConfirmPassword">Confirmar contraseña</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">key</span>
                    <input id="compl-confirm-input" asp-for="ConfirmPassword" type="password" class="w-full pl-10 pr-11 py-3 bg-surface border border-outline-variant rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="Repite la contraseña" autocomplete="new-password" />
                    <button type="button" id="toggle-confirm-btn" class="absolute right-3 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface p-1 rounded-md transition-colors flex items-center justify-center min-h-[36px] min-w-[36px]" aria-label="Mostrar u ocultar confirmación">
                        <span id="toggle-confirm-icon" class="material-symbols-outlined text-xl select-none">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-xs text-error"></span>
            </div>

            <button type="submit" id="compl-submit-btn" class="w-full bg-primary hover:bg-primary/90 text-on-primary font-semibold py-3 min-h-[44px] rounded-lg transition-colors flex items-center justify-center gap-2 mt-1">
                Crear mi cuenta <span class="material-symbols-outlined">how_to_reg</span>
            </button>

            <p class="text-xs text-on-surface-variant text-center">
                ¿Ya tienes una cuenta?
                <a asp-controller="Auth" asp-action="Login" class="text-primary font-semibold hover:underline">Iniciar sesión</a>
            </p>
        </form>
    </div>
</main>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/auth-completar.js"></script>
    <style>
        @@keyframes spin { to { transform: rotate(360deg); } }
        .bg-primary\/8 { background-color: rgb(from var(--md-sys-color-primary, #1a56db) r g b / 0.08); }
    </style>
}
