@model RegistroStep1ViewModel
@{
    ViewData["Title"] = "Crear mi cuenta";
    Layout = "_Layout";
}

<main class="min-h-screen flex items-center justify-center p-4 md:p-6 relative bg-cover bg-center bg-no-repeat" style="background-image: url('/images/login-background.jpg.jpg');">
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]"></div>

    <div class="w-full max-w-md bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/40 dark:border-slate-800 p-6 md:p-8 relative z-10 overflow-hidden fade-in text-on-surface dark:text-slate-100">
        <!-- Color bar top -->
        <div class="absolute top-0 left-0 right-0 h-2 bg-primary"></div>

        <!-- Barra superior: Volver -->
        <div class="flex items-center justify-between gap-2 mb-4">
            <a asp-controller="Auth" asp-action="Login"
               class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface-variant dark:text-slate-300 hover:text-primary dark:hover:text-blue-400 transition-colors py-1.5 px-2 min-h-[40px] rounded-lg hover:bg-surface-container-low dark:hover:bg-slate-800">
                <span class="material-symbols-outlined text-base">arrow_back</span> Volver
            </a>
        </div>

        <!-- Header -->
        <div class="flex flex-col items-center mb-8">
            <div class="w-16 h-16 mb-4 rounded-xl flex items-center justify-center">
                <img src="/images/logo.png" alt="Wahl Mirai Logo"
                     class="w-16 h-16 rounded-xl object-cover shadow-sm"
                     onerror="this.src='/images/imagen_voto.png'" />
            </div>
            <h1 class="text-2xl font-bold text-primary dark:text-blue-400 text-center">Crear mi cuenta</h1>
            <p class="text-sm text-on-surface-variant dark:text-slate-400 text-center mt-1">Sistema de Votación Estudiantil</p>
        </div>

        <!-- Step indicator -->
        <div class="flex items-center gap-2 mb-6">
            <div class="flex items-center gap-2 flex-1">
                <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center text-xs font-bold shrink-0">1</div>
                <span class="text-xs font-semibold text-primary dark:text-blue-400">Verificar documento</span>
            </div>
            <div class="h-px flex-1 bg-outline-variant dark:bg-slate-700"></div>
            <div class="flex items-center gap-2 flex-1 justify-end">
                <span class="text-xs text-outline dark:text-slate-400">Configurar cuenta</span>
                <div class="w-7 h-7 rounded-full bg-surface-container dark:bg-slate-800 text-outline dark:text-slate-400 flex items-center justify-center text-xs font-bold shrink-0">2</div>
            </div>
        </div>

        <p class="text-sm text-on-surface-variant dark:text-slate-300 mb-5 leading-relaxed">
            Ingresa tu número de documento para verificar si estás autorizado/a a registrarte en el sistema.
        </p>

        <!-- Feedback banners based on FailureReason (RF-M01-00, RN-1, RN-15) -->
        @if (Model.FailureReason == RegistroFailureReason.NotFound)
        {
            <div class="mb-4 p-3 bg-error-container/30 border border-error/30 text-error rounded-lg text-xs leading-relaxed flex items-start gap-2">
                <span class="material-symbols-outlined text-base shrink-0 mt-0.5">error</span>
                <span>El número de documento ingresado no se encuentra registrado en el censo estudiantil. Verifica el número o contacta a la coordinación escolar.</span>
            </div>
        }
        else if (Model.FailureReason == RegistroFailureReason.AlreadyClaimed)
        {
            <div class="mb-4 p-3 bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 rounded-lg text-xs leading-relaxed flex flex-col gap-2">
                <div class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-base shrink-0 mt-0.5">account_circle</span>
                    <span>Este documento ya cuenta con un usuario registrado en el sistema.</span>
                </div>
                <div class="flex items-center gap-3 pt-1 border-t border-amber-500/20 text-xs">
                    <a asp-controller="Auth" asp-action="Login" class="font-semibold text-primary dark:text-blue-400 hover:underline inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">login</span> Iniciar sesión
                    </a>
                    <span class="text-on-surface-variant dark:text-slate-500">•</span>
                    <a asp-controller="RecuperacionAcceso" asp-action="Recuperar" class="font-semibold text-primary dark:text-blue-400 hover:underline inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">lock_reset</span> Recuperar acceso
                    </a>
                </div>
            </div>
        }
        else if (Model.FailureReason == RegistroFailureReason.NoContactEmail)
        {
            <div class="mb-4 p-3 bg-error-container/30 border border-error/30 text-error rounded-lg text-xs leading-relaxed flex items-start gap-2">
                <span class="material-symbols-outlined text-base shrink-0 mt-0.5">mail_off</span>
                <span>Tu registro censal no cuenta con un correo de contacto preautorizado. Por favor acércate a la coordinación escolar para registrar tu correo institucional.</span>
            </div>
        }
        else if (Model.FailureReason == RegistroFailureReason.Cooldown)
        {
            <div class="mb-4 p-3 bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 rounded-lg text-xs leading-relaxed flex items-start gap-2">
                <span class="material-symbols-outlined text-base shrink-0 mt-0.5">schedule</span>
                <span>Debes esperar @Model.CooldownRemainingSeconds segundos antes de solicitar un nuevo código de verificación.</span>
            </div>
        }
        else if (Model.FailureReason == RegistroFailureReason.SendFailed)
        {
            <div class="mb-4 p-3 bg-error-container/30 border border-error/30 text-error rounded-lg text-xs leading-relaxed flex items-start gap-2">
                <span class="material-symbols-outlined text-base shrink-0 mt-0.5">send_time_extension</span>
                <span>No fue posible enviar el código de verificación por correo electrónico. Por favor intenta de nuevo en unos minutos.</span>
            </div>
        }
        else if (Model.FailureReason == RegistroFailureReason.Locked)
        {
            <div class="mb-4 p-3 bg-error-container/30 border border-error/30 text-error rounded-lg text-xs leading-relaxed flex items-start gap-2">
                <span class="material-symbols-outlined text-base shrink-0 mt-0.5">lock</span>
                <span>Demasiados intentos fallidos desde esta conexión. Espera unos minutos e inténtalo de nuevo, o contacta al Administrador institucional.</span>
            </div>
        }

        <form asp-action="Registro" method="post" class="flex flex-col gap-5">
            @Html.AntiForgeryToken()
            @if (Model.FailureReason == RegistroFailureReason.None)
            {
                <div asp-validation-summary="ModelOnly"
                     class="text-sm text-error bg-error-container/30 border border-error/30 rounded-lg px-4 py-3 -mt-2 leading-relaxed"></div>
            }

            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-800 dark:text-slate-200" asp-for="Document">Número de documento</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline dark:text-slate-400">badge</span>
                    <input id="reg-document-input"
                           asp-for="Document"
                           pattern="\d+"
                           title="Ingrese únicamente dígitos numéricos"
                           inputmode="numeric"
                           class="w-full pl-10 pr-4 py-3 bg-surface dark:bg-slate-800 border border-outline-variant dark:border-slate-700 dark:text-white rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                           placeholder="Ej: 1020304050"
                           autocomplete="off"
                           required
                           oninput="this.value = this.value.replace(/\D/g, ''); this.setCustomValidity(this.value.trim() ? '' : translateText('DOCUMENT_REQUIRED'));" />
                </div>
                <span asp-validation-for="Document" class="text-xs text-error"></span>
            </div>

            <button type="submit" id="reg-submit-btn"
                    class="w-full bg-primary hover:bg-primary/90 text-on-primary font-semibold py-3 min-h-[44px] rounded-lg transition-colors flex items-center justify-center gap-2">
                Verificar documento <span class="material-symbols-outlined">search</span>
            </button>

            <div class="flex flex-col gap-2 items-center pt-1">
                <p class="text-xs text-on-surface-variant dark:text-slate-400 text-center">
                    ¿Ya tienes una cuenta?
                    <a asp-controller="Auth" asp-action="Login" class="text-primary dark:text-blue-400 font-semibold hover:underline">Iniciar sesión</a>
                </p>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const regDocumentInput = document.getElementById('reg-document-input');

        regDocumentInput?.addEventListener('invalid', function () {
            if (this.validity.valueMissing) {
                this.setCustomValidity(translateText('DOCUMENT_REQUIRED'));
            } else if (this.validity.patternMismatch) {
                this.setCustomValidity(translateText('DIGITS_ONLY'));
            } else {
                this.setCustomValidity('');
            }
        });

        regDocumentInput?.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '');
            if (this.value.trim().length === 0) {
                this.setCustomValidity(translateText('DOCUMENT_REQUIRED'));
            } else {
                this.setCustomValidity('');
            }
        });

        // Prevent double-submit
        document.getElementById('reg-submit-btn')?.addEventListener('click', function () {
            const form = this.closest('form');
            if (form && form.checkValidity()) {
                this.disabled = true;
                this.innerHTML = `<span class="material-symbols-outlined animate-spin" style="animation:spin 1s linear infinite">autorenew</span> ${translateText('VERIFYING')}`;
                form.submit();
            }
        });
    </script>
    <style>
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
}
