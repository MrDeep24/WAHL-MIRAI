@model VerificarCodigoViewModel
@{
    ViewData["Title"] = "Verificar código — Paso 2";
    Layout = "_Layout";
}

<main class="min-h-screen flex items-center justify-center p-4 md:p-6 relative bg-cover bg-center bg-no-repeat" style="background-image: url('/images/login-background.jpg.jpg');">
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]"></div>

    <div class="w-full max-w-md bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/40 dark:border-slate-800 p-6 md:p-8 relative z-10 overflow-hidden fade-in text-on-surface dark:text-slate-100">
        <!-- Color bar top -->
        <div class="absolute top-0 left-0 right-0 h-2 bg-primary"></div>

        <!-- Barra superior: Volver -->
        <div class="flex items-center justify-between gap-2 mb-4">
            <a asp-controller="Auth" asp-action="Registro"
               class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface-variant dark:text-slate-300 hover:text-primary dark:hover:text-blue-400 transition-colors py-1.5 px-2 min-h-[40px] rounded-lg hover:bg-surface-container-low dark:hover:bg-slate-800">
                <span class="material-symbols-outlined text-base">arrow_back</span> Volver al inicio
            </a>
        </div>

        <!-- Header -->
        <div class="flex flex-col items-center mb-6">
            <div class="w-16 h-16 mb-4 rounded-xl flex items-center justify-center">
                <img src="/images/logo.png" alt="Wahl Mirai Logo"
                     class="w-16 h-16 rounded-xl object-cover shadow-sm"
                     onerror="this.src='/images/imagen_voto.png'" />
            </div>
            <h1 class="text-2xl font-bold text-primary dark:text-blue-400 text-center">Verificar código</h1>
            <p class="text-sm text-on-surface-variant dark:text-slate-400 text-center mt-1">Sistema de Votación Estudiantil</p>
        </div>

        <!-- Step indicator (3 pasos) -->
        <div class="flex items-center gap-2 mb-6">
            <div class="flex items-center gap-1.5 flex-1">
                <div class="w-6 h-6 rounded-full bg-surface-container dark:bg-slate-800 text-on-surface-variant dark:text-slate-300 flex items-center justify-center text-xs font-bold shrink-0">
                    <span class="material-symbols-outlined text-sm">check</span>
                </div>
                <span class="text-[11px] text-on-surface-variant dark:text-slate-400">Documento</span>
            </div>
            <div class="h-px flex-1 bg-primary"></div>
            <div class="flex items-center gap-1.5 flex-1 justify-center">
                <div class="w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center text-xs font-bold shrink-0">2</div>
                <span class="text-[11px] font-semibold text-primary dark:text-blue-400">Código OTP</span>
            </div>
            <div class="h-px flex-1 bg-outline-variant dark:bg-slate-700"></div>
            <div class="flex items-center gap-1.5 flex-1 justify-end">
                <div class="w-6 h-6 rounded-full bg-surface-container dark:bg-slate-800 text-outline dark:text-slate-400 flex items-center justify-center text-xs font-bold shrink-0">3</div>
                <span class="text-[11px] text-outline dark:text-slate-400">Cuenta</span>
            </div>
        </div>

        <!-- Feedback alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-4 p-3 bg-green-500/10 border border-green-500/30 text-green-700 dark:text-green-300 rounded-lg text-xs leading-relaxed">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="mb-4 p-3 bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 rounded-lg text-xs leading-relaxed">
                @TempData["Warning"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-4 p-3 bg-error-container/30 border border-error/30 text-error rounded-lg text-xs leading-relaxed">
                @TempData["Error"]
            </div>
        }

        <!-- Generic instructions (Anti-enumeration, RN-1, RN-15) -->
        <div class="bg-primary/5 dark:bg-blue-500/10 border border-primary/20 dark:border-blue-400/30 rounded-xl p-4 mb-5 flex items-start gap-3">
            <span class="material-symbols-outlined text-primary dark:text-blue-400 text-xl mt-0.5 shrink-0">mail</span>
            <div class="text-xs text-on-surface-variant dark:text-slate-300 leading-relaxed">
                Si tu documento está registrado en el censo estudiantil, hemos enviado un código de 6 dígitos a tu correo autorizado. Ingrésalo a continuación para continuar.
            </div>
        </div>

        <form asp-action="VerificarCodigo" method="post" class="flex flex-col gap-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-error bg-error-container/30 border border-error/30 rounded-lg px-4 py-3 -mt-2 leading-relaxed"></div>

            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-semibold text-slate-800 dark:text-slate-200" asp-for="OtpCode">Código de verificación</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline dark:text-slate-400">pin</span>
                    <input id="verify-otp-input"
                           asp-for="OtpCode"
                           type="text"
                           inputmode="numeric"
                           pattern="\d{6}"
                           maxlength="6"
                           required
                           autofocus
                           class="w-full pl-10 pr-4 py-3 bg-surface dark:bg-slate-800 border border-outline-variant dark:border-slate-700 dark:text-white rounded-lg font-mono-id tracking-widest text-lg text-center focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                           placeholder="123456"
                           autocomplete="one-time-code" />
                </div>
                <span asp-validation-for="OtpCode" class="text-xs text-error"></span>
                <div class="flex items-center justify-between text-xs text-on-surface-variant dark:text-slate-400 mt-1">
                    <span>Válido por 15 minutos</span>
                </div>
            </div>

            <button type="submit" id="verify-submit-btn"
                    class="w-full bg-primary hover:bg-primary/90 text-on-primary font-semibold py-3 min-h-[44px] rounded-lg transition-colors flex items-center justify-center gap-2 mt-1 shadow-sm">
                Verificar código <span class="material-symbols-outlined">arrow_forward</span>
            </button>
        </form>

        <!-- Formulario secundario para Reenviar código (POST con CSRF y cooldown) -->
        <div class="flex items-center justify-center pt-4 border-t border-outline-variant/30 dark:border-slate-800 mt-4">
            <form asp-action="ResendOtp" method="post" class="inline">
                @Html.AntiForgeryToken()
                <span class="text-xs text-on-surface-variant dark:text-slate-400">¿No recibiste el código?</span>
                <button type="submit" id="resend-otp-btn"
                        class="text-xs text-primary dark:text-blue-400 font-semibold hover:underline bg-transparent border-none cursor-pointer p-0 ml-1">
                    Reenviar código
                </button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const otpInput = document.getElementById('verify-otp-input');
        otpInput?.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 6);
        });

        // Prevent double submit
        document.getElementById('verify-submit-btn')?.addEventListener('click', function () {
            const form = this.closest('form');
            if (form && form.checkValidity()) {
                this.disabled = true;
                this.innerHTML = '<span class="material-symbols-outlined animate-spin" style="animation:spin 1s linear infinite">autorenew</span> ' + (typeof translateText === 'function' ? translateText('VERIFYING') : 'Verificando...');
                form.submit();
            }
        });
    </script>
    <style>
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
}
