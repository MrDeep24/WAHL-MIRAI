@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "_Layout";
}

<main class="min-h-screen flex items-center justify-center p-4 md:p-6 relative bg-cover bg-center bg-no-repeat" style="background-image: url('/images/login-background.jpg.jpg');">
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]"></div>
    
    <div class="w-full max-w-md bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/40 dark:border-slate-800 p-6 md:p-8 relative z-10 fade-in text-on-surface dark:text-slate-100">
        <!-- Top bar with theme toggle -->
        <div class="flex items-center justify-end mb-4">
            <button type="button" class="theme-toggle flex items-center justify-center p-1.5 rounded-lg bg-surface-container-low dark:bg-slate-800 hover:bg-surface-container dark:hover:bg-slate-700 border border-border-subtle dark:border-slate-700 text-on-surface-variant dark:text-slate-200 hover:text-primary dark:hover:text-blue-400 transition-colors cursor-pointer" title="Modo oscuro / claro" aria-label="Modo oscuro / claro">
                <span class="material-symbols-outlined text-lg">dark_mode</span>
            </button>
        </div>

        <div class="flex flex-col items-center mb-6">
            <div class="w-14 h-14 mb-3 rounded-xl bg-amber-500/10 dark:bg-amber-400/15 flex items-center justify-center text-amber-600 dark:text-amber-400">
                <span class="material-symbols-outlined text-2xl">lock_reset</span>
            </div>
            <h1 class="text-xl font-bold text-primary dark:text-blue-400 text-center">Debes cambiar tu contraseña</h1>
            <p class="text-sm text-on-surface-variant dark:text-slate-400 text-center mt-1">Es tu primer ingreso con la clave autogenerada. Define una nueva antes de continuar.</p>
        </div>
        
        <form asp-action="CambiarClave" method="post" class="flex flex-col gap-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-error"></div>

            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-800 dark:text-slate-200" asp-for="NewPassword">Nueva contraseña</label>
                <input asp-for="NewPassword" type="password" class="w-full px-4 py-3 bg-surface dark:bg-slate-800 border border-outline-variant dark:border-slate-700 dark:text-white rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary" required minlength="8">
                <span asp-validation-for="NewPassword" class="text-xs text-error"></span>
            </div>
            
            <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-800 dark:text-slate-200" asp-for="ConfirmPassword">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" type="password" class="w-full px-4 py-3 bg-surface dark:bg-slate-800 border border-outline-variant dark:border-slate-700 dark:text-white rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary" required minlength="8">
                <span asp-validation-for="ConfirmPassword" class="text-xs text-error"></span>
            </div>

            <button type="submit" class="w-full bg-secondary text-on-secondary font-semibold py-3 rounded-lg mt-2 hover:bg-secondary/90 transition-colors shadow-sm">Guardar y continuar</button>
        </form>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
