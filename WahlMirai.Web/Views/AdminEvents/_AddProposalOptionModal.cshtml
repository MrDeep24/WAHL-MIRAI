@model WahlMirai.Web.Models.VotingEvent

<div id="proposal-option-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
     onclick="if(event.target===this) this.classList.add('hidden')">
    <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-md w-full p-5 md:p-6">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold">Añadir Opción Temática</h3>
            <button onclick="document.getElementById('proposal-option-modal').classList.add('hidden')">
                <span class="material-symbols-outlined hover:text-error transition-colors">close</span>
            </button>
        </div>

        <form action="/AdminEvents/AddProposalOption" method="post" class="flex flex-col gap-4">
            <input type="hidden" name="eventId" value="@Model.Id" />
            
            <div>
                <label class="text-sm font-semibold block mb-1">Nombre de la Opción *</label>
                <input type="text" name="name" required placeholder="Ej. Presupuesto Participativo"
                       class="w-full px-3 py-2 min-h-[44px] border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            </div>
            
            <div>
                <label class="text-sm font-semibold block mb-1">Resumen o Descripción Corta</label>
                <textarea name="slogan" rows="2" placeholder="Opcional"
                          class="w-full px-3 py-2 min-h-[44px] border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"></textarea>
            </div>
            
            <div>
                <label class="text-sm font-semibold block mb-1">URL Imagen Ilustrativa</label>
                <input type="url" name="photoUrl" placeholder="https://..."
                       class="w-full px-3 py-2 min-h-[44px] border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            </div>

            <button type="submit"
                    class="w-full bg-primary text-on-primary font-semibold py-2.5 min-h-[44px] rounded-lg mt-2 hover:bg-primary/90 transition-colors flex items-center justify-center">
                Guardar Opción
            </button>
        </form>
    </div>
</div>
