@model WahlMirai.Web.Models.VotingEvent
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nuevo Proceso Electoral" : "Configurar Proceso Electoral";
    Layout = "_AdminLayout";
    
    var grades = ViewBag.Grades as List<WahlMirai.Web.Models.Grade> ?? new List<WahlMirai.Web.Models.Grade>();
    var positions = ViewBag.Positions as List<WahlMirai.Web.Models.ElectionPosition> ?? new List<WahlMirai.Web.Models.ElectionPosition>();
    var selectedGradeIds = Model.EventGrades?.Select(eg => eg.GradeId).ToList() ?? new List<byte>();
    var positionRequirements = ViewBag.PositionRequirements as List<WahlMirai.Web.Models.PositionRequirement> ?? new List<WahlMirai.Web.Models.PositionRequirement>();
}

<div class="fade-in w-full max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a href="/AdminEvents" class="w-10 h-10 min-h-[44px] min-w-[44px] rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface-variant transition-colors">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-3xl font-bold mb-1">@(isNew ? "Nuevo Proceso Electoral" : "Configurar Proceso Electoral")</h1>
            <p class="text-on-surface-variant">@(isNew ? "Define los parámetros iniciales del evento." : "Modifica los parámetros y gestiona candidatos u opciones.")</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-status-active/10 text-status-active px-4 py-3 rounded-lg mb-6 text-sm font-medium">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-status-deleted/10 text-status-deleted px-4 py-3 rounded-lg mb-6 text-sm font-medium">
            @TempData["Error"]
        </div>
    }

    <form method="post" action="@(isNew ? "/AdminEvents/Create" : "/AdminEvents/Edit")" class="bg-surface-container-lowest border border-border-subtle rounded-xl p-6 md:p-8 shadow-card mb-8">
        @if (!isNew)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }
        
        <h2 class="text-lg font-bold mb-4">Parámetros Generales</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
            <div class="md:col-span-2">
                <label class="text-sm font-semibold block mb-1">Título del Proceso *</label>
                <input type="text" name="Title" value="@Model.Title" required
                       class="w-full px-3 py-2 min-h-[44px] bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
            </div>
            <div class="md:col-span-2">
                <label class="text-sm font-semibold block mb-1">Descripción</label>
                <textarea name="Description" rows="2"
                          class="w-full px-3 py-2 min-h-[44px] bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">@Model.Description</textarea>
            </div>
            
            <div>
                <label class="text-sm font-semibold block mb-1">Tipo de Elección *</label>
                @if (isNew)
                {
                    <select name="ElectionType" class="w-full px-3 py-2 min-h-[44px] bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                        <option value="PERSONAS" selected="@(Model.ElectionType == "PERSONAS")">Personas (Candidatos Estudiantiles)</option>
                        <option value="TEMAS" selected="@(Model.ElectionType == "TEMAS")">Temas (Proyectos / Opciones)</option>
                    </select>
                }
                else
                {
                    <input type="text" value="@Model.ElectionType" disabled class="w-full px-3 py-2 min-h-[44px] bg-surface-container-low border border-outline-variant rounded-lg text-on-surface-variant cursor-not-allowed">
                    <input type="hidden" name="ElectionType" value="@Model.ElectionType" />
                }
            </div>

            <div>
                <label class="text-sm font-semibold block mb-1">Cargo Electoral *</label>
                <select name="PositionId" class="w-full px-3 py-2 min-h-[44px] bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    @foreach (var pos in positions)
                    {
                        <option value="@pos.Id" selected="@(Model.PositionId == pos.Id)">@pos.Name</option>
                    }
                    @if (!positions.Any())
                    {
                        <option value="1">Cargo Predeterminado (ID: 1)</option>
                    }
                </select>
            </div>

            <div>
                <label class="text-sm font-semibold block mb-1">Estado</label>
                <input type="text" value="@Model.Status" disabled class="w-full px-3 py-2 min-h-[44px] bg-surface-container-low border border-outline-variant rounded-lg text-on-surface-variant font-bold cursor-not-allowed">
            </div>

        </div>

        <h2 class="text-lg font-bold mb-3 mt-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">schedule</span>
            Ventanas de Etapas Electorales (RN-12)
        </h2>
        <p class="text-xs text-on-surface-variant mb-4">Configura los horarios de inicio y fin para cada una de las 3 etapas. Deben estar en orden cronológico estricto y sin superposición.</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <!-- Etapa 1: Inscripción de Candidatos -->
            <div class="bg-surface-container-low p-4 rounded-xl border border-border-subtle">
                <div class="flex items-center gap-2 mb-3 pb-2 border-b border-border-subtle">
                    <span class="bg-primary/10 text-primary text-xs font-bold px-2 py-1 rounded-full">Etapa 1</span>
                    <h3 class="text-sm font-bold">Inscripción de Candidatos</h3>
                </div>
                <div class="space-y-3">
                    <div>
                        <label class="text-xs font-semibold block mb-1">Inicio Inscripción *</label>
                        <div class="flex gap-2">
                            <input type="date" name="RegistrationStartDate" value="@Model.RegistrationStartDate.ToString("yyyy-MM-dd")" required
                                   class="w-full px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                            <input type="time" name="RegistrationStartTime" value="@Model.RegistrationStartTime.ToString("HH:mm")" required
                                   class="w-24 px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-semibold block mb-1">Fin Inscripción *</label>
                        <div class="flex gap-2">
                            <input type="date" name="RegistrationEndDate" value="@Model.RegistrationEndDate.ToString("yyyy-MM-dd")" required
                                   class="w-full px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                            <input type="time" name="RegistrationEndTime" value="@Model.RegistrationEndTime.ToString("HH:mm")" required
                                   class="w-24 px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Etapa 2: Consulta de Propuestas -->
            <div class="bg-surface-container-low p-4 rounded-xl border border-border-subtle">
                <div class="flex items-center gap-2 mb-3 pb-2 border-b border-border-subtle">
                    <span class="bg-primary/10 text-primary text-xs font-bold px-2 py-1 rounded-full">Etapa 2</span>
                    <h3 class="text-sm font-bold">Consulta de Propuestas</h3>
                </div>
                <div class="space-y-3">
                    <div>
                        <label class="text-xs font-semibold block mb-1">Inicio Propuestas *</label>
                        <div class="flex gap-2">
                            <input type="date" name="ProposalsStartDate" value="@Model.ProposalsStartDate.ToString("yyyy-MM-dd")" required
                                   class="w-full px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                            <input type="time" name="ProposalsStartTime" value="@Model.ProposalsStartTime.ToString("HH:mm")" required
                                   class="w-24 px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-semibold block mb-1">Fin Propuestas *</label>
                        <div class="flex gap-2">
                            <input type="date" name="ProposalsEndDate" value="@Model.ProposalsEndDate.ToString("yyyy-MM-dd")" required
                                   class="w-full px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                            <input type="time" name="ProposalsEndTime" value="@Model.ProposalsEndTime.ToString("HH:mm")" required
                                   class="w-24 px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Etapa 3: Votación -->
            <div class="bg-surface-container-low p-4 rounded-xl border border-border-subtle">
                <div class="flex items-center gap-2 mb-3 pb-2 border-b border-border-subtle">
                    <span class="bg-primary/10 text-primary text-xs font-bold px-2 py-1 rounded-full">Etapa 3</span>
                    <h3 class="text-sm font-bold">Votación</h3>
                </div>
                <div class="space-y-3">
                    <div>
                        <label class="text-xs font-semibold block mb-1">Inicio Votación *</label>
                        <div class="flex gap-2">
                            <input type="date" name="VotingStartDate" value="@Model.VotingStartDate.ToString("yyyy-MM-dd")" required
                                   class="w-full px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                            <input type="time" name="VotingStartTime" value="@Model.VotingStartTime.ToString("HH:mm")" required
                                   class="w-24 px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                        </div>
                    </div>
                    <div>
                        <label class="text-xs font-semibold block mb-1">Fin Votación *</label>
                        <div class="flex gap-2">
                            <input type="date" name="VotingEndDate" value="@Model.VotingEndDate.ToString("yyyy-MM-dd")" required
                                   class="w-full px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                            <input type="time" name="VotingEndTime" value="@Model.VotingEndTime.ToString("HH:mm")" required
                                   class="w-24 px-2 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección: Papeles y Documentos Exigidos para la Candidatura -->
        <div id="section-requirements" class="mb-6 pt-6 border-t border-border-subtle @(Model.ElectionType == "TEMAS" ? "hidden" : "")">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div>
                    <h2 class="text-lg font-bold flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">description</span>
                        Papeles y Documentos Exigidos para Candidatura
                    </h2>
                    <p class="text-xs text-on-surface-variant">Configura qué soportes documentales deberán adjuntar los candidatos obligatoriamente u opcionalmente al postularse.</p>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" id="btnAddRequirement" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary text-on-primary hover:bg-primary/90 transition-colors shadow-xs cursor-pointer">
                        <span class="material-symbols-outlined text-sm">add</span> Añadir Documento
                    </button>
                </div>
            </div>

            <!-- Botones de sugerencias rápidas -->
            <div class="flex flex-wrap items-center gap-1.5 mb-4">
                <span class="text-xs text-on-surface-variant mr-1">Sugerencias rápidas:</span>
                <button type="button" onclick="addSuggestedDoc('Certificado de calificaciones / Rendimiento académico', true)" class="px-2.5 py-1 text-xs rounded-full bg-surface-container-low hover:bg-surface-container border border-border-subtle text-on-surface transition-colors cursor-pointer">+ Certificado de notas</button>
                <button type="button" onclick="addSuggestedDoc('Paz y salvo de convivencia escolar / disciplinario', true)" class="px-2.5 py-1 text-xs rounded-full bg-surface-container-low hover:bg-surface-container border border-border-subtle text-on-surface transition-colors cursor-pointer">+ Paz y salvo disciplinario</button>
                <button type="button" onclick="addSuggestedDoc('Carta de compromiso firmada por el acudiente', false)" class="px-2.5 py-1 text-xs rounded-full bg-surface-container-low hover:bg-surface-container border border-border-subtle text-on-surface transition-colors cursor-pointer">+ Carta de acudiente</button>
                <button type="button" onclick="addSuggestedDoc('Certificado de matrícula vigente', true)" class="px-2.5 py-1 text-xs rounded-full bg-surface-container-low hover:bg-surface-container border border-border-subtle text-on-surface transition-colors cursor-pointer">+ Matrícula vigente</button>
            </div>

            <!-- Contenedor de la lista de documentos exigidos -->
            <div id="requirementsListContainer" class="space-y-2.5 bg-surface-container-low/40 p-4 rounded-xl border border-border-subtle">
                @if (positionRequirements.Any())
                {
                    foreach (var req in positionRequirements)
                    {
                        <div class="req-row flex items-center gap-3 bg-surface-container-lowest p-3 rounded-lg border border-border-subtle shadow-xs" data-id="@req.Id">
                            <span class="material-symbols-outlined text-on-surface-variant text-base cursor-grab">drag_indicator</span>
                            <input type="text" class="req-desc flex-1 px-3 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary" value="@req.Description" placeholder="Ej: Certificado de notas" required />
                            <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface select-none cursor-pointer bg-surface-container-low px-2.5 py-1.5 rounded-lg border border-border-subtle">
                                <input type="checkbox" class="req-mandatory text-primary focus:ring-primary h-4 w-4 rounded border-outline-variant" @(req.IsMandatory ? "checked" : "") />
                                <span>Obligatorio</span>
                            </label>
                            <button type="button" onclick="removeReqRow(this)" class="p-1.5 text-status-deleted hover:bg-status-deleted/10 rounded-lg transition-colors" title="Eliminar requisito">
                                <span class="material-symbols-outlined text-lg">delete</span>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div id="emptyRequirementsMsg" class="text-center py-6 text-xs text-on-surface-variant">
                        No hay documentos configurados para este cargo. Haz clic en "Añadir Documento" o selecciona una sugerencia arriba.
                    </div>
                }
            </div>
            <input type="hidden" id="requirementsJson" name="requirementsJson" value="" />
        </div>

        <!-- Sección: Grados Habilitados para Votar con Selección Masiva -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 mt-6 pt-6 border-t border-border-subtle">
            <div>
                <h2 class="text-lg font-bold">Grados Habilitados para Votar</h2>
                <p class="text-xs text-on-surface-variant">Selecciona los cursos que podrán participar en esta elección.</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" id="btnSelectAllGrades" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary/10 text-primary hover:bg-primary/20 transition-colors border border-primary/20 cursor-pointer">
                    <span class="material-symbols-outlined text-sm">done_all</span> Seleccionar todos los cursos
                </button>
                <button type="button" id="btnDeselectAllGrades" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-surface-container-low text-on-surface-variant hover:bg-surface-container transition-colors border border-border-subtle cursor-pointer">
                    <span class="material-symbols-outlined text-sm">remove_done</span> Deseleccionar todos
                </button>
            </div>
        </div>
        <div class="flex flex-wrap gap-4 mb-6" id="gradesContainer">
            @foreach (var g in grades)
            {
                <label class="flex items-center gap-2 cursor-pointer bg-surface-container-low px-3 py-2 min-h-[44px] rounded-lg border border-border-subtle hover:border-outline-variant transition-colors">
                    <input type="checkbox" name="gradeIds" value="@g.Id" checked="@(selectedGradeIds.Contains(g.Id))" class="grade-checkbox text-primary focus:ring-primary h-5 w-5 rounded border-outline-variant">
                    <span class="text-sm font-medium">@g.Name</span>
                </label>
            }
        </div>

        <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 sm:gap-4 pt-4 border-t border-border-subtle">
            <a href="/AdminEvents" class="w-full sm:w-auto px-5 py-2.5 min-h-[44px] rounded-lg font-semibold text-on-surface-variant hover:bg-surface-container-low transition-colors flex items-center justify-center">Cancelar</a>
            <button type="submit" id="btnSubmitEvent" class="w-full sm:w-auto bg-primary text-on-primary px-5 py-2.5 min-h-[44px] rounded-lg font-semibold hover:bg-primary/90 transition-colors flex items-center justify-center">
                @(isNew ? "Crear Proceso Electoral" : "Guardar Cambios")
            </button>
        </div>
    </form>

    @if (!isNew)
    {
        @if (Model.ElectionType == "PERSONAS")
        {
            <partial name="_ConfigurePersonas" model="Model" />
        }
        else
        {
            <partial name="_ConfigureTemas" model="Model" />
        }
    }
</div>

@section Scripts {
    <script>
        // ─── Selección Masiva de Cursos ───────────────────────────────────────
        document.getElementById('btnSelectAllGrades')?.addEventListener('click', function () {
            document.querySelectorAll('.grade-checkbox').forEach(cb => cb.checked = true);
        });

        document.getElementById('btnDeselectAllGrades')?.addEventListener('click', function () {
            document.querySelectorAll('.grade-checkbox').forEach(cb => cb.checked = false);
        });

        // ─── Gestión Dinámica de Papeles / Documentos Exigidos ───────────────
        function buildRequirementsJson() {
            const reqs = [];
            document.querySelectorAll('.req-row').forEach(row => {
                const desc = row.querySelector('.req-desc')?.value.trim();
                const isMandatory = row.querySelector('.req-mandatory')?.checked ?? true;
                const id = parseInt(row.getAttribute('data-id') || '0', 10);
                if (desc) {
                    reqs.push({ id: id, description: desc, isMandatory: isMandatory });
                }
            });
            const hiddenInput = document.getElementById('requirementsJson');
            if (hiddenInput) {
                hiddenInput.value = JSON.stringify(reqs);
            }
        }

        function removeReqRow(btn) {
            const row = btn.closest('.req-row');
            if (row) {
                row.remove();
                checkEmptyRequirements();
            }
        }

        function checkEmptyRequirements() {
            const container = document.getElementById('requirementsListContainer');
            const rows = container.querySelectorAll('.req-row');
            let emptyMsg = document.getElementById('emptyRequirementsMsg');
            if (rows.length === 0) {
                if (!emptyMsg) {
                    emptyMsg = document.createElement('div');
                    emptyMsg.id = 'emptyRequirementsMsg';
                    emptyMsg.className = 'text-center py-6 text-xs text-on-surface-variant';
                    emptyMsg.textContent = 'No hay documentos configurados para este cargo. Haz clic en "Añadir Documento" o selecciona una sugerencia arriba.';
                    container.appendChild(emptyMsg);
                }
            } else {
                if (emptyMsg) emptyMsg.remove();
            }
        }

        function addRequirementRow(desc = '', isMandatory = true, id = 0) {
            const emptyMsg = document.getElementById('emptyRequirementsMsg');
            if (emptyMsg) emptyMsg.remove();

            const container = document.getElementById('requirementsListContainer');
            const row = document.createElement('div');
            row.className = 'req-row flex items-center gap-3 bg-surface-container-lowest p-3 rounded-lg border border-border-subtle shadow-xs';
            row.setAttribute('data-id', id);
            row.innerHTML = `
                <span class="material-symbols-outlined text-on-surface-variant text-base cursor-grab">drag_indicator</span>
                <input type="text" class="req-desc flex-1 px-3 py-1.5 text-sm bg-surface-container-lowest border border-outline-variant rounded-lg focus:outline-none focus:border-primary" value="${escapeHtml(desc)}" placeholder="Ej: Certificado de notas" required />
                <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface select-none cursor-pointer bg-surface-container-low px-2.5 py-1.5 rounded-lg border border-border-subtle">
                    <input type="checkbox" class="req-mandatory text-primary focus:ring-primary h-4 w-4 rounded border-outline-variant" ${isMandatory ? 'checked' : ''} />
                    <span>Obligatorio</span>
                </label>
                <button type="button" onclick="removeReqRow(this)" class="p-1.5 text-status-deleted hover:bg-status-deleted/10 rounded-lg transition-colors" title="Eliminar requisito">
                    <span class="material-symbols-outlined text-lg">delete</span>
                </button>
            `;
            container.appendChild(row);
            const input = row.querySelector('.req-desc');
            if (input && !desc) input.focus();
        }

        function addSuggestedDoc(desc, isMandatory) {
            // Verificar si ya existe
            let exists = false;
            document.querySelectorAll('.req-row .req-desc').forEach(input => {
                if (input.value.trim().toLowerCase() === desc.toLowerCase()) exists = true;
            });
            if (exists) {
                alert('Este documento ya se encuentra en la lista.');
                return;
            }
            addRequirementRow(desc, isMandatory);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        document.getElementById('btnAddRequirement')?.addEventListener('click', function () {
            addRequirementRow('', true);
        });

        // Al cambiar de Cargo Electoral en tiempo de creación, cargar los requerimientos de ese cargo
        const posSelect = document.querySelector('select[name="PositionId"]');
        if (posSelect) {
            posSelect.addEventListener('change', function () {
                const posId = this.value;
                if (!posId) return;
                fetch(`/AdminEvents/GetPositionRequirements?positionId=${posId}`)
                    .then(res => res.json())
                    .then(data => {
                        const container = document.getElementById('requirementsListContainer');
                        container.innerHTML = '';
                        if (data && data.length > 0) {
                            data.forEach(req => {
                                addRequirementRow(req.description, req.isMandatory, req.id);
                            });
                        } else {
                            checkEmptyRequirements();
                        }
                    })
                    .catch(err => console.error(err));
            });
        }

        // Antes de enviar el formulario, empaquetar JSON de requisitos
        const formEl = document.querySelector('form[action*="/AdminEvents"]');
        if (formEl) {
            formEl.addEventListener('submit', function () {
                buildRequirementsJson();
            });
        }
    </script>
}

