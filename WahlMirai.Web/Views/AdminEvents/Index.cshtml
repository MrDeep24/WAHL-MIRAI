@model List<WahlMirai.Web.Models.VotingEvent>
@{
    ViewData["Title"] = "Panel de Control Electoral";
    Layout = "_AdminLayout";
}

<div class="fade-in">
    <div class="flex justify-between items-start mb-6 flex-wrap gap-3">
        <div>
            <h1 class="text-3xl font-bold mb-1">Procesos Electorales</h1>
            <p class="text-on-surface-variant">Gestiona y monitorea los procesos de elección estudiantil.</p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <a href="/AdminEvents/Create"
               class="flex items-center justify-center gap-2 bg-primary text-on-primary rounded-lg px-4 py-2 min-h-[44px] text-sm font-semibold hover:bg-primary/90 transition-colors">
                <span class="material-symbols-outlined text-base">add</span> Nuevo proceso
            </a>
        </div>
    </div>

    <!-- Filtros / Tabs -->
    <div class="flex border-b border-border-subtle mb-6 overflow-x-auto" id="event-tabs">
        <button onclick="filterEvents('TODOS', this)" class="tab-btn px-5 py-3 border-b-2 border-primary text-primary font-semibold whitespace-nowrap">Todos</button>
        <button onclick="filterEvents('PROGRAMADA', this)" class="tab-btn px-5 py-3 border-b-2 border-transparent text-on-surface-variant hover:text-on-surface whitespace-nowrap">Programados</button>
        <button onclick="filterEvents('ACTIVA', this)" class="tab-btn px-5 py-3 border-b-2 border-transparent text-on-surface-variant hover:text-on-surface whitespace-nowrap">En Curso</button>
        <button onclick="filterEvents('FINALIZADA', this)" class="tab-btn px-5 py-3 border-b-2 border-transparent text-on-surface-variant hover:text-on-surface whitespace-nowrap">Finalizados</button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-status-active/10 text-status-active px-4 py-3 rounded-lg mb-6 text-sm font-medium">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-status-deleted/10 text-status-deleted px-4 py-3 rounded-lg mb-6 text-sm font-medium">
            @TempData["Error"]
        </div>
    }

    <!-- Lista de tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="events-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var ev in Model)
            {
                <div class="event-card bg-surface-container-lowest border border-border-subtle rounded-xl p-5 shadow-card hover:border-outline-variant transition-colors flex flex-col" data-status="@ev.Status">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex flex-col gap-1">
                            @if (ev.Status == "PROGRAMADA")
                            {
                                <span class="w-fit inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-high text-on-surface-variant">Programada</span>
                            }
                            else if (ev.Status == "ACTIVA")
                            {
                                <span class="w-fit inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-status-active/10 text-status-active">En curso</span>
                            }
                            else
                            {
                                <span class="w-fit inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-status-graduated/20 text-status-graduated">Finalizada</span>
                            }
                            <h3 class="font-bold text-lg leading-tight mt-1">@ev.Title</h3>
                        </div>
                    </div>
                    <p class="text-sm text-on-surface-variant mb-4 line-clamp-2">
                        @(string.IsNullOrEmpty(ev.Description) ? "Sin descripción." : ev.Description)
                    </p>
                    <div class="mt-auto space-y-2 mb-5">
                        <div class="flex justify-between text-xs text-on-surface-variant">
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">event</span> @ev.StartDate.ToString("dd/MM/yyyy") - @ev.EndDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="flex justify-between text-xs text-on-surface-variant">
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">group</span> @ev.ElectionType</span>
                            <span>@ev.Candidates.Count() opciones</span>
                        </div>
                    </div>
                    
                    <div class="flex gap-2 mt-auto pt-4 border-t border-border-subtle">
                        <a href="/AdminEvents/Edit/@ev.Id" class="flex-1 flex justify-center items-center gap-2 border border-outline-variant rounded-lg py-2 min-h-[44px] text-sm font-semibold hover:bg-surface-container-low transition-colors">
                            <span class="material-symbols-outlined text-[18px]">edit</span> Editar
                        </a>
                        <button type="button" onclick="confirmDelete(@ev.Id)" class="flex justify-center items-center gap-2 border border-outline-variant rounded-lg p-2 min-h-[44px] min-w-[44px] text-status-deleted hover:bg-status-deleted/10 transition-colors" title="Eliminar">
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full py-12 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl mb-2 opacity-50">event_busy</span>
                <p>No hay procesos electorales registrados.</p>
            </div>
        }
    </div>
</div>

<script>
    function filterEvents(status, btnElement) {
        // Actualizar tabs activas
        const tabs = document.querySelectorAll('#event-tabs .tab-btn');
        tabs.forEach(t => {
            t.classList.remove('border-primary', 'text-primary');
            t.classList.add('border-transparent', 'text-on-surface-variant');
        });
        if (btnElement) {
            btnElement.classList.remove('border-transparent', 'text-on-surface-variant');
            btnElement.classList.add('border-primary', 'text-primary');
        }

        // Filtrar tarjetas
        const cards = document.querySelectorAll('.event-card');
        cards.forEach(card => {
            const cardStatus = card.getAttribute('data-status');
            if (status === 'TODOS' || cardStatus === status) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

<partial name="_DeleteConfirmModal" />
