@model WahlMirai.Web.Models.VotingEvent

<div id="candidate-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
     onclick="if(event.target===this) this.classList.add('hidden')">
    <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-lg w-full p-5 md:p-6 flex flex-col max-h-[90vh]">
        <div class="flex justify-between items-center mb-5 shrink-0">
            <h3 class="text-lg font-bold">Inscribir Candidato</h3>
            <button type="button" onclick="document.getElementById('candidate-modal').classList.add('hidden')">
                <span class="material-symbols-outlined hover:text-error transition-colors">close</span>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto pr-2">
            <!-- Búsqueda -->
            <div class="mb-5">
                <label class="text-sm font-semibold block mb-1">Buscar Elector (Documento o Nombre)</label>
                <div class="flex gap-2">
                    <input type="text" id="candidateSearchInput" placeholder="Ej. 1001234567"
                           class="flex-1 px-3 py-2 min-h-[44px] border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    <button type="button" onclick="searchCandidate()" class="bg-surface-container-high hover:bg-surface-container px-3 py-2 min-h-[44px] min-w-[44px] rounded-lg text-primary border border-outline-variant flex items-center justify-center">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
            </div>

            <!-- Resultados de Búsqueda -->
            <div id="searchResults" class="mb-5 hidden">
                <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Resultados</p>
                <ul id="searchResultsList" class="bg-surface-container-low border border-border-subtle rounded-lg divide-y divide-border-subtle max-h-40 overflow-y-auto">
                    <!-- Resultados dinámicos -->
                </ul>
            </div>

            <form action="/AdminEvents/AddCandidate" method="post" id="addCandidateForm" class="hidden border-t border-border-subtle pt-5">
                <input type="hidden" name="eventId" value="@Model.Id" />
                <input type="hidden" name="voterId" id="selectedVoterId" required />
                
                <div class="bg-primary-container/30 border border-primary/20 rounded-lg p-3 flex gap-3 items-center mb-4">
                    <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <p class="font-bold text-sm" id="selectedVoterName">-</p>
                        <p class="text-xs text-on-surface-variant">Grado: <span id="selectedVoterGrade"></span> | Doc: <span id="selectedVoterDoc" class="font-mono-id"></span></p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="text-sm font-semibold block mb-1">Lema o Slogan</label>
                        <textarea name="slogan" rows="2" placeholder="Opcional"
                                  class="w-full px-3 py-2 min-h-[44px] border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"></textarea>
                    </div>
                    <div>
                        <label class="text-sm font-semibold block mb-1">URL Fotografía</label>
                        <input type="url" name="photoUrl" placeholder="https://..."
                               class="w-full px-3 py-2 min-h-[44px] border border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-primary text-on-primary font-semibold py-2.5 min-h-[44px] rounded-lg mt-6 hover:bg-primary/90 transition-colors flex items-center justify-center">
                    Inscribir Candidato
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    async function searchCandidate() {
        const term = document.getElementById('candidateSearchInput').value;
        if (!term) return;

        const res = await fetch(`/AdminEvents/SearchVoter?term=${encodeURIComponent(term)}`);
        const data = await res.json();
        
        const list = document.getElementById('searchResultsList');
        list.innerHTML = '';
        
        if (data.length === 0) {
            list.innerHTML = '<li class="p-3 text-sm text-on-surface-variant">No se encontraron electores activos.</li>';
        } else {
            data.forEach(v => {
                const li = document.createElement('li');
                li.className = 'p-3 hover:bg-surface-container cursor-pointer flex justify-between items-center transition-colors';
                li.innerHTML = `
                    <div>
                        <p class="text-sm font-bold">${v.fullName}</p>
                        <p class="text-xs text-on-surface-variant">${v.gradeName} | Doc: ${v.documento}</p>
                    </div>
                    <button type="button" class="text-primary text-sm font-semibold px-2 py-1 bg-primary/10 rounded">Seleccionar</button>
                `;
                li.onclick = () => selectVoter(v);
                list.appendChild(li);
            });
        }
        
        document.getElementById('searchResults').classList.remove('hidden');
    }

    function selectVoter(v) {
        document.getElementById('selectedVoterId').value = v.id;
        document.getElementById('selectedVoterName').innerText = v.fullName;
        document.getElementById('selectedVoterGrade').innerText = v.gradeName;
        document.getElementById('selectedVoterDoc').innerText = v.documento;
        
        document.getElementById('searchResults').classList.add('hidden');
        document.getElementById('addCandidateForm').classList.remove('hidden');
    }
</script>
