@{
    Layout = "_Layout";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    bool isHelpActive = (currentController == "Pqr" && currentAction == "Index")
        || currentPath.Equals("/Ayuda", StringComparison.OrdinalIgnoreCase)
        || currentPath.Equals("/Pqr", StringComparison.OrdinalIgnoreCase);
}

<div class="flex flex-col md:flex-row h-[calc(100dvh-4rem)] overflow-hidden">
    <!-- Overlay -->
    <div id="drawer-overlay" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity opacity-0" onclick="toggleDrawer()"></div>

    <!-- Sidebar Drawer -->
    <aside id="sidebar-drawer" class="hidden md:flex fixed md:static inset-y-0 left-0 z-50 h-full w-72 md:w-64 bg-surface-container-lowest border-r border-border-subtle flex-col p-5 shrink-0 shadow-lg md:shadow-none">
        <!-- Botón de cierre visible únicamente en móvil dentro del drawer -->
        <div class="flex items-center justify-end md:hidden mb-3">
            <button onclick="toggleDrawer()" class="text-on-surface-variant hover:bg-surface-container-low rounded-lg transition-colors min-w-[40px] min-h-[40px] flex items-center justify-center -mr-2" aria-label="Cerrar">
                <span class="material-symbols-outlined text-xl">close</span>
            </button>
        </div>

        <nav class="flex flex-col gap-1">
            <a href="/AdminEvents" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(currentController == "AdminEvents" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                <span class="material-symbols-outlined text-xl">dashboard</span> <span>Panel de Control</span>
            </a>
            <a href="/AdminCensus" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(currentController == "AdminCensus" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                <span class="material-symbols-outlined text-xl">groups</span> <span>Censo Electoral</span>
            </a>
            <a href="/AdminEmailReport" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(currentController == "AdminEmailReport" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                <span class="material-symbols-outlined text-xl">mark_email_read</span> <span>Reportes de Correo</span>
            </a>
            <a href="/Pqr" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(isHelpActive ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                <span class="material-symbols-outlined text-xl">help</span> <span>Ayuda</span>
            </a>
            <a href="/Pqr/Manage" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(currentController == "Pqr" && currentAction == "Manage" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                <span class="material-symbols-outlined text-xl">admin_panel_settings</span> <span>Gestión PQR</span>
            </a>
            @if (User.IsInRole("SUPER_ADMIN"))
            {
                <a href="/AdminAccounts" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(currentController == "AdminAccounts" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                    <span class="material-symbols-outlined text-xl">manage_accounts</span> <span>Cuentas Administrativas</span>
                </a>
            }
            <a href="/Profile" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors @(currentController == "Profile" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-container-low") min-h-[44px]">
                <span class="material-symbols-outlined text-xl">account_circle</span> <span>Mi Perfil</span>
            </a>
        </nav>
        <div class="mt-auto flex flex-col gap-2 pt-4">
            <a href="/Auth/Logout" class="flex items-center gap-2 justify-center text-sm text-on-surface-variant py-2 hover:text-error transition-colors min-h-[44px]">
                <span class="material-symbols-outlined text-xl">logout</span> <span>Cerrar sesión</span>
            </a>
        </div>
    </aside>
    
    <div class="flex-1 p-4 md:p-8 overflow-y-auto voting-pattern-bg">
        <!-- Disparador del menú lateral en móviles (espejo de _ElectorLayout.cshtml para navegación táctil) -->
        <div class="md:hidden mb-4">
            <button id="admin-drawer-toggle"
                    type="button"
                    onclick="toggleDrawer()"
                    class="text-on-surface-variant hover:bg-surface-container-low border border-border-subtle rounded-lg min-w-[40px] min-h-[40px] flex items-center justify-center transition-colors -ml-1"
                    aria-label="Abrir menú"
                    aria-controls="sidebar-drawer"
                    aria-expanded="false">
                <span class="material-symbols-outlined text-xl">menu</span>
            </button>
        </div>
        @RenderBody()
    </div>
</div>

<partial name="_DocumentViewerModal" />
<partial name="_AlertModal" />

@await RenderSectionAsync("Scripts", required: false)
<script>
    function toggleDrawer() {
        const drawer = document.getElementById('sidebar-drawer');
        const overlay = document.getElementById('drawer-overlay');
        const toggleBtn = document.getElementById('admin-drawer-toggle');
        const isOpen = !drawer.classList.contains('hidden');

        if (isOpen) {
            // Cerrar
            overlay.classList.add('opacity-0');
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
            setTimeout(() => {
                drawer.classList.add('hidden');
                overlay.classList.add('hidden');
            }, 280);
        } else {
            // Abrir
            drawer.classList.remove('hidden');
            overlay.classList.remove('hidden');
            overlay.classList.remove('opacity-0');
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        }
    }

    // Cerrar drawer al redimensionar a md+
    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            document.getElementById('drawer-overlay').classList.add('hidden', 'opacity-0');
            const toggleBtn = document.getElementById('admin-drawer-toggle');
            if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        }
    });
</script>
