<header class="site-header flex items-center justify-between px-4 sm:px-6 md:px-12 w-full min-h-16 bg-surface-container-lowest border-b border-border-subtle shadow-xs relative z-20">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 transition-opacity hover:opacity-90">
        <img alt="Wahl Mirai Logo" class="w-8 h-8 object-contain rounded-lg" src="/images/logo.png" />
        <span class="font-bold text-lg sm:text-xl text-primary">Wahl Mirai</span>
    </a>

    <nav class="hidden md:flex items-center gap-6" aria-label="Navegación principal">
        <a href="/" class="site-nav-link text-sm font-medium pb-1 border-b-2 border-transparent text-on-surface-variant hover:text-primary transition-colors">Inicio</a>
        <a href="/Ayuda" class="site-nav-link text-sm font-medium pb-1 border-b-2 border-transparent text-on-surface-variant hover:text-primary transition-colors">Ayuda</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
        @await Html.PartialAsync("_LocaleSelector")
        <button type="button" class="theme-toggle flex items-center justify-center p-2 rounded-lg bg-surface-container-low hover:bg-surface-container border border-border-subtle text-on-surface-variant hover:text-primary transition-colors cursor-pointer" title="Modo oscuro / claro" aria-label="Modo oscuro / claro">
            <span class="material-symbols-outlined text-lg">dark_mode</span>
        </button>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/Auth/Logout" class="flex items-center gap-1.5 text-sm font-medium text-on-surface-variant hover:text-error transition-colors px-3 py-1.5 rounded-lg hover:bg-surface-container-low whitespace-nowrap">
                <span class="material-symbols-outlined text-lg">logout</span> Salir
            </a>
        }
        else
        {
            <a href="/Auth/Login" class="bg-primary hover:bg-primary/90 text-on-primary px-3 sm:px-5 py-2 rounded-lg font-medium text-xs sm:text-sm transition-colors whitespace-nowrap">
                Iniciar sesión
            </a>
        }
    </div>
</header>