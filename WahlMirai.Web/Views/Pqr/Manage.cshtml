@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestionar PQR";
}

<h1 class="text-2xl font-bold mb-4">Gestión de PQR</h1>

@Html.AntiForgeryToken()

<div class="mb-4 flex flex-col sm:flex-row gap-3 justify-between items-stretch sm:items-center">
    <div class="flex gap-2">
        <button data-pqr-filter="TODAS" class="px-3 py-1 rounded border text-sm">Todas</button>
        <button data-pqr-filter="ABIERTO" data-active="true" class="px-3 py-1 rounded bg-primary text-on-primary text-sm">Abiertos</button>
        <button data-pqr-filter="RESUELTO" class="px-3 py-1 rounded border text-sm">Resueltos</button>
    </div>
    <div class="relative w-full sm:w-72">
        <input data-pqr-search type="text"
               placeholder="Buscar por votante o asunto..."
               aria-label="Buscar PQR"
               class="w-full px-3 py-1.5 text-sm bg-surface border border-outline-variant rounded-lg focus:outline-none focus:border-primary text-on-surface placeholder:text-on-surface-variant/70" />
    </div>
</div>

<div class="mb-2 hidden md:grid pqr-grid-row text-xs font-semibold uppercase px-2 py-2 text-on-surface-variant bg-surface-container-low/50 rounded-lg">
    <div>ID</div>
    <div>Votante</div>
    <div>Asunto</div>
    <div>Estado</div>
    <div class="text-right">Acciones</div>
</div>
<div data-pqr-list class="flex flex-col gap-3 md:gap-0"></div>

<nav aria-label="Paginación de PQR" data-pqr-pagination class="hidden mt-4 flex items-center justify-between gap-2 pt-3 border-t border-outline-variant">
    <button data-pqr-prev type="button" class="px-3 py-2 min-h-[44px] rounded-lg border border-outline-variant text-sm font-semibold hover:bg-surface-container-low transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Anterior
    </button>
    <span data-pqr-page-info class="text-sm text-on-surface-variant font-medium text-center"></span>
    <button data-pqr-next type="button" class="px-3 py-2 min-h-[44px] rounded-lg border border-outline-variant text-sm font-semibold hover:bg-surface-container-low transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
        Siguiente
    </button>
</nav>

<div data-pqr-modal
     role="dialog"
     aria-modal="true"
     aria-labelledby="pqr-modal-title"
     tabindex="-1"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">

    <div class="bg-white w-full max-w-lg rounded-xl shadow-lg p-6 flex flex-col gap-4">
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
                <h2 id="pqr-modal-title" class="text-lg font-bold">Detalle y Respuesta de PQR</h2>
                <span data-pqr-modal-ticket-id class="px-2 py-0.5 rounded bg-primary-container text-on-primary-container text-xs font-mono font-semibold"></span>
            </div>
            <button data-pqr-close type="button" class="text-xl leading-none text-on-surface-variant hover:text-error transition-colors p-1" aria-label="Cerrar">&times;</button>
        </div>
        <div class="text-sm">
            <p class="text-xs uppercase text-on-surface-variant">Elector</p>
            <p data-pqr-field="elector-name" class="font-medium"></p>
        </div>
        <div class="text-sm">
            <p class="text-xs uppercase text-on-surface-variant">Fecha Radicación</p>
            <p data-pqr-field="fecha"></p>
        </div>
        <div class="text-sm">
            <p class="text-xs uppercase text-on-surface-variant">Asunto</p>
            <p data-pqr-field="asunto" class="font-medium"></p>
        </div>
        <div class="text-sm">
            <p class="text-xs uppercase text-on-surface-variant">Mensaje</p>
            <p data-pqr-field="mensaje" class="bg-surface-container-low p-3 rounded italic"></p>
        </div>
        <div>
            <label class="text-sm font-medium">Respuesta Administrativa</label>
            <textarea data-pqr-response-input rows="4" class="w-full border rounded p-2 text-sm mt-1"></textarea>
        </div>
        <div class="flex justify-end gap-2">
            <button data-pqr-cancel type="button" class="px-4 py-2 rounded border text-sm">Cancelar</button>
            <button data-pqr-submit type="button" class="px-4 py-2 rounded bg-primary text-on-primary text-sm">Enviar Respuesta</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pqr-manage.js" asp-append-version="true"></script>
}
