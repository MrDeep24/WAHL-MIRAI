@{
    Layout = User.IsInRole("ADMIN") ? "_AdminLayout" : "_ElectorLayout";
    ViewData["Title"] = "Ayuda";
}

<h1 class="text-2xl font-bold mb-4">Ayuda</h1>

<p class="mb-4">Aquí encontrarás respuestas a preguntas comunes y cómo crear una PQR.</p>

<section class="space-y-3">
    <details class="p-4 border rounded-lg">
        <summary class="font-semibold">¿Cómo inicio sesión?</summary>
        <div class="mt-2 text-sm text-on-surface-variant">
            <img class="w-full max-w-sm mb-2" src="/img/ayuda/ayuda-login.svg" alt="¿Cómo inicio sesión?" />
            <p>Ingresa tu documento y la contraseña que recibiste por correo. Si el sistema dice que los datos son incorrectos, revisa que no haya espacios de más en el documento.</p>
        </div>
    </details>

    <details class="p-4 border rounded-lg">
        <summary class="font-semibold">Olvidé mi contraseña, ¿qué hago?</summary>
        <div class="mt-2 text-sm text-on-surface-variant">
            <img class="w-full max-w-sm mb-2" src="/img/ayuda/ayuda-recuperar.svg" alt="Olvidé mi contraseña, ¿qué hago?" />
            <p>Ve a la pantalla 'Recuperar acceso' e ingresa tu documento. Te enviaremos una nueva contraseña a tu correo de contacto registrado.</p>
        </div>
    </details>

    <details class="p-4 border rounded-lg">
        <summary class="font-semibold">¿Cómo voto?</summary>
        <div class="mt-2 text-sm text-on-surface-variant">
            <img class="w-full max-w-sm mb-2" src="/img/ayuda/ayuda-votar.svg" alt="¿Cómo voto?" />
            <p>Elige un candidato en el tarjetón, revisa sus propuestas en la ventana emergente y confirma tu voto. Una vez confirmado, no se puede deshacer.</p>
        </div>
    </details>

    <details class="p-4 border rounded-lg">
        <summary class="font-semibold">¿Cómo edito mi perfil?</summary>
        <div class="mt-2 text-sm text-on-surface-variant">
            <img class="w-full max-w-sm mb-2" src="/img/ayuda/ayuda-perfil.svg" alt="¿Cómo edito mi perfil?" />
            <p>Puedes cambiar tu correo de contacto o tu contraseña desde 'Mi perfil'. Tu documento, nombre y grado los administra el colegio y no se pueden editar.</p>
        </div>
    </details>

    <details class="p-4 border rounded-lg">
        <summary class="font-semibold">¿Cuándo puedo ver los resultados?</summary>
        <div class="mt-2 text-sm text-on-surface-variant">
            <img class="w-full max-w-sm mb-2" src="/img/ayuda/ayuda-resultados.svg" alt="¿Cuándo puedo ver los resultados?" />
            <p>Mientras la elección está activa, solo ves resultados si ya votaste. Al finalizar, los resultados se abren para todos los electores del grado habilitado.</p>
        </div>
    </details>
</section>

<div class="mt-6">
    <a href="/Pqr/Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-on-primary">Crear PQR</a>
</div>

@if (User.IsInRole("ELECTOR"))
{
    <div class="mt-8">
        <h2 class="text-xl font-bold mb-3">Mis Solicitudes</h2>
        <div data-pqr-mine-list class="mt-4 flex flex-col gap-2"></div>
    </div>
}

@section Scripts {
    @if (User.IsInRole("ELECTOR"))
    {
        <script>
            const mineList = document.querySelector('[data-pqr-mine-list]');

            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function formatDate(value) {
                if (!value) return 'Sin fecha';
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) return 'Sin fecha';
                return new Intl.DateTimeFormat('es-ES', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }).format(date);
            }

            function statusLabel(status) {
                return status === 'RESUELTO' ? 'Resuelta' : 'Abierta';
            }

            function statusBadgeClass(status) {
                return status === 'RESUELTO'
                    ? 'bg-status-graduated/20 text-status-graduated'
                    : 'bg-status-pending/10 text-status-pending';
            }

            async function loadMineHistory() {
                if (!mineList) return;

                try {
                    const res = await fetch('/Pqr/Mine', {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();

                    if (!data.ok) {
                        mineList.innerHTML = '<p class="text-sm text-on-surface-variant">No se pudo cargar tu historial de PQR.</p>';
                        return;
                    }

                    const tickets = Array.isArray(data.tickets) ? data.tickets : [];

                    if (!tickets.length) {
                        mineList.innerHTML = '<p class="text-sm text-on-surface-variant">Aún no has creado ninguna PQR.</p>';
                        return;
                    }

                    mineList.innerHTML = tickets.map((ticket) => {
                        const status = statusLabel(ticket.status);
                        const responseHtml = ticket.status === 'RESUELTO'
                            ? `<div class="mt-3 rounded-md bg-surface-container-low p-3 text-sm">
                                   <span class="font-medium text-on-surface">Respuesta del administrador:</span>
                                   <p class="mt-1 whitespace-pre-wrap text-on-surface-variant">${escapeHtml(ticket.adminResponse || '')}</p>
                               </div>`
                            : '';

                        return `
                            <article class="rounded-lg border border-outline/30 bg-surface p-4 shadow-sm">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <p class="font-medium text-on-surface">${escapeHtml(ticket.subject || '')}</p>
                                        <p class="mt-1 text-xs text-on-surface-variant">${formatDate(ticket.createdAt)}</p>
                                    </div>
                                    <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium ${statusBadgeClass(ticket.status)}">${status}</span>
                                </div>
                                <p class="mt-3 text-sm text-on-surface-variant">${escapeHtml(ticket.message || '')}</p>
                                ${responseHtml}
                            </article>
                        `;
                    }).join('');
                } catch (err) {
                    console.error(err);
                    mineList.innerHTML = '<p class="text-sm text-on-surface-variant">No se pudo cargar tu historial de PQR.</p>';
                }
            }

            loadMineHistory();
        </script>
    }
}
