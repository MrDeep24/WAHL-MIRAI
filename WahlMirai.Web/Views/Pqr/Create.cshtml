@{
    Layout = "_ElectorLayout";
    ViewData["Title"] = "Crear PQR";
}

<h1 class="text-2xl font-bold mb-4">Crear PQR</h1>

<form id="pqr-form">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="block text-sm font-medium">Asunto</label>
        <input id="subject" class="w-full border rounded px-3 py-2" />
    </div>
    <div class="mb-3">
        <label class="block text-sm font-medium">Mensaje</label>
        <textarea id="message" rows="6" class="w-full border rounded px-3 py-2"></textarea>
    </div>
    <div>
        <button id="submit-btn" class="px-4 py-2 rounded-lg bg-primary text-on-primary">Enviar</button>
    </div>
</form>

@section Scripts {
    <script>
        // RF-M08-03: Precarga de borrador desde sessionStorage al escalar desde el Chatbot de Ayuda
        (function () {
            try {
                const draftRaw = sessionStorage.getItem('pqr_draft_escalation');
                if (draftRaw) {
                    const draft = JSON.parse(draftRaw);
                    if (draft && typeof draft === 'object') {
                        const subjectEl = document.getElementById('subject');
                        const messageEl = document.getElementById('message');
                        if (subjectEl && draft.subject) subjectEl.value = draft.subject;
                        if (messageEl && draft.message) messageEl.value = draft.message;
                    }
                    sessionStorage.removeItem('pqr_draft_escalation');
                }
            } catch (err) {
                console.warn('[PQR] Error al recuperar borrador escalado de sessionStorage:', err);
            }
        })();

        function t(msg) {
            return (window.WahlMiraiLocale && typeof window.WahlMiraiLocale.translate === 'function')
                ? window.WahlMiraiLocale.translate(msg)
                : msg;
        }

        document.getElementById('pqr-form').addEventListener('submit', async function (ev) {
            ev.preventDefault();
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : null;

            const subject = document.getElementById('subject').value.trim();
            const message = document.getElementById('message').value.trim();

            if (!subject || !message) { alert(t('Asunto y mensaje son obligatorios.')); return; }

            try {
                const res = await fetch('/Pqr/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ Subject: subject, Message: message })
                });
                const data = await res.json();
                if (data.ok) {
                    alert(t('PQR creada correctamente.'));
                    document.getElementById('subject').value = '';
                    document.getElementById('message').value = '';
                } else {
                    alert(t(data.message || 'Error al crear PQR.'));
                }
            } catch (err) {
                console.error(err);
                alert(t('Error de red.'));
            }
        });
    </script>
}
