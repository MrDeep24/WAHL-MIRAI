@{
    Layout = "_ElectorLayout";
    ViewData["Title"] = "Crear PQR";
}

<h1 class="text-2xl font-bold mb-4">Crear PQR</h1>

<form id="pqr-form">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="block text-sm font-medium">Asunto</label>
        <input id="subject" class="w-full border rounded px-3 py-2" />
    </div>
    <div class="mb-3">
        <label class="block text-sm font-medium">Mensaje</label>
        <textarea id="message" rows="6" class="w-full border rounded px-3 py-2"></textarea>
    </div>
    <div>
        <button id="submit-btn" class="px-4 py-2 rounded-lg bg-primary text-on-primary">Enviar</button>
    </div>
</form>

<div id="pqr-success-message" class="hidden mt-4 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-800"></div>

<div class="mt-8">
    <h2 class="text-xl font-bold mb-3">Mis Solicitudes</h2>
    <div data-pqr-mine-list class="flex flex-col gap-2"></div>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('pqr-form');
        const subjectInput = document.getElementById('subject');
        const messageInput = document.getElementById('message');
        const successMessage = document.getElementById('pqr-success-message');
        const mineList = document.querySelector('[data-pqr-mine-list]');

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatDate(value) {
            if (!value) return 'Sin fecha';
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return 'Sin fecha';
            return new Intl.DateTimeFormat('es-ES', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }).format(date);
        }

        function statusLabel(status) {
            return status === 'RESUELTO' ? 'Resuelta' : 'Abierta';
        }

        function statusBadgeClass(status) {
            return status === 'RESUELTO'
                ? 'bg-green-100 text-green-700 border border-green-200'
                : 'bg-yellow-100 text-yellow-700 border border-yellow-200';
        }

        function showInlineSuccess(message) {
            successMessage.textContent = message;
            successMessage.classList.remove('hidden');
        }

        function hideInlineSuccess() {
            successMessage.textContent = '';
            successMessage.classList.add('hidden');
        }

        async function loadMineHistory() {
            if (!mineList) return;

            try {
                const res = await fetch('/Pqr/Mine', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();

                if (!data.ok) {
                    mineList.innerHTML = '<p class="text-sm text-on-surface-variant">No se pudo cargar tu historial de PQR.</p>';
                    return;
                }

                const tickets = Array.isArray(data.tickets) ? data.tickets : [];

                if (!tickets.length) {
                    mineList.innerHTML = '<p class="text-sm text-on-surface-variant">Aún no has creado ninguna PQR.</p>';
                    return;
                }

                mineList.innerHTML = tickets.map((ticket) => {
                    const status = statusLabel(ticket.status);
                    const responseHtml = ticket.status === 'RESUELTO'
                        ? `<div class="mt-3 rounded-md bg-surface-container-low p-3 text-sm">
                               <span class="font-medium text-on-surface">Respuesta del administrador:</span>
                               <p class="mt-1 whitespace-pre-wrap text-on-surface-variant">${escapeHtml(ticket.adminResponse || '')}</p>
                           </div>`
                        : '';

                    return `
                        <article class="rounded-lg border border-outline/30 bg-surface p-4 shadow-sm">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-medium text-on-surface">${escapeHtml(ticket.subject || '')}</p>
                                    <p class="mt-1 text-xs text-on-surface-variant">${formatDate(ticket.createdAt)}</p>
                                </div>
                                <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium ${statusBadgeClass(ticket.status)}">${status}</span>
                            </div>
                            <p class="mt-3 text-sm text-on-surface-variant">${escapeHtml(ticket.message || '')}</p>
                            ${responseHtml}
                        </article>
                    `;
                }).join('');
            } catch (err) {
                console.error(err);
                mineList.innerHTML = '<p class="text-sm text-on-surface-variant">No se pudo cargar tu historial de PQR.</p>';
            }
        }

        form.addEventListener('submit', async function (ev) {
            ev.preventDefault();
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : null;

            const subject = subjectInput.value.trim();
            const message = messageInput.value.trim();

            if (!subject || !message) { alert('Asunto y mensaje son obligatorios.'); return; }

            try {
                const res = await fetch('/Pqr/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ Subject: subject, Message: message })
                });
                const data = await res.json();

                if (data.ok) {
                    form.reset();
                    hideInlineSuccess();
                    showInlineSuccess('PQR creada correctamente.');
                    await loadMineHistory();
                    return;
                }

                alert(data.message || 'Error al crear PQR.');
            } catch (err) {
                console.error(err);
                alert('Error de red.');
            }
        });

        loadMineHistory();
    </script>
}
