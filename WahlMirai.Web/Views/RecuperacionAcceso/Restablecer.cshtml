@model WahlMirai.Web.ViewModels.RestablecerViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_Layout";
}

<main class="min-h-screen flex items-center justify-center p-4 md:p-6 relative bg-cover bg-center bg-no-repeat" style="background-image: url('/images/login-background.jpg.jpg');">
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]"></div>

    <div class="w-full max-w-md bg-white/95 dark:bg-slate-900/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/40 dark:border-slate-800 p-6 md:p-8 relative z-10 overflow-hidden fade-in text-on-surface dark:text-slate-100">
        <div class="absolute top-0 left-0 right-0 h-2 bg-primary"></div>

        <!-- Barra superior: Volver, Idioma y Tema -->
        <div class="flex items-center justify-between gap-2 mb-4">
            <a asp-controller="Auth" asp-action="Login"
               class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface-variant dark:text-slate-300 hover:text-primary dark:hover:text-blue-400 transition-colors py-1.5 px-2 min-h-[40px] rounded-lg hover:bg-surface-container-low dark:hover:bg-slate-800">
                <span class="material-symbols-outlined text-base">arrow_back</span> Volver
            </a>

            <div class="flex items-center gap-2">
                <select class="locale-select text-xs bg-surface-container-low dark:bg-slate-800 border border-border-subtle dark:border-slate-700 text-on-surface dark:text-slate-200 rounded-lg px-2 py-1.5 focus:outline-none focus:border-primary transition-colors cursor-pointer" title="Seleccionar idioma">
                    <option value="es">ES</option>
                    <option value="en">EN</option>
                    <option value="de">DE</option>
                    <option value="fr">FR</option>
                    <option value="ja">JA</option>
                    <option value="zh">ZH</option>
                </select>
                <button type="button" class="theme-toggle flex items-center justify-center p-1.5 rounded-lg bg-surface-container-low dark:bg-slate-800 hover:bg-surface-container dark:hover:bg-slate-700 border border-border-subtle dark:border-slate-700 text-on-surface-variant dark:text-slate-200 hover:text-primary dark:hover:text-blue-400 transition-colors cursor-pointer" title="Modo oscuro / claro" aria-label="Modo oscuro / claro">
                    <span class="material-symbols-outlined text-lg">dark_mode</span>
                </button>
            </div>
        </div>

        <div class="flex flex-col items-center mb-6">
            <div class="w-16 h-16 mb-4 rounded-xl flex items-center justify-center">
                <img src="/images/logo.png" alt="Wahl Mirai Logo" class="w-16 h-16 rounded-xl object-cover shadow-sm" onerror="this.src='/images/imagen_voto.png'" />
            </div>
            <h1 class="text-2xl font-bold text-primary dark:text-blue-400 text-center">Wahl Mirai</h1>
            <p class="text-sm text-on-surface-variant dark:text-slate-400 text-center mt-1">Restablecer Contraseña</p>
        </div>

        @if (Model.IsInvalidLink)
        {
            <div class="flex flex-col items-center gap-4 text-center">
                <div class="w-12 h-12 rounded-full bg-error-container/30 border border-error/30 flex items-center justify-center text-error">
                    <span class="material-symbols-outlined text-2xl">link_off</span>
                </div>
                <div class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                    Este enlace de restablecimiento no es válido o ha expirado. Solicita uno nuevo.
                </div>
                <a asp-action="Recuperar"
                   class="w-full bg-primary hover:bg-primary/90 text-on-primary font-semibold py-3 min-h-[44px] rounded-lg transition-colors flex items-center justify-center gap-2 shadow-sm">
                    Solicitar nuevo enlace <span class="material-symbols-outlined">restart_alt</span>
                </a>
                <a asp-controller="Auth" asp-action="Login" class="text-sm text-primary dark:text-blue-400 text-center hover:underline mt-2 py-2 min-h-[44px] flex items-center justify-center">Volver al inicio de sesión</a>
            </div>
        }
        else
        {
            <div class="mb-6 text-sm text-slate-700 dark:text-slate-300 text-center leading-relaxed">
                Ingresa tu nueva contraseña para completar el restablecimiento de tu cuenta.
            </div>

            <form asp-action="Restablecer" method="post" class="flex flex-col gap-5">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="text-sm text-error -mt-2"></div>

                <!-- Password -->
                <div class="flex flex-col gap-2">
                    <label class="text-sm font-semibold text-slate-800 dark:text-slate-200" asp-for="Password">Nueva contraseña</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline dark:text-slate-400">key</span>
                        <input id="compl-password-input"
                               asp-for="Password"
                               type="password"
                               class="w-full pl-10 pr-11 py-3 bg-surface dark:bg-slate-800 border border-outline-variant dark:border-slate-700 dark:text-white rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                               placeholder="Mínimo 8 caracteres"
                               autocomplete="new-password" />
                        <button type="button" id="toggle-pass-btn"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-outline dark:text-slate-400 hover:text-on-surface dark:hover:text-white p-1 rounded-md transition-colors flex items-center justify-center min-h-[36px] min-w-[36px] cursor-pointer"
                                aria-label="Mostrar u ocultar contraseña">
                            <span id="toggle-pass-icon" class="material-symbols-outlined text-xl select-none">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-xs text-error"></span>
                    <!-- Password strength hint -->
                    <ul class="text-xs text-on-surface-variant dark:text-slate-300 space-y-0.5 pl-1" id="pwd-hints">
                        <li id="hint-len"   class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-outline dark:text-slate-400">circle</span> Mínimo 8 caracteres</li>
                        <li id="hint-upper" class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-outline dark:text-slate-400">circle</span> Al menos una letra mayúscula</li>
                        <li id="hint-sym"   class="flex items-center gap-1"><span class="material-symbols-outlined text-sm text-outline dark:text-slate-400">circle</span> Al menos un símbolo especial (!&#64;#$%…)</li>
                    </ul>
                </div>

                <!-- Confirm password -->
                <div class="flex flex-col gap-2">
                    <label class="text-sm font-semibold text-slate-800 dark:text-slate-200" asp-for="ConfirmPassword">Confirmar contraseña</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline dark:text-slate-400">key</span>
                        <input id="compl-confirm-input"
                               asp-for="ConfirmPassword"
                               type="password"
                               class="w-full pl-10 pr-11 py-3 bg-surface dark:bg-slate-800 border border-outline-variant dark:border-slate-700 dark:text-white rounded-lg font-mono-id focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                               placeholder="Repite la contraseña"
                               autocomplete="new-password" />
                        <button type="button" id="toggle-confirm-btn"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-outline dark:text-slate-400 hover:text-on-surface dark:hover:text-white p-1 rounded-md transition-colors flex items-center justify-center min-h-[36px] min-w-[36px] cursor-pointer"
                                aria-label="Mostrar u ocultar confirmación">
                            <span id="toggle-confirm-icon" class="material-symbols-outlined text-xl select-none">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-error"></span>
                </div>

                <button type="submit" id="reset-submit-btn"
                        class="w-full bg-primary hover:bg-primary/90 text-on-primary font-semibold py-3 min-h-[44px] rounded-lg transition-colors flex items-center justify-center gap-2 shadow-sm">
                    Restablecer Contraseña <span class="material-symbols-outlined">lock_reset</span>
                </button>

                <a asp-controller="Auth" asp-action="Login" class="text-sm text-primary dark:text-blue-400 text-center hover:underline mt-2 py-2 min-h-[44px] flex items-center justify-center">Volver al inicio de sesión</a>
            </form>
        }
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/auth-completar.js"></script>
}
