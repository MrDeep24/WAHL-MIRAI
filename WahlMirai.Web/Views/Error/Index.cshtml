@model WahlMirai.Web.ViewModels.ErrorViewModel
@{
    if (User.Identity?.IsAuthenticated == true)
    {
        if (User.IsInRole("ADMIN") || User.IsInRole("SUPER_ADMIN"))
        {
            Layout = "_AdminLayout";
        }
        else
        {
            Layout = "_ElectorLayout";
        }
    }
    else
    {
        // Minimal fallback layout
        Layout = "_Layout";
    }

    ViewData["Title"] = Model.Title;

    var badgeColorClass = Model.StatusCode switch {
        400 => "bg-primary text-on-primary",
        401 => "bg-status-deleted text-on-error",
        403 => "bg-error text-on-error",
        404 => "bg-primary text-on-primary",
        _ => "bg-error text-on-error"
    };

    var iconColorClass = Model.StatusCode switch {
        400 => "text-status-pending",
        401 => "text-status-deleted",
        403 => "text-error",
        404 => "text-status-graduated",
        _ => "text-error"
    };
    
    var iconName = Model.StatusCode switch {
        400 => "warning",
        401 => "lock",
        403 => "gpp_bad",
        404 => "search_off",
        _ => "error"
    };
}

<style>
    @@keyframes float {
        0% { transform: translateY(0px) rotate(3deg); }
        50% { transform: translateY(-10px) rotate(3deg); }
        100% { transform: translateY(0px) rotate(3deg); }
    }
    .card-float {
        animation: float 4s ease-in-out infinite;
        will-change: transform;
    }
    .mesh-gradient-bg {
        background-color: var(--color-background);
        background-image: 
            radial-gradient(circle at 10% 15%, color-mix(in srgb, var(--color-primary-container) 20%, transparent) 0%, transparent 45%),
            radial-gradient(circle at 90% 85%, color-mix(in srgb, var(--color-secondary-container) 15%, transparent) 0%, transparent 45%);
    }
</style>

<div class="relative flex flex-col items-center justify-center min-h-[70vh] p-4 sm:p-8 text-center text-on-background font-inter overflow-hidden mesh-gradient-bg">
    
    <!-- Blobs decorativos -->
    <div class="absolute -top-32 -left-32 w-64 h-64 md:w-96 md:h-96 bg-primary-container/20 rounded-full blur-[64px] pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-64 h-64 md:w-96 md:h-96 bg-secondary-container/15 rounded-full blur-[64px] pointer-events-none"></div>
    
    <!-- Tarjeta ilustrativa -->
    <div id="parallax-card" class="relative z-10 w-48 h-48 md:w-72 md:h-72 bg-white rounded-3xl shadow-xl flex flex-col items-center justify-center mb-8 card-float transition-transform duration-300 hover:rotate-6">
        <span class="material-symbols-outlined text-[60px] md:text-[72px] @iconColorClass mb-4">@iconName</span>
        <div class="w-24 md:w-32 h-3 bg-surface-container-high rounded-full mb-3"></div>
        <div class="w-16 md:w-20 h-3 bg-surface-container-high rounded-full"></div>
        
        <!-- Badge del código de estado -->
        <div class="absolute -bottom-3 -right-3 md:-bottom-5 md:-right-5 w-14 h-14 md:w-18 md:h-18 @badgeColorClass rounded-full flex items-center justify-center font-bold text-lg md:text-2xl shadow-lg -rotate-12 border-4 border-white">
            @Model.StatusCode
        </div>
    </div>
    
    <h2 class="text-2xl sm:text-3xl font-semibold mb-4 text-on-surface z-10 relative">@Model.Title</h2>
    
    <p class="text-base sm:text-lg max-w-md mb-8 text-on-surface-variant z-10 relative px-2">
        @Model.Message
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 z-10 relative mb-8 w-full sm:w-auto px-4 sm:px-0">
        @if (Model.ShowHomeButton)
        {
            <a href="/" class="flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-medium shadow-sm hover:shadow-md transition-shadow bg-primary text-on-primary">
                <span class="material-symbols-outlined text-[20px]">home</span>
                Volver al inicio
            </a>
        }
        @if (Model.ShowHelpButton)
        {
            <a href="/Pqr/Create" class="flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-medium border border-outline text-on-surface hover:bg-surface-variant hover:border-transparent transition-colors">
                <span class="material-symbols-outlined text-[20px]">help_outline</span>
                Ir a ayuda
            </a>
        }
    </div>
    
    <!-- Footer de confianza -->
    <div class="flex items-center justify-center gap-2 text-on-surface-variant/60 text-sm z-10 relative mt-4">
        <span class="material-symbols-outlined text-[16px]">verified_user</span>
        <span>Wahl Mirai - Sistema de Votación Seguro</span>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
            const card = document.getElementById('parallax-card');
            if (card) {
                document.addEventListener('mousemove', (e) => {
                    const xAxis = (window.innerWidth / 2 - e.pageX) / 25;
                    const yAxis = (window.innerHeight / 2 - e.pageY) / 25;
                    card.style.transform = `translateY(-10px) rotate(3deg) translate(${xAxis}px, ${yAxis}px)`;
                });
                
                card.addEventListener('mouseleave', () => {
                    card.style.transform = `translateY(0px) rotate(3deg)`;
                });
            }
        }
    });
</script>