@model WahlMirai.Web.ViewModels.ProfileViewModel

@{
    Layout = User.IsInRole("ADMIN") ? "_AdminLayout" : "_ElectorLayout";
    ViewData["Title"] = "Mi Perfil";
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center gap-3 mb-8">
        <span class="material-symbols-outlined text-3xl text-primary">account_circle</span>
        <h1 class="text-2xl font-bold text-on-surface">Mi Perfil</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-primary-container text-on-primary-container p-4 rounded-lg flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined">check_circle</span>
            <p>@TempData["Success"]</p>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-error-container text-on-error-container p-4 rounded-lg flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined">error</span>
            <p>@TempData["Error"]</p>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Columna Izquierda: Información Institucional (Solo Lectura) -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-6 shadow-sm">
                <div class="flex flex-col items-center text-center pb-6 border-b border-border-subtle">
                    <div class="w-24 h-24 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container mb-4">
                        <span class="material-symbols-outlined text-5xl">person</span>
                    </div>
                    <h2 class="text-xl font-bold text-on-surface mb-1">@Model.FullName</h2>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary-container text-on-secondary-container mb-3">
                        @Model.Role
                    </span>
                    <div class="flex items-center gap-1.5 text-sm @(Model.Status == "ACTIVO" ? "text-primary" : "text-error")">
                        <span class="material-symbols-outlined text-[18px]">@(Model.Status == "ACTIVO" ? "verified_user" : "gpp_bad")</span>
                        <span class="font-medium">@Model.Status</span>
                    </div>
                </div>

                <div class="pt-6">
                    <div class="flex items-center gap-2 text-on-surface-variant font-medium mb-4">
                        <span class="material-symbols-outlined text-[20px]">lock</span>
                        <h3>Información Institucional</h3>
                    </div>
                    
                    <div class="space-y-4">
                        @if (User.IsInRole("ADMIN"))
                        {
                            <div>
                                <label class="block text-xs font-medium text-on-surface-variant mb-1">Documento</label>
                                <div class="bg-surface-container-low px-3 py-2 rounded-lg text-sm text-on-surface">
                                    @Model.DocumentDisplay
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <label class="block text-xs font-medium text-on-surface-variant mb-1">Documento</label>
                                <div class="bg-surface-container-low px-3 py-2 rounded-lg text-sm text-on-surface">
                                    @Model.DocumentDisplay
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-on-surface-variant mb-1">Grado</label>
                                <div class="bg-surface-container-low px-3 py-2 rounded-lg text-sm text-on-surface">
                                    @(Model.GradeName ?? "No asignado")
                                </div>
                            </div>
                            <p class="text-xs text-on-surface-variant italic mt-4">
                                Solo el administrador institucional puede modificar estos datos.
                            </p>
                        }
                    </div>
                </div>
            </div>
            
            @if (User.IsInRole("ADMIN"))
            {
                <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-6 shadow-sm">
                    <h3 class="font-bold text-on-surface mb-4">Accesos Rápidos</h3>
                    <div class="space-y-2">
                        <a href="/AdminCensus" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors text-sm text-on-surface">
                            <span class="material-symbols-outlined text-primary">groups</span>
                            Gestión del Censo
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Columna Derecha: Configuración de Cuenta (Editable) -->
        <div class="lg:col-span-2">
            <form asp-action="Update" method="post" class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-8 shadow-sm">
                
                <h2 class="text-xl font-bold text-on-surface mb-6 border-b border-border-subtle pb-4">Configuración de Cuenta</h2>
                
                <div asp-validation-summary="ModelOnly" class="text-error text-sm mb-4"></div>

                <div class="space-y-6">
                    <div>
                        <label asp-for="ContactEmail" class="block text-sm font-medium text-on-surface mb-2"></label>
                        <input asp-for="ContactEmail" class="w-full px-4 py-2.5 rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                        <span asp-validation-for="ContactEmail" class="text-error text-xs mt-1 block"></span>
                        <p class="text-xs text-on-surface-variant mt-1.5">
                            Este correo se usará para notificaciones y recuperación de cuenta.
                        </p>
                    </div>

                    <div class="border-t border-border-subtle pt-6">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-on-surface-variant">key</span>
                                <h3 class="text-lg font-medium text-on-surface">Cambio de Contraseña</h3>
                            </div>
                            <button type="button" onclick="document.getElementById('passwordSection').classList.toggle('hidden')" class="px-4 py-2 text-sm font-medium text-primary bg-primary-container rounded-lg hover:bg-primary-container/80 transition-colors">
                                Cambiar contraseña
                            </button>
                        </div>
                        
                        <div id="passwordSection" class="hidden">
                            <p class="text-sm text-on-surface-variant mb-4">
                                Deja estos campos en blanco si no deseas cambiar tu contraseña.
                            </p>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label asp-for="NewPassword" class="block text-sm font-medium text-on-surface mb-2"></label>
                                    <input asp-for="NewPassword" type="password" class="w-full px-4 py-2.5 rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                                    <span asp-validation-for="NewPassword" class="text-error text-xs mt-1 block"></span>
                                </div>
                                <div>
                                    <label asp-for="ConfirmNewPassword" class="block text-sm font-medium text-on-surface mb-2"></label>
                                    <input asp-for="ConfirmNewPassword" type="password" class="w-full px-4 py-2.5 rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                                    <span asp-validation-for="ConfirmNewPassword" class="text-error text-xs mt-1 block"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-surface-container-low p-6 rounded-xl mt-8">
                        <div class="flex items-start gap-3">
                            <span class="material-symbols-outlined text-warning mt-0.5">warning</span>
                            <div class="flex-1">
                                <h4 class="text-sm font-medium text-on-surface mb-1">Confirmación Requerida</h4>
                                <p class="text-sm text-on-surface-variant mb-4">
                                    Para guardar cualquier cambio en tu perfil, debes ingresar tu contraseña actual.
                                </p>
                                <div>
                                    <label asp-for="CurrentPassword" class="block text-sm font-medium text-on-surface mb-2"></label>
                                    <input asp-for="CurrentPassword" type="password" class="w-full px-4 py-2.5 rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                                    <span asp-validation-for="CurrentPassword" class="text-error text-xs mt-1 block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-4 mt-8 pt-6 border-t border-border-subtle">
                    <a href="@(User.IsInRole("ADMIN") ? "/AdminEvents" : "/Elector/Dashboard")" class="px-6 py-2.5 rounded-lg font-medium text-on-surface hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </a>
                    <button type="submit" class="px-6 py-2.5 rounded-lg font-medium bg-primary text-on-primary hover:bg-primary/90 transition-colors shadow-sm flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>

        <div class="lg:col-span-2">
            <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-8 shadow-sm mt-6">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined">mark_email_read</span>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-lg font-bold text-on-surface mb-1">¿No recuerdas tu contraseña actual?</h3>
                        <p class="text-sm text-on-surface-variant mb-4">
                            Se generará una nueva contraseña aleatoria y se enviará al correo de contacto registrado. Tu sesión actual permanecerá activa.
                        </p>
                        <form asp-action="SendPasswordReset" method="post" onsubmit="return confirm('¿Enviar una nueva contraseña a tu correo de contacto?');">
                            <button type="submit" class="px-5 py-2 rounded-lg font-medium bg-secondary-container text-on-secondary-container hover:bg-secondary-container/80 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-[18px]">send</span>
                                Enviar nueva por correo
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
