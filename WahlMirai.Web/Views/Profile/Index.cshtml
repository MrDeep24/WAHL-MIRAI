@model WahlMirai.Web.ViewModels.ProfileViewModel

@{
    Layout = User.IsInRole("ADMIN") ? "_AdminLayout" : "_ElectorLayout";
    ViewData["Title"] = "Mi Perfil";
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center gap-3 mb-8">
        <span class="material-symbols-outlined text-3xl text-primary">account_circle</span>
        <h1 class="text-2xl font-bold text-on-surface">Mi Perfil</h1>
    </div>

    @if (TempData["Success"] != null || ViewBag.Success != null)
    {
        <div class="bg-primary-container text-on-primary-container p-4 rounded-lg flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined">check_circle</span>
            <p>@(TempData["Success"] ?? ViewBag.Success)</p>
        </div>
    }

    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="bg-error-container text-on-error-container p-4 rounded-lg flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined">error</span>
            <p>@(TempData["Error"] ?? ViewBag.Error)</p>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Columna Izquierda: Información Institucional (Solo Lectura) -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-6 shadow-sm">
                <div class="flex flex-col items-center text-center pb-6 border-b border-border-subtle">
                    <div class="w-24 h-24 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container mb-4">
                        <span class="material-symbols-outlined text-5xl">person</span>
                    </div>
                    <h2 class="text-xl font-bold text-on-surface mb-1">@Model.FullName</h2>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary-container text-on-secondary-container mb-3">
                        @Model.Role
                    </span>
                    <div class="flex items-center gap-1.5 text-sm @(Model.Status == "ACTIVO" ? "text-primary" : "text-error")">
                        <span class="material-symbols-outlined text-[18px]">@(Model.Status == "ACTIVO" ? "verified_user" : "gpp_bad")</span>
                        <span class="font-medium">@Model.Status</span>
                    </div>
                </div>

                <div class="pt-6">
                    <div class="flex items-center gap-2 text-on-surface-variant font-medium mb-4">
                        <span class="material-symbols-outlined text-[20px]">lock</span>
                        <h3>Información Institucional</h3>
                    </div>
                    
                    <div class="space-y-4">
                        @if (User.IsInRole("ADMIN"))
                        {
                            <div>
                                <label class="block text-xs font-medium text-on-surface-variant mb-1">Documento</label>
                                <div class="bg-surface-container-low px-3 py-2 rounded-lg text-sm text-on-surface">
                                    @Model.DocumentDisplay
                                </div>
                            </div>
                        }
                        else
                        {
                            <div>
                                <label class="block text-xs font-medium text-on-surface-variant mb-1">Documento</label>
                                <div class="bg-surface-container-low px-3 py-2 rounded-lg text-sm text-on-surface">
                                    @Model.DocumentDisplay
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-on-surface-variant mb-1">Grado</label>
                                <div class="bg-surface-container-low px-3 py-2 rounded-lg text-sm text-on-surface">
                                    @(Model.GradeName ?? "No asignado")
                                </div>
                            </div>
                            <p class="text-xs text-on-surface-variant italic mt-4">
                                Solo el administrador institucional puede modificar estos datos.
                            </p>
                        }
                    </div>
                </div>
            </div>
            
            @if (User.IsInRole("ADMIN"))
            {
                <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-6 shadow-sm">
                    <h3 class="font-bold text-on-surface mb-4">Accesos Rápidos</h3>
                    <div class="space-y-2">
                        <a href="/AdminCensus" class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container-low transition-colors text-sm text-on-surface">
                            <span class="material-symbols-outlined text-primary">groups</span>
                            Gestión del Censo
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Columna Derecha: Configuración de Cuenta (Editable) -->
        <div class="lg:col-span-2 space-y-6">

            @* Token CSRF standalone — necesario para los fetch() de ambos modales (correo y contraseña).
               Se emite aquí fuera de cualquier form para que document.querySelector('[name="__RequestVerificationToken"]')
               lo encuentre de forma predecible independientemente de qué otros forms existan en la página. *@
            @Html.AntiForgeryToken()

            <!-- Configuración de Cuenta -->
            <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-8 shadow-sm">

                <h2 class="text-xl font-bold text-on-surface mb-6 border-b border-border-subtle pb-4">Configuración de Cuenta</h2>

                <div class="space-y-6">
                    <!-- Correo de contacto (solo lectura) -->
                    <div>
                        <label for="display-email" class="block text-sm font-medium text-on-surface mb-2">Correo de Contacto</label>
                        <div class="flex items-center gap-3">
                            <input id="display-email" type="email" readonly value="@Model.ContactEmail"
                                   class="flex-1 px-4 py-2.5 rounded-lg border border-border-subtle bg-surface-container-low text-on-surface cursor-default focus:outline-none" />
                            <button type="button" id="btn-open-email-modal"
                                    class="flex-shrink-0 px-4 py-2.5 rounded-lg font-medium text-primary border border-primary hover:bg-primary-container transition-colors flex items-center gap-2 min-h-[44px]">
                                <span class="material-symbols-outlined text-[18px]">edit</span>
                                Modificar
                            </button>
                        </div>
                        <p class="text-xs text-on-surface-variant mt-1.5">
                            Este correo se usará para notificaciones y recuperación de cuenta.
                        </p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-start mt-8 pt-6 border-t border-border-subtle gap-3">
                    <!-- Botón Cambiar Contraseña (abre modal) -->
                    <button type="button" id="btn-open-pwd-modal"
                            class="w-full sm:w-auto px-5 py-2.5 rounded-lg font-medium text-primary border border-primary hover:bg-primary-container transition-colors flex items-center justify-center gap-2 min-h-[44px]">
                        <span class="material-symbols-outlined text-[20px]">key</span>
                        Cambiar contraseña
                    </button>
                </div>
            </div>

            <!-- Recuperación de contraseña (si no la recuerda) -->
            <div class="bg-surface-container-lowest border border-border-subtle rounded-2xl p-8 shadow-sm">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined">mark_email_read</span>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-lg font-bold text-on-surface mb-1">¿No recuerdas tu contraseña actual?</h3>
                        <p class="text-sm text-on-surface-variant mb-4">
                            Se generará una nueva contraseña aleatoria y se enviará al correo de contacto registrado. Tu sesión actual permanecerá activa.
                        </p>
                        <form asp-action="SendPasswordReset" method="post" onsubmit="return confirm('¿Enviar una nueva contraseña a tu correo de contacto?');">
                            <button type="submit" class="px-5 py-2 rounded-lg font-medium bg-secondary-container text-on-secondary-container hover:bg-secondary-container/80 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-[18px]">send</span>
                                Enviar nueva por correo
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     MODAL DE CAMBIO DE CORREO DE CONTACTO
     Un solo paso: ingresa nuevo correo, validación en tiempo real,
     confirmación AJAX sin recarga de página.
     ══════════════════════════════════════════════════════════════ -->
<div id="email-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-end md:items-center justify-center p-0 md:p-4 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="email-modal-title">
    <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-2xl shadow-2xl max-w-md w-full overflow-y-auto max-h-[90vh] flex flex-col">

        <!-- Header del modal -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-border-subtle bg-surface-container-low">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">mail</span>
                <h3 id="email-modal-title" class="text-lg font-bold text-on-surface">Modificar Correo de Contacto</h3>
            </div>
            <button type="button" id="btn-close-email-modal" class="text-on-surface-variant hover:text-error transition-colors" aria-label="Cerrar modal">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- Cuerpo del modal -->
        <div class="px-6 py-6 space-y-5">
            <div class="flex items-center gap-3 p-3 bg-primary-container/40 rounded-lg">
                <span class="material-symbols-outlined text-primary">info</span>
                <p class="text-sm text-on-surface">Ingresa el nuevo correo que deseas registrar. Recibirás una notificación de confirmación.</p>
            </div>

            <!-- Correo actual (referencia visual) -->
            <div>
                <p class="text-xs font-medium text-on-surface-variant mb-1">Correo actual</p>
                <p id="email-modal-current" class="text-sm text-on-surface font-mono px-3 py-2 bg-surface-container-low rounded-lg">@Model.ContactEmail</p>
            </div>

            <!-- Nuevo correo -->
            <div>
                <label for="new-email-input" class="block text-sm font-medium text-on-surface mb-2">Nuevo Correo de Contacto</label>
                <input id="new-email-input" type="email" placeholder="nuevo@correo.com"
                       onfocus="this.scrollIntoView({behavior: 'smooth', block: 'center'})"
                       class="w-full px-4 py-2.5 min-h-[44px] rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                <p id="email-format-hint" class="text-error text-xs mt-1 hidden">El formato no es válido.</p>
            </div>

            <!-- Resultado de la operación (error inline o advertencia parcial) -->
            <div id="email-result" class="hidden rounded-lg p-3 flex items-start gap-2 text-sm"></div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" id="btn-cancel-email-modal"
                        class="px-5 py-2.5 rounded-lg font-medium text-on-surface hover:bg-surface-container-low transition-colors">
                    Cancelar
                </button>
                <button type="button" id="btn-save-email" disabled
                        class="px-6 py-2.5 rounded-lg font-medium bg-primary text-on-primary hover:bg-primary/90 transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-2 min-h-[44px]">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     MODAL DE CAMBIO DE CONTRASEÑA — 2 PASOS
     Paso 1: Verificar contraseña actual
     Paso 2: Ingresar nueva contraseña (con requisitos visuales)
     ══════════════════════════════════════════════════════════════ -->

<div id="pwd-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-end md:items-center justify-center p-0 md:p-4 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="pwd-modal-title">
    <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-2xl shadow-2xl max-w-md w-full overflow-y-auto max-h-[90vh] flex flex-col">

        <!-- Header del modal -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-border-subtle bg-surface-container-low">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">lock_reset</span>
                <h3 id="pwd-modal-title" class="text-lg font-bold text-on-surface">Cambiar Contraseña</h3>
            </div>
            <button type="button" id="btn-close-pwd-modal" class="text-on-surface-variant hover:text-error transition-colors" aria-label="Cerrar modal">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- ── PASO 1: Verificar contraseña actual ── -->
        <div id="pwd-step-1" class="px-6 py-6 space-y-5">
            <div class="flex items-center gap-3 p-3 bg-primary-container/40 rounded-lg">
                <span class="material-symbols-outlined text-primary">info</span>
                <p class="text-sm text-on-surface">Por seguridad, primero debes confirmar tu contraseña actual.</p>
            </div>

            <div>
                <label for="verify-current-pwd" class="block text-sm font-medium text-on-surface mb-2">Contraseña Actual</label>
                <div class="relative">
                    <input id="verify-current-pwd" type="password" placeholder="Ingresa tu contraseña actual" onfocus="this.scrollIntoView({behavior: 'smooth', block: 'center'})"
                           class="w-full px-4 py-2.5 pr-12 min-h-[44px] rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                    <button type="button" onclick="togglePwd('verify-current-pwd', this)" tabindex="-1"
                            class="absolute right-1 min-h-[44px] min-w-[44px] top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                    </button>
                </div>
                <p id="step1-error" class="text-error text-xs mt-2 hidden"></p>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" id="btn-cancel-step1"
                        class="px-5 py-2.5 rounded-lg font-medium text-on-surface hover:bg-surface-container-low transition-colors">
                    Cancelar
                </button>
                <button type="button" id="btn-verify-pwd"
                        class="px-6 py-2.5 rounded-lg font-medium bg-primary text-on-primary hover:bg-primary/90 transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    Continuar
                </button>
            </div>
        </div>

        <!-- ── PASO 2: Ingresar nueva contraseña ── -->
        <div id="pwd-step-2" class="px-6 py-6 space-y-5 hidden">
            <!-- Requisitos de contraseña -->
            <div class="bg-surface-container-low rounded-xl p-4 space-y-2">
                <p class="text-sm font-semibold text-on-surface mb-3 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px] text-primary">checklist</span>
                    Requisitos de la contraseña
                </p>
                <div class="space-y-1.5">
                    <div class="req-item flex items-center gap-2 text-sm" data-req="length">
                        <span class="req-icon material-symbols-outlined text-[16px] text-on-surface-variant">radio_button_unchecked</span>
                        <span class="text-on-surface-variant">Mínimo 8 caracteres</span>
                    </div>
                    <div class="req-item flex items-center gap-2 text-sm" data-req="uppercase">
                        <span class="req-icon material-symbols-outlined text-[16px] text-on-surface-variant">radio_button_unchecked</span>
                        <span class="text-on-surface-variant">Al menos una letra mayúscula (A–Z)</span>
                    </div>
                    <div class="req-item flex items-center gap-2 text-sm" data-req="special">
                        <span class="req-icon material-symbols-outlined text-[16px] text-on-surface-variant">radio_button_unchecked</span>
                        <span class="text-on-surface-variant">Al menos un símbolo especial (!&#64;#$%...)</span>
                    </div>
                    <div class="req-item flex items-center gap-2 text-sm" data-req="match">
                        <span class="req-icon material-symbols-outlined text-[16px] text-on-surface-variant">radio_button_unchecked</span>
                        <span class="text-on-surface-variant">Las contraseñas coinciden</span>
                    </div>
                </div>
            </div>

            <!-- Campos de nueva contraseña -->
            <div>
                <label for="new-pwd" class="block text-sm font-medium text-on-surface mb-2">Nueva Contraseña</label>
                <div class="relative">
                    <input id="new-pwd" type="password" placeholder="Nueva contraseña" oninput="validatePwdRequirements()" onfocus="this.scrollIntoView({behavior: 'smooth', block: 'center'})"
                           class="w-full px-4 py-2.5 pr-12 min-h-[44px] rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                    <button type="button" onclick="togglePwd('new-pwd', this)" tabindex="-1"
                            class="absolute right-1 min-h-[44px] min-w-[44px] top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                    </button>
                </div>
            </div>

            <div>
                <label for="confirm-pwd" class="block text-sm font-medium text-on-surface mb-2">Confirmar Nueva Contraseña</label>
                <div class="relative">
                    <input id="confirm-pwd" type="password" placeholder="Repite la nueva contraseña" oninput="validatePwdRequirements()" onfocus="this.scrollIntoView({behavior: 'smooth', block: 'center'})"
                           class="w-full px-4 py-2.5 pr-12 min-h-[44px] rounded-lg border border-border-subtle bg-surface text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" />
                    <button type="button" onclick="togglePwd('confirm-pwd', this)" tabindex="-1"
                            class="absolute right-1 min-h-[44px] min-w-[44px] top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                    </button>
                </div>
            </div>

            <!-- Mensaje resultado (error o éxito) -->
            <div id="step2-result" class="hidden rounded-lg p-3 flex items-start gap-2 text-sm"></div>

            <div class="flex justify-between gap-3 pt-2">
                <button type="button" id="btn-back-step1"
                        class="px-4 py-2.5 rounded-lg font-medium text-on-surface hover:bg-surface-container-low transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Volver
                </button>
                <div class="flex gap-3">
                    <button type="button" id="btn-cancel-step2"
                            class="px-5 py-2.5 rounded-lg font-medium text-on-surface hover:bg-surface-container-low transition-colors">
                        Cancelar
                    </button>
                    <button type="button" id="btn-save-pwd" disabled
                            class="px-6 py-2.5 rounded-lg font-medium bg-primary text-on-primary hover:bg-primary/90 transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        Guardar
                    </button>
                </div>
            </div>
        </div>

        <!-- ── PASO 3: Resultado final ── -->
        <div id="pwd-step-3" class="px-6 py-8 hidden text-center space-y-4">
            <div id="result-icon" class="w-16 h-16 rounded-full flex items-center justify-center mx-auto text-3xl"></div>
            <h4 id="result-title" class="text-lg font-bold text-on-surface"></h4>
            <p id="result-message" class="text-sm text-on-surface-variant"></p>
            <button type="button" id="btn-close-final"
                    class="px-6 py-2.5 rounded-lg font-medium bg-primary text-on-primary hover:bg-primary/90 transition-colors">
                Cerrar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ─── Token CSRF ────────────────────────────────────────────────────────────────
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        // ─── Referencias DOM ───────────────────────────────────────────────────────────
        const modal       = document.getElementById('pwd-modal');
        const step1       = document.getElementById('pwd-step-1');
        const step2       = document.getElementById('pwd-step-2');
        const step3       = document.getElementById('pwd-step-3');
        const step1Error  = document.getElementById('step1-error');
        const step2Result = document.getElementById('step2-result');
        const btnSavePwd  = document.getElementById('btn-save-pwd');

        // ─── Abrir / Cerrar modal ──────────────────────────────────────────────────────
        document.getElementById('btn-open-pwd-modal').addEventListener('click', openModal);
        document.getElementById('btn-close-pwd-modal').addEventListener('click', closeModal);
        document.getElementById('btn-cancel-step1').addEventListener('click', closeModal);
        document.getElementById('btn-cancel-step2').addEventListener('click', closeModal);
        document.getElementById('btn-close-final').addEventListener('click', closeModal);
        document.getElementById('btn-back-step1').addEventListener('click', goToStep1);

        modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

        function openModal() {
            resetModal();
            modal.classList.remove('hidden');
            document.getElementById('verify-current-pwd').focus();
        }

        function closeModal() {
            modal.classList.add('hidden');
            resetModal();
        }

        function resetModal() {
            goToStep1();
            document.getElementById('verify-current-pwd').value = '';
            document.getElementById('new-pwd').value = '';
            document.getElementById('confirm-pwd').value = '';
            step1Error.classList.add('hidden');
            step2Result.classList.add('hidden');
            step3.classList.add('hidden');
            validatePwdRequirements();
        }

        function goToStep1() {
            step1.classList.remove('hidden');
            step2.classList.add('hidden');
            step3.classList.add('hidden');
        }

        function goToStep2() {
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
            step3.classList.add('hidden');
            document.getElementById('new-pwd').focus();
        }

        function goToStep3(success, title, message) {
            step1.classList.add('hidden');
            step2.classList.add('hidden');
            step3.classList.remove('hidden');

            const icon  = document.getElementById('result-icon');
            const titleEl = document.getElementById('result-title');
            const msgEl = document.getElementById('result-message');

            if (success) {
                icon.className  = 'w-16 h-16 rounded-full flex items-center justify-center mx-auto text-3xl bg-primary-container text-on-primary-container';
                icon.innerHTML  = '<span class="material-symbols-outlined text-3xl">check_circle</span>';
            } else {
                icon.className  = 'w-16 h-16 rounded-full flex items-center justify-center mx-auto text-3xl bg-error-container text-on-error-container';
                icon.innerHTML  = '<span class="material-symbols-outlined text-3xl">error</span>';
            }
            titleEl.textContent = title;
            msgEl.textContent   = message;
        }

        // ─── Paso 1: Verificar contraseña actual ───────────────────────────────────────
        document.getElementById('btn-verify-pwd').addEventListener('click', async () => {
            const pwd = document.getElementById('verify-current-pwd').value.trim();
            step1Error.classList.add('hidden');

            if (!pwd) {
                showStep1Error('Debes ingresar tu contraseña actual.');
                return;
            }

            const btn = document.getElementById('btn-verify-pwd');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Verificando...';

            try {
                const res  = await fetch('/Profile/VerifyCurrentPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken },
                    body: JSON.stringify({ password: pwd })
                });
                const data = await res.json();

                if (data.ok) {
                    goToStep2();
                } else {
                    showStep1Error(data.message ?? 'Contraseña incorrecta. Intenta de nuevo.');
                }
            } catch {
                showStep1Error('Error de conexión. Intenta de nuevo.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">arrow_forward</span> Continuar';
            }
        });

        // Enter en el campo de verificación activa el botón Continuar
        document.getElementById('verify-current-pwd').addEventListener('keydown', e => {
            if (e.key === 'Enter') document.getElementById('btn-verify-pwd').click();
        });

        function showStep1Error(msg) {
            step1Error.textContent = msg;
            step1Error.classList.remove('hidden');
        }

        // ─── Paso 2: Validación en tiempo real de requisitos ──────────────────────────
        function validatePwdRequirements() {
            const pwd     = document.getElementById('new-pwd').value;
            const confirm = document.getElementById('confirm-pwd').value;

            const reqs = {
                length:    pwd.length >= 8,
                uppercase: /[A-Z]/.test(pwd),
                special:   /[!@@#$%^&*()\-_=+\[\]{};':"\\|,.<>\/?`~]/.test(pwd),
                match:     pwd.length > 0 && pwd === confirm
            };

            // Actualizar indicadores visuales
            Object.entries(reqs).forEach(([key, met]) => {
                const item = document.querySelector(`.req-item[data-req="${key}"]`);
                if (!item) return;
                const icon = item.querySelector('.req-icon');
                const text = item.querySelector('span:last-child');

                if (met) {
                    icon.textContent = 'check_circle';
                    icon.classList.replace('text-on-surface-variant', 'text-primary');
                    text.classList.replace('text-on-surface-variant', 'text-on-surface');
                } else {
                    icon.textContent = 'radio_button_unchecked';
                    icon.classList.replace('text-primary', 'text-on-surface-variant');
                    text.classList.replace('text-on-surface', 'text-on-surface-variant');
                }
            });

            // Activar botón solo si todos los requisitos se cumplen
            const allMet = Object.values(reqs).every(Boolean);
            btnSavePwd.disabled = !allMet;
        }

        // ─── Paso 2: Guardar nueva contraseña ─────────────────────────────────────────
        document.getElementById('btn-save-pwd').addEventListener('click', async () => {
            const currentPwd = document.getElementById('verify-current-pwd').value;
            const newPwd     = document.getElementById('new-pwd').value;
            const confirmPwd = document.getElementById('confirm-pwd').value;

            step2Result.classList.add('hidden');

            const btn = document.getElementById('btn-save-pwd');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Guardando...';

            try {
                const res  = await fetch('/Profile/ChangePassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgeryToken },
                    body: JSON.stringify({
                        currentPassword:  currentPwd,
                        newPassword:      newPwd,
                        confirmNewPassword: confirmPwd
                    })
                });
                const data = await res.json();

                if (data.ok) {
                    goToStep3(true, '¡Contraseña actualizada!', data.message ?? 'Tu contraseña se cambió correctamente.');
                } else {
                    // Mostrar error inline en el paso 2
                    step2Result.className = 'rounded-lg p-3 flex items-start gap-2 text-sm bg-error-container text-on-error-container';
                    step2Result.innerHTML = `<span class="material-symbols-outlined text-[18px] flex-shrink-0">error</span><span>${data.message}</span>`;
                    step2Result.classList.remove('hidden');
                }
            } catch {
                step2Result.className = 'rounded-lg p-3 flex items-start gap-2 text-sm bg-error-container text-on-error-container';
                step2Result.innerHTML = '<span class="material-symbols-outlined text-[18px] flex-shrink-0">error</span><span>Error de conexión. Intenta de nuevo.</span>';
                step2Result.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">save</span> Guardar';
                validatePwdRequirements(); // Re-evalúa el estado del botón
            }
        });

        // ─── Toggle visibilidad de contraseña ─────────────────────────────────────────
        function togglePwd(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon  = btn.querySelector('.material-symbols-outlined');
            if (input.type === 'password') {
                input.type  = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type  = 'password';
                icon.textContent = 'visibility';
            }
        }

        // ══════════════════════════════════════════════════════════════════════════════
        // MODAL DE CORREO DE CONTACTO
        // ══════════════════════════════════════════════════════════════════════════════

        // ─── Referencias DOM ───────────────────────────────────────────────────────────
        const emailModal    = document.getElementById('email-modal');
        const newEmailInput = document.getElementById('new-email-input');
        const btnSaveEmail  = document.getElementById('btn-save-email');
        const emailResult   = document.getElementById('email-result');
        const emailFmtHint  = document.getElementById('email-format-hint');
        const displayEmail  = document.getElementById('display-email');

        // Correo actual renderizado por Razor — sirve para detectar si el usuario
        // no cambió nada y así mantener el botón deshabilitado en ese caso.
        let currentEmailRef = displayEmail.value;

        // ─── Abrir / Cerrar modal ──────────────────────────────────────────────────────
        document.getElementById('btn-open-email-modal').addEventListener('click', openEmailModal);
        document.getElementById('btn-close-email-modal').addEventListener('click', closeEmailModal);
        document.getElementById('btn-cancel-email-modal').addEventListener('click', closeEmailModal);

        emailModal.addEventListener('click', e => { if (e.target === emailModal) closeEmailModal(); });

        function openEmailModal() {
            resetEmailModal();
            emailModal.classList.remove('hidden');
            newEmailInput.focus();
        }

        function closeEmailModal() {
            emailModal.classList.add('hidden');
            resetEmailModal();
        }

        function resetEmailModal() {
            newEmailInput.value = '';
            btnSaveEmail.disabled = true;
            emailResult.classList.add('hidden');
            emailFmtHint.classList.add('hidden');
        }

        // ─── Validación en tiempo real ─────────────────────────────────────────────────
        function isValidEmail(val) {
            return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(val.trim());
        }

        newEmailInput.addEventListener('input', () => {
            const val     = newEmailInput.value.trim();
            const valid   = isValidEmail(val);
            const changed = val !== currentEmailRef;

            // Pista de formato — solo si hay texto y formato inválido
            if (val.length > 0 && !valid) {
                emailFmtHint.classList.remove('hidden');
            } else {
                emailFmtHint.classList.add('hidden');
            }

            // Botón habilitado solo si: valor presente, formato válido, Y distinto al actual
            btnSaveEmail.disabled = !(val.length > 0 && valid && changed);
        });

        // Enter en el input activa el botón Guardar si está habilitado
        newEmailInput.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !btnSaveEmail.disabled) btnSaveEmail.click();
        });

        // ─── Guardar nuevo correo ──────────────────────────────────────────────────────
        btnSaveEmail.addEventListener('click', async () => {
            const newEmail = newEmailInput.value.trim();
            emailResult.classList.add('hidden');

            btnSaveEmail.disabled = true;
            btnSaveEmail.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Guardando...';

            try {
                const res  = await fetch('/Profile/UpdateEmail', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({ newEmail })
                });
                const data = await res.json();

                if (data.ok && data.notificationSent) {
                    // ── Éxito completo: cerrar modal, actualizar display, toast verde ──
                    currentEmailRef = data.newEmail;
                    displayEmail.value = data.newEmail;
                    document.getElementById('email-modal-current').textContent = data.newEmail;
                    closeEmailModal();
                    showEmailToast(data.message, 'success');

                } else if (data.ok && !data.notificationSent) {
                    // ── Guardado parcial: correo en BD pero SMTP falló ─────────────────
                    currentEmailRef = data.newEmail;
                    displayEmail.value = data.newEmail;
                    document.getElementById('email-modal-current').textContent = data.newEmail;
                    emailResult.className = 'rounded-lg p-3 flex items-start gap-2 text-sm bg-secondary-container text-on-secondary-container';
                    emailResult.innerHTML = `<span class="material-symbols-outlined text-[18px] flex-shrink-0">warning</span><span>${data.message}</span>`;
                    emailResult.classList.remove('hidden');
                    btnSaveEmail.disabled = true;

                } else {
                    // ── Error de negocio (duplicado, mismo correo, validación) ──────────
                    emailResult.className = 'rounded-lg p-3 flex items-start gap-2 text-sm bg-error-container text-on-error-container';
                    emailResult.innerHTML = `<span class="material-symbols-outlined text-[18px] flex-shrink-0">error</span><span>${data.message}</span>`;
                    emailResult.classList.remove('hidden');
                    const val = newEmailInput.value.trim();
                    btnSaveEmail.disabled = !(isValidEmail(val) && val !== currentEmailRef);
                }

            } catch {
                emailResult.className = 'rounded-lg p-3 flex items-start gap-2 text-sm bg-error-container text-on-error-container';
                emailResult.innerHTML = '<span class="material-symbols-outlined text-[18px] flex-shrink-0">error</span><span>Error de conexión. Intenta de nuevo.</span>';
                emailResult.classList.remove('hidden');
                const val = newEmailInput.value.trim();
                btnSaveEmail.disabled = !(isValidEmail(val) && val !== currentEmailRef);
            } finally {
                btnSaveEmail.innerHTML = '<span class="material-symbols-outlined text-[18px]">save</span> Guardar';
            }
        });

        // ─── Toast de notificación (esquina inferior derecha, 4 s) ────────────────────
        function showEmailToast(message, variant) {
            const existing = document.getElementById('profile-toast');
            if (existing) existing.remove();

            const colorClasses = variant === 'success'
                ? 'bg-primary-container text-on-primary-container'
                : 'bg-secondary-container text-on-secondary-container';
            const iconName = variant === 'success' ? 'check_circle' : 'warning';

            const toast = document.createElement('div');
            toast.id = 'profile-toast';
            toast.className = `fixed bottom-6 right-6 z-[100] flex items-center gap-3 px-5 py-3 rounded-xl shadow-lg ${colorClasses} text-sm font-medium transition-all duration-300 opacity-0 translate-y-2`;
            toast.innerHTML = `<span class="material-symbols-outlined text-[20px]">${iconName}</span><span>${message}</span>`;
            document.body.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('opacity-0', 'translate-y-2');
                toast.classList.add('opacity-100', 'translate-y-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                toast.addEventListener('transitionend', () => toast.remove(), { once: true });
            }, 4000);
        }
    </script>
}
