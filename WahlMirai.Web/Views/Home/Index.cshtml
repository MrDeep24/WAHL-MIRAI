@{
    ViewData["Title"] = "Inicio";
    Layout = "_Layout";
}

<script src="https://cdn.tailwindcss.com"></script>

<!-- Header / TopNavBar -->
<header class="flex justify-between items-center px-6 md:px-12 w-full h-16 z-50 fixed top-0 bg-white border-b border-gray-200/80 shadow-sm">
    <div class="flex items-center gap-3">
        <img alt="Wahl Mirai Logo" class="w-8 h-8 object-contain" src="/images/logo.png" onerror="this.src='/images/imagen_voto.png'" />
        <span class="font-bold text-xl text-[#0a3563] tracking-tight">Wahl Mirai</span>
    </div>
    
    <nav class="hidden md:flex items-center gap-8">
        <a class="text-[#0a3563] font-bold text-base border-b-2 border-[#0a3563] pb-1" href="#">Inicio</a>
    </nav>
    
    <div class="flex items-center gap-6">
        <button class="hidden md:flex items-center gap-1.5 text-[#0a3563] font-medium hover:opacity-80 transition-opacity">
            <span class="material-symbols-outlined text-xl">help_outline</span>
            <span>Ayuda</span>
        </button>
        <a href="/Auth/Login" class="bg-[#072f57] hover:bg-[#052342] text-white px-5 py-2 rounded-lg font-medium text-sm transition-all shadow-sm active:scale-95">
            Iniciar Sesión
        </a>
    </div>
</header>

<main class="pt-16">
    <!-- Hero Section matching design reference -->
    <section class="relative min-h-[calc(100vh-4rem)] flex items-center bg-[#b8daff] py-12 md:py-16 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 md:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left Column: Copy & CTAs -->
            <div class="lg:col-span-6 space-y-6">
                <!-- Small top pill badge -->
                <div class="w-12 h-4 bg-[#a0c8f5]/80 rounded-full mb-4"></div>
                
                <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold text-[#0c2340] leading-[1.12] tracking-tight">
                    El futuro de la<br />
                    <span class="italic text-[#073366] font-semibold">democracia</span><br />
                    <span class="italic text-[#073366] font-semibold">escolar</span> está en tus<br />
                    manos.
                </h1>
                
                <p class="text-[#335374] text-base md:text-lg max-w-lg leading-relaxed font-normal">
                    Wahl Mirai es la plataforma líder para la gestión de elecciones institucionales, garantizando el anonimato y la integridad de cada voto.
                </p>
                
                <div class="pt-2">
                    <a href="/Auth/Login" class="inline-flex items-center gap-3 bg-[#072f57] hover:bg-[#052342] text-white font-semibold px-7 py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-95 transition-all text-base">
                        <span>Empezar a Votar</span>
                        <span class="material-symbols-outlined text-xl">how_to_vote</span>
                    </a>
                </div>
            </div>
            
            <!-- Right Column: Hero Illustration -->
            <div class="lg:col-span-6 flex justify-center items-center">
                <div class="relative w-full max-w-[580px] flex justify-center items-center">
                    <img src="/images/imagen_voto.png" alt="Ilustración de votación Wahl Mirai" class="w-full h-auto max-h-[520px] object-contain drop-shadow-sm" />
                </div>
            </div>

        </div>
    </section>

    <!-- Features Section -->
    <section class="py-16 md:py-24 bg-white" id="seguridad">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <div class="text-center space-y-4 mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-[#0c2340]">Diseñado para la integridad institucional</h2>
                <p class="text-[#475569] max-w-2xl mx-auto text-base">Nuestra arquitectura se centra en tres pilares fundamentales que garantizan un proceso electoral impecable.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Feature 1: Security -->
                <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200/80 hover:border-blue-400/40 transition-all group hover:shadow-md">
                    <div class="w-14 h-14 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">lock</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0c2340] mb-3">Voto Cifrado</h3>
                    <p class="text-[#475569] leading-relaxed text-sm">
                        Utilizamos criptografía asimétrica para asegurar que tu voto permanezca anónimo y sea inalterable desde el momento de la emisión hasta el escrutinio.
                    </p>
                </div>
                <!-- Feature 2: Ease of Use -->
                <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200/80 hover:border-blue-400/40 transition-all group hover:shadow-md">
                    <div class="w-14 h-14 bg-green-100 text-green-700 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">volunteer_activism</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0c2340] mb-3">Facilidad de Uso</h3>
                    <p class="text-[#475569] leading-relaxed text-sm">
                        Una interfaz intuitiva que guía al estudiante paso a paso. Vota en menos de 60 segundos desde cualquier dispositivo móvil o de escritorio.
                    </p>
                </div>
                <!-- Feature 3: Real-time -->
                <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200/80 hover:border-blue-400/40 transition-all group hover:shadow-md">
                    <div class="w-14 h-14 bg-blue-100 text-[#072f57] rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">equalizer</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0c2340] mb-3">Resultados en Vivo</h3>
                    <p class="text-[#475569] leading-relaxed text-sm">
                        Transparencia total. Los administradores y estudiantes pueden seguir el progreso de la participación y los resultados consolidados al instante.
                    </p>
                </div>
            </div>
        </div>
    </section>
</main>

<!-- Footer -->
<footer class="bg-[#081b2e] text-slate-300 py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 border-b border-slate-700/60 pb-12">
            <div class="col-span-1 md:col-span-2 space-y-6">
                <div class="flex items-center gap-3">
                    <div class="bg-white p-1 rounded-lg">
                        <img alt="Wahl Mirai" class="w-8 h-8 object-contain" src="/images/logo.png" onerror="this.src='/images/imagen_voto.png'" />
                    </div>
                    <span class="text-xl font-bold text-white">Wahl Mirai</span>
                </div>
                <p class="text-slate-400 max-w-sm text-sm">
                    Potenciando el liderazgo estudiantil a través de tecnología transparente, segura y accesible para todos.
                </p>
            </div>
            <div>
                <h4 class="text-xs font-semibold text-white mb-6 uppercase tracking-wider">Proyecto</h4>
                <ul class="space-y-3 text-slate-400 text-sm">
                    <li><a class="hover:text-white transition-colors" href="#">Características</a></li>
                    <li><a class="hover:text-white transition-colors" href="#seguridad">Seguridad</a></li>
                    <li><a class="hover:text-white transition-colors" href="#">Casos de Éxito</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-xs font-semibold text-white mb-6 uppercase tracking-wider">Soporte</h4>
                <ul class="space-y-3 text-slate-400 text-sm">
                    <li><a class="hover:text-white transition-colors" href="#">Guía de Usuario</a></li>
                    <li><a class="hover:text-white transition-colors" href="#">Contacto</a></li>
                    <li><a class="hover:text-white transition-colors" href="#">Términos de Uso</a></li>
                </ul>
            </div>
        </div>
        <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-400 text-xs">
            <p>© 2024 Wahl Mirai. Todos los derechos reservados.</p>
            <div class="flex gap-6">
                <a class="hover:text-white transition-colors" href="#">Privacidad</a>
                <a class="hover:text-white transition-colors" href="#">Cookies</a>
                <a class="hover:text-white transition-colors" href="#">Legal</a>
            </div>
        </div>
    </div>
</footer>

<!-- BottomNavBar (Mobile Only) -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 sm:hidden bg-white border-t border-slate-200 shadow-lg">
    <a class="flex flex-col items-center justify-center bg-[#072f57] text-white rounded-xl px-5 py-1.5 transition-transform active:scale-90" href="/Auth/Login">
        <span class="material-symbols-outlined text-lg">ballot</span>
        <span class="text-[10px] font-medium">Votar</span>
    </a>
    <a class="flex flex-col items-center justify-center text-slate-600 transition-transform active:scale-90" href="/Results">
        <span class="material-symbols-outlined text-lg">query_stats</span>
        <span class="text-[10px] font-medium">Resultados</span>
    </a>
</nav>

@section Scripts {
    <script>
        // Micro-interaction for scroll effects
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (header) {
                if (window.scrollY > 20) {
                    header.classList.add('shadow-md');
                } else {
                    header.classList.remove('shadow-md');
                }
            }
        });
    </script>
}

