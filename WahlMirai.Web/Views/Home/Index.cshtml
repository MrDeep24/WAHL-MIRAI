@inject Microsoft.Extensions.Options.IOptions<WahlMirai.Web.Models.LicensingSettings> LicensingOptions
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Inicio";
    Layout = "_Layout";
}

<main>
    <!-- Hero Section matching design reference -->
    <section class="home-hero relative min-h-[calc(100vh-4rem)] flex items-center bg-[#b8daff] dark:bg-[#0c1829] py-12 md:py-16 overflow-hidden transition-colors duration-200">
        <div class="max-w-7xl mx-auto px-6 md:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left Column: Copy & CTAs -->
            <div class="lg:col-span-6 space-y-6">
                <!-- Small top pill badge -->
                <div class="hero-pill w-12 h-4 bg-[#a0c8f5]/80 dark:bg-blue-900/60 rounded-full mb-4"></div>
                
                <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold text-[#0c2340] dark:text-white leading-[1.12] tracking-tight">
                    El futuro de la<br />
                    <span class="italic text-[#073366] dark:text-blue-400 font-semibold">democracia</span><br />
                    <span class="italic text-[#073366] dark:text-blue-400 font-semibold">escolar</span> está en tus<br />
                    manos.
                </h1>
                
                <p class="text-[#335374] dark:text-slate-300 text-base md:text-lg max-w-lg leading-relaxed font-normal">
                    Wahl Mirai es la plataforma líder para la gestión de elecciones institucionales, garantizando el anonimato y la integridad de cada voto.
                </p>
                
                <div class="flex flex-wrap items-center gap-4 pt-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var isAdministrativeUser = User.IsInRole(Roles.AdminName) || User.IsInRole(Roles.SuperAdminName);
                        var panelUrl = isAdministrativeUser ? "/AdminEvents" : "/Elector/Dashboard";
                        var panelLabel = isAdministrativeUser ? "Regresar al Panel de Control" : "Ir a Votaciones";
                        <a href="@panelUrl" class="inline-flex items-center gap-3 bg-[#072f57] hover:bg-[#052342] dark:bg-blue-600 dark:hover:bg-blue-500 text-white font-semibold px-7 py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-95 transition-all text-base">
                            <span class="material-symbols-outlined text-xl">arrow_back</span>
                            <span>@panelLabel</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="inline-flex items-center gap-3 bg-[#072f57] hover:bg-[#052342] dark:bg-blue-600 dark:hover:bg-blue-500 text-white font-semibold px-7 py-3.5 rounded-xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-95 transition-all text-base">
                            <span>Empezar a Votar</span>
                            <span class="material-symbols-outlined text-xl">how_to_vote</span>
                        </a>
                    }
                    <button type="button" onclick="openApkModal()" class="inline-flex items-center gap-2.5 bg-white/90 hover:bg-white dark:bg-slate-800/90 dark:hover:bg-slate-800 text-[#0c2340] dark:text-white border border-[#335374]/30 dark:border-slate-700 font-semibold px-6 py-3.5 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-95 transition-all text-base group cursor-pointer" title="Descargar aplicación móvil (APK)">
                        <span class="material-symbols-outlined text-xl text-emerald-600 dark:text-emerald-400 group-hover:scale-110 transition-transform">android</span>
                        <span>Descargar aplicación móvil (APK)</span>
                    </button>
                </div>

                @{
                    var apkSha256 = Configuration["MobileApp:Sha256"] ?? "47a3dc458b070fd6b45608d9fc75d92d99938b7461e63a112a57a081ff5ade88";
                }
                <div class="flex items-center gap-2 text-xs text-[#335374] dark:text-slate-400 pt-1">
                    <span class="material-symbols-outlined text-sm text-emerald-700 dark:text-emerald-400">verified</span>
                    <span class="font-medium">SHA-256:</span>
                    <code class="font-mono text-[11px] bg-white/70 dark:bg-slate-800/80 px-2 py-0.5 rounded border border-[#335374]/20 dark:border-slate-700/60 select-all" title="Sello de integridad SHA-256">@apkSha256</code>
                </div>
            </div>
            
            <!-- Right Column: Hero Illustration -->
            <div class="lg:col-span-6 flex justify-center items-center">
                <div class="relative w-full max-w-[580px] flex justify-center items-center">
                    <img src="/images/imagen_voto.png" alt="Ilustración de votación Wahl Mirai" class="w-full h-auto max-h-[520px] object-contain drop-shadow-sm" />
                </div>
            </div>

        </div>
    </section>

    <!-- Features Section -->
    <section class="home-features-section py-16 md:py-24 bg-white dark:bg-[#090d16] transition-colors duration-200" id="seguridad">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <div class="text-center space-y-4 mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-[#0c2340] dark:text-white">Diseñado para la integridad institucional</h2>
                <p class="subtitle text-[#475569] dark:text-slate-400 max-w-2xl mx-auto text-base">Nuestra arquitectura se centra en tres pilares fundamentales que garantizan un proceso electoral impecable.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Feature 1: Security -->
                <div class="home-feature-card bg-slate-50 dark:bg-slate-800/60 p-8 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 hover:border-blue-400/40 transition-all group hover:shadow-md">
                    <div class="home-feature-icon-red w-14 h-14 bg-red-100 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">lock</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0c2340] dark:text-white mb-3">Voto Cifrado</h3>
                    <p class="text-[#475569] dark:text-slate-300 leading-relaxed text-sm">
                        Utilizamos criptografía asimétrica para asegurar que tu voto permanezca anónimo y sea inalterable desde el momento de la emisión hasta el escrutinio.
                    </p>
                </div>
                <!-- Feature 2: Ease of Use -->
                <div class="home-feature-card bg-slate-50 dark:bg-slate-800/60 p-8 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 hover:border-blue-400/40 transition-all group hover:shadow-md">
                    <div class="home-feature-icon-green w-14 h-14 bg-green-100 dark:bg-green-950/50 text-green-700 dark:text-green-400 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">volunteer_activism</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0c2340] dark:text-white mb-3">Facilidad de Uso</h3>
                    <p class="text-[#475569] dark:text-slate-300 leading-relaxed text-sm">
                        Una interfaz intuitiva que guía al estudiante paso a paso. Vota en menos de 60 segundos desde cualquier dispositivo móvil o de escritorio.
                    </p>
                </div>
                <!-- Feature 3: Real-time -->
                <div class="home-feature-card bg-slate-50 dark:bg-slate-800/60 p-8 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 hover:border-blue-400/40 transition-all group hover:shadow-md">
                    <div class="home-feature-icon-blue w-14 h-14 bg-blue-100 dark:bg-blue-950/50 text-[#072f57] dark:text-blue-400 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                        <span class="material-symbols-outlined text-[32px]">equalizer</span>
                    </div>
                    <h3 class="text-xl font-bold text-[#0c2340] dark:text-white mb-3">Resultados en Vivo</h3>
                    <p class="text-[#475569] dark:text-slate-300 leading-relaxed text-sm">
                        Transparencia total. Los administradores y estudiantes pueden seguir el progreso de la participación y los resultados consolidados al instante.
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- Modal de instrucciones de descarga APK -->
    <div id="apk-download-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs hidden items-center justify-center p-4 z-50 fade-in" onclick="if(event.target===this) closeApkModal()" role="dialog" aria-modal="true" aria-labelledby="apk-modal-title">
        <div class="bg-white dark:bg-[#0c1829] w-full max-w-xl rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700/80 overflow-hidden transition-all transform flex flex-col max-h-[90vh]">
            <!-- Header Modal -->
            <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-slate-50/70 dark:bg-slate-900/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl">android</span>
                    </div>
                    <div>
                        <h3 id="apk-modal-title" class="text-lg sm:text-xl font-bold text-[#0c2340] dark:text-white leading-tight">Instrucciones de Descarga e Instalación (APK)</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Wahl Mirai Android · Versión Oficial</p>
                    </div>
                </div>
                <button type="button" onclick="closeApkModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-2 rounded-xl hover:bg-slate-200/50 dark:hover:bg-slate-800 transition-colors cursor-pointer" title="Cerrar" aria-label="Cerrar modal">
                    <span class="material-symbols-outlined text-xl">close</span>
                </button>
            </div>

            <!-- Body Modal -->
            <div class="px-6 py-5 overflow-y-auto space-y-4">
                <!-- Advertencia de seguridad -->
                <div class="p-4 bg-amber-50 dark:bg-amber-950/40 border border-amber-200/90 dark:border-amber-800/60 rounded-xl flex items-start gap-3">
                    <span class="material-symbols-outlined text-amber-600 dark:text-amber-400 text-2xl shrink-0 mt-0.5">warning</span>
                    <div>
                        <h4 class="font-bold text-xs sm:text-sm text-amber-950 dark:text-amber-200">Aviso sobre advertencias de seguridad en Android</h4>
                        <p class="text-xs text-amber-900/90 dark:text-amber-200/90 leading-relaxed mt-1">Al descargar aplicaciones fuera de Google Play Store, Android muestra alertas preventivas como «Archivo potencialmente dañino». Este es un comportamiento estándar del sistema operativo. La aplicación oficial de Wahl Mirai es totalmente segura, institucional y de código abierto.</p>
                    </div>
                </div>

                <!-- Pasos de instalación -->
                <div class="space-y-3">
                    <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
                        <span class="w-6 h-6 rounded-full bg-[#072f57] dark:bg-blue-600 text-white font-bold flex items-center justify-center shrink-0 text-xs mt-0.5">1</span>
                        <div class="text-xs sm:text-sm">
                            <p class="font-semibold text-[#0c2340] dark:text-white">Paso 1: Confirmar la descarga en el navegador</p>
                            <p class="text-slate-600 dark:text-slate-300 text-xs mt-0.5 leading-relaxed">Si el navegador te pregunta si deseas conservar o descargar el archivo, pulsa en «Descargar de todos modos» o «Aceptar».</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
                        <span class="w-6 h-6 rounded-full bg-[#072f57] dark:bg-blue-600 text-white font-bold flex items-center justify-center shrink-0 text-xs mt-0.5">2</span>
                        <div class="text-xs sm:text-sm">
                            <p class="font-semibold text-[#0c2340] dark:text-white">Paso 2: Permitir la instalación de fuentes desconocidas</p>
                            <p class="text-slate-600 dark:text-slate-300 text-xs mt-0.5 leading-relaxed">Al abrir el APK, si Android bloquea la instalación, toca «Configuración» o «Ajustes» y activa la casilla «Permitir desde esta fuente».</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60">
                        <span class="w-6 h-6 rounded-full bg-[#072f57] dark:bg-blue-600 text-white font-bold flex items-center justify-center shrink-0 text-xs mt-0.5">3</span>
                        <div class="text-xs sm:text-sm">
                            <p class="font-semibold text-[#0c2340] dark:text-white">Paso 3: Completar la instalación</p>
                            <p class="text-slate-600 dark:text-slate-300 text-xs mt-0.5 leading-relaxed">Regresa a la pantalla del instalador y pulsa «Instalar». Si Play Protect muestra una ventana de aviso, selecciona «Más detalles» y «Instalar de todas formas».</p>
                        </div>
                    </div>
                </div>

                <!-- Verificación criptográfica -->
                <div class="p-3.5 rounded-xl bg-slate-100/80 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 space-y-1.5">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="material-symbols-outlined text-sm text-emerald-600 dark:text-emerald-400">verified</span>
                        <span class="font-semibold text-slate-700 dark:text-slate-300">Verificación de autenticidad criptográfica:</span>
                    </div>
                    <code class="block font-mono text-[11px] bg-white dark:bg-slate-900/90 p-2 rounded border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 break-all select-all">@apkSha256</code>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400">Puedes verificar que el APK descargado coincida con este hash oficial antes de instalarlo.</p>
                </div>
            </div>

            <!-- Footer Modal Buttons -->
            <div class="px-6 py-4 bg-slate-50 dark:bg-slate-900/50 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-end gap-3">
                <button type="button" onclick="closeApkModal()" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition-colors cursor-pointer">
                    Cancelar
                </button>
                <a href="/descargar-app" onclick="closeApkModal()" class="inline-flex items-center gap-2 bg-[#072f57] hover:bg-[#052342] dark:bg-blue-600 dark:hover:bg-blue-500 text-white font-semibold px-6 py-2.5 rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 active:scale-95 transition-all text-sm cursor-pointer">
                    <span class="material-symbols-outlined text-lg">download</span>
                    <span>Entendido, descargar APK</span>
                </a>
            </div>
        </div>
    </div>
</main>

<!-- Footer -->
<footer class="bg-[#081b2e] text-slate-300 py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 border-b border-slate-700/60 pb-12">
            <div class="col-span-2 space-y-6">
                <div class="flex items-center gap-3">
                    <div class="bg-white p-1 rounded-lg">
                        <img alt="Wahl Mirai" class="w-8 h-8 object-contain" src="/images/logo.png" onerror="this.src='/images/imagen_voto.png'" />
                    </div>
                    <span class="text-xl font-bold text-white">Wahl Mirai</span>
                </div>
                <p class="text-slate-400 max-w-sm text-sm">
                    Potenciando el liderazgo estudiantil a través de tecnología transparente, segura y accesible para todos.
                </p>
            </div>
            <nav aria-label="Soporte">
                <h4 class="text-xs font-semibold text-white mb-6 uppercase tracking-wider">Soporte</h4>
                <ul class="space-y-3 text-slate-400 text-sm">
                    <li><a class="hover:text-white transition-colors" href="/Ayuda">Guía de Usuario</a></li>
                    <li><a class="hover:text-white transition-colors" asp-controller="Legal" asp-action="Contacto">Contacto</a></li>
                </ul>
            </nav>
            <nav aria-label="Legal">
                <h4 class="text-xs font-semibold text-white mb-6 uppercase tracking-wider">Legal</h4>
                <ul class="space-y-3 text-slate-400 text-sm">
                    <li><a class="hover:text-white transition-colors" asp-controller="Legal" asp-action="Terminos">Términos de Uso</a></li>
                    <li><a class="hover:text-white transition-colors" asp-controller="Legal" asp-action="Privacidad">Privacidad</a></li>
                    <li><a class="hover:text-white transition-colors" asp-controller="Legal" asp-action="Cookies">Cookies</a></li>
                    <li><a class="hover:text-white transition-colors" asp-controller="Legal" asp-action="Index">Marco Legal y Políticas</a></li>
                    @if (LicensingOptions.Value.SafeSourceCodeUrl != null)
                    {
                        <li><a class="hover:text-white transition-colors" href="@LicensingOptions.Value.SafeSourceCodeUrl" target="_blank" rel="noopener noreferrer">Código fuente (AGPL-3.0)</a></li>
                    }
                </ul>
            </nav>
        </div>
        <div class="pt-8 text-slate-400 text-xs text-center md:text-left">
            <p>© 2026 Wahl Mirai. <span>Todos los derechos reservados.</span></p>
        </div>
    </div>
</footer>

@section Scripts {
    <script>
        // Modal de instrucciones de descarga APK
        window.openApkModal = function() {
            const modal = document.getElementById('apk-download-modal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
            }
        };

        window.closeApkModal = function() {
            const modal = document.getElementById('apk-download-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
            }
        };

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                window.closeApkModal();
            }
        });

        // Micro-interaction for scroll effects
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (header) {
                if (window.scrollY > 20) {
                    header.classList.add('shadow-md');
                } else {
                    header.classList.remove('shadow-md');
                }
            }
        });
    </script>
}


