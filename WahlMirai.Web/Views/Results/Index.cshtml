@model List<WahlMirai.Web.Models.VwVoteCount>
@{
    ViewData["Title"] = "Resultados";
    bool isAdmin = User.IsInRole("ADMIN") || User.IsInRole("SUPER_ADMIN");
    Layout = isAdmin ? "_AdminLayout" : "_ElectorLayout";
    long totalVotes = Model?.Sum(m => m.TotalVotes) ?? 0L;
    string eventTitle = ViewBag.EventTitle;
    string eventStatus = ViewBag.EventStatus;
    int eventId = ViewBag.EventId ?? 0;
}

<div class="fade-in max-w-6xl mx-auto">
    <div class="flex justify-between items-start mb-6 flex-wrap gap-3">
        <div>
            <h1 class="text-3xl font-bold flex items-center gap-3">
                Resultados en tiempo real 
                @if(eventStatus == "ACTIVA")
                {
                    <span id="live-status-indicator" class="text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 px-2.5 py-1 rounded-full font-semibold flex items-center gap-1.5 animate-pulse">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span> EN VIVO
                    </span>
                }
            </h1>
            <p class="text-on-surface-variant mt-1">@eventTitle @(isAdmin ? "— acceso irrestricto de Administrador (RN-5)" : "")</p>
        </div>
        <div class="flex gap-6 text-right">
            <div>
                <p class="text-xs text-on-surface-variant">Total votos</p>
                <p id="total-votes-count" class="text-2xl font-bold transition-all duration-300">@totalVotes</p>
            </div>
        </div>
    </div>

    @{
        var topCandidate = Model?.OrderByDescending(m => m.TotalVotes).FirstOrDefault();
        var secondCandidate = Model?.OrderByDescending(m => m.TotalVotes).Skip(1).FirstOrDefault();
        long threshold = (totalVotes / 2) + 1;
        bool isFinalized = eventStatus == "FINALIZADA";
        bool hasMajorityWinner = topCandidate != null && totalVotes > 0 && topCandidate.TotalVotes >= threshold;
        bool isTie = isFinalized && topCandidate != null && secondCandidate != null && topCandidate.TotalVotes == secondCandidate.TotalVotes && topCandidate.TotalVotes > 0;
        bool hasFinalizedWinner = isFinalized && topCandidate != null && totalVotes > 0 && !isTie;
    }

    <div id="winner-banner" class="mb-6 p-4 rounded-xl border flex items-center gap-4 transition-all duration-300 @(hasFinalizedWinner ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-700 dark:text-emerald-300" : (isTie ? "bg-amber-500/10 border-amber-500/30 text-amber-700 dark:text-amber-300" : "bg-surface-container-low border-border-subtle text-on-surface-variant"))">
        <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 @(hasFinalizedWinner ? "bg-emerald-500 text-white" : (isTie ? "bg-amber-500 text-white" : "bg-surface-container-high text-on-surface-variant"))">
            <span class="material-symbols-outlined text-2xl">emoji_events</span>
        </div>
        <div>
            @if (isFinalized)
            {
                if (hasFinalizedWinner && topCandidate != null)
                {
                    <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                        🏆 Ganador Definitivo de la Elección @(hasMajorityWinner ? "(Mayoría Absoluta 50% + 1)" : "(Mayoría Simple)")
                    </span>
                    <h3 class="text-lg font-bold">@topCandidate.CandidateName</h3>
                    <p class="text-xs">Obtuvo el primer lugar con @topCandidate.TotalVotes voto(s) (@(Math.Round((double)topCandidate.TotalVotes / totalVotes * 100, 1))% del total de @totalVotes votos emitidos).</p>
                }
                else if (isTie && topCandidate != null)
                {
                    <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">⚖️ Empate Técnico Registrado</span>
                    <h3 class="text-lg font-bold">Empate en el primer lugar</h3>
                    <p class="text-xs">Dos o más candidatos obtuvieron exactamente @topCandidate.TotalVotes voto(s). Se requiere definir el mecanismo de desempate.</p>
                }
                else
                {
                    <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Resultado de la Elección</span>
                    <h3 class="text-base font-semibold">No se registraron votos en este proceso electoral.</h3>
                    <p class="text-xs">Proceso finalizado.</p>
                }
            }
            else
            {
                <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Proceso Electoral en Curso</span>
                <h3 class="text-base font-semibold">Votación activa</h3>
                <p class="text-xs">El ganador oficial se definirá y mostrará únicamente al finalizar la elección.</p>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="lg:col-span-2 bg-surface-container-lowest rounded-xl border border-border-subtle shadow-card p-6">
            <h2 class="font-semibold mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined">bar_chart</span> Distribución de votos
            </h2>
            <div id="chart-bars-container" class="flex items-end gap-2 md:gap-6 h-56 overflow-x-auto pb-2">
                @if(Model != null && Model.Any() && totalVotes > 0)
                {
                    long maxVotes = Model.Max(m => m.TotalVotes);
                    string[] palette = { "bg-primary", "bg-secondary", "bg-tertiary", "bg-surface-tint" };
                    int i = 0;
                    foreach(var item in Model)
                    {
                        double percentage = Math.Round((double)item.TotalVotes / totalVotes * 100);
                        double height = maxVotes > 0 ? Math.Round((double)item.TotalVotes / maxVotes * 100) : 0;
                        string color = palette[i % palette.Length];
                        
                        <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end min-w-[60px] md:min-w-0 shrink-0 md:shrink">
                            <span class="text-xs font-semibold candidate-percentage">@percentage%</span>
                            <div class="@color rounded-t-md w-full transition-all duration-500 ease-out" style="height:@height%"></div>
                            <span class="text-xs text-on-surface-variant text-center break-words w-full truncate px-1" title="@item.CandidateName">@item.CandidateName</span>
                        </div>
                        i++;
                    }
                }
                else
                {
                    <div class="w-full flex items-center justify-center text-on-surface-variant text-sm">
                        No hay votos registrados todavía.
                    </div>
                }
            </div>
        </div>
        <div id="cards-container" class="flex flex-col gap-3">
            @if(Model != null && Model.Any() && totalVotes > 0)
            {
                string[] borderPalette = { "border-primary", "border-secondary", "border-tertiary", "border-surface-tint" };
                int i = 0;
                foreach(var item in Model.OrderByDescending(m => m.TotalVotes))
                {
                    double percentage = Math.Round((double)item.TotalVotes / totalVotes * 100, 1);
                    string borderColor = borderPalette[i % borderPalette.Length];
                    
                    <div class="bg-surface-container-lowest rounded-xl border-l-4 @borderColor border-t border-r border-b border-border-subtle shadow-card p-4 flex justify-between items-center transition-all duration-300">
                        <div>
                            <p class="font-semibold text-sm">@item.CandidateName</p>
                        </div>
                        <div class="text-right">
                            <p class="font-bold candidate-percentage-card">@percentage%</p>
                            <p class="text-xs text-on-surface-variant candidate-votes-card">@item.TotalVotes votos</p>
                        </div>
                    </div>
                    i++;
                }
            }
        </div>
    </div>
</div>

<!-- Script SignalR y sincronización en tiempo real -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    (function () {
        const eventId = @eventId;
        const palette = ["bg-primary", "bg-secondary", "bg-tertiary", "bg-surface-tint"];
        const borderPalette = ["border-primary", "border-secondary", "border-tertiary", "border-surface-tint"];

        function updateUI(data) {
            if (!data || !data.candidates) return;

            const totalVotes = data.totalVotes || 0;
            const totalEl = document.getElementById("total-votes-count");
            if (totalEl) {
                totalEl.textContent = totalVotes;
                totalEl.classList.add("scale-110", "text-primary");
                setTimeout(() => totalEl.classList.remove("scale-110", "text-primary"), 300);
            }

            const barsContainer = document.getElementById("chart-bars-container");
            const cardsContainer = document.getElementById("cards-container");
            const winnerBanner = document.getElementById("winner-banner");

            if (winnerBanner) {
                const eventStatus = "@eventStatus";
                const isFinalized = eventStatus === "FINALIZADA";
                const threshold = Math.floor(totalVotes / 2) + 1;
                const sortedCandidates = [...data.candidates].sort((a, b) => b.totalVotes - a.totalVotes);
                const top = sortedCandidates[0];
                const second = sortedCandidates[1];

                const hasMajorityWinner = top && totalVotes > 0 && top.totalVotes >= threshold;
                const isTie = isFinalized && top && second && top.totalVotes === second.totalVotes && top.totalVotes > 0;
                const hasFinalizedWinner = isFinalized && top && totalVotes > 0 && !isTie;

                if (isFinalized) {
                    if (hasFinalizedWinner) {
                        const pct = Math.round((top.totalVotes / totalVotes) * 100 * 10) / 10;
                        winnerBanner.className = "mb-6 p-4 rounded-xl border flex items-center gap-4 transition-all duration-300 bg-emerald-500/10 border-emerald-500/30 text-emerald-700 dark:text-emerald-300";
                        winnerBanner.innerHTML = `
                            <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-emerald-500 text-white">
                                <span class="material-symbols-outlined text-2xl">emoji_events</span>
                            </div>
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">🏆 Ganador Definitivo de la Elección ${hasMajorityWinner ? '(Mayoría Absoluta 50% + 1)' : '(Mayoría Simple)'}</span>
                                <h3 class="text-lg font-bold">${escapeHtml(top.candidateName)}</h3>
                                <p class="text-xs">Obtuvo el primer lugar con ${top.totalVotes} voto(s) (${pct}% del total de ${totalVotes} votos emitidos).</p>
                            </div>
                        `;
                    } else if (isTie) {
                        winnerBanner.className = "mb-6 p-4 rounded-xl border flex items-center gap-4 transition-all duration-300 bg-amber-500/10 border-amber-500/30 text-amber-700 dark:text-amber-300";
                        winnerBanner.innerHTML = `
                            <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-amber-500 text-white">
                                <span class="material-symbols-outlined text-2xl">emoji_events</span>
                            </div>
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">⚖️ Empate Técnico Registrado</span>
                                <h3 class="text-lg font-bold">Empate en el primer lugar</h3>
                                <p class="text-xs">Dos o más candidatos obtuvieron exactamente ${top.totalVotes} voto(s).</p>
                            </div>
                        `;
                    } else {
                        winnerBanner.className = "mb-6 p-4 rounded-xl border flex items-center gap-4 transition-all duration-300 bg-surface-container-low border-border-subtle text-on-surface-variant";
                        winnerBanner.innerHTML = `
                            <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-surface-container-high text-on-surface-variant">
                                <span class="material-symbols-outlined text-2xl">emoji_events</span>
                            </div>
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Resultado de la Elección</span>
                                <h3 class="text-base font-semibold">No se registraron votos en este proceso electoral.</h3>
                                <p class="text-xs">Proceso finalizado.</p>
                            </div>
                        `;
                    }
                } else {
                    winnerBanner.className = "mb-6 p-4 rounded-xl border flex items-center gap-4 transition-all duration-300 bg-surface-container-low border-border-subtle text-on-surface-variant";
                    winnerBanner.innerHTML = `
                        <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0 bg-surface-container-high text-on-surface-variant">
                            <span class="material-symbols-outlined text-2xl">emoji_events</span>
                        </div>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant">Proceso Electoral en Curso</span>
                            <h3 class="text-base font-semibold">Votación activa</h3>
                            <p class="text-xs">El ganador oficial se definirá y mostrará únicamente al finalizar la elección.</p>
                        </div>
                    `;
                }
            }

            if (totalVotes === 0 || data.candidates.length === 0) {
                if (barsContainer) {
                    barsContainer.innerHTML = '<div class="w-full flex items-center justify-center text-on-surface-variant text-sm">No hay votos registrados todavía.</div>';
                }
                if (cardsContainer) cardsContainer.innerHTML = '';
                return;
            }

            // Actualizar Gráfico de Barras
            if (barsContainer) {
                const maxVotes = Math.max(...data.candidates.map(c => c.totalVotes), 1);
                let barsHTML = '';
                data.candidates.forEach((item, idx) => {
                    const pct = Math.round((item.totalVotes / totalVotes) * 100);
                    const h = Math.round((item.totalVotes / maxVotes) * 100);
                    const color = palette[idx % palette.length];

                    barsHTML += `
                        <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end min-w-[60px] md:min-w-0 shrink-0 md:shrink">
                            <span class="text-xs font-semibold">${pct}%</span>
                            <div class="${color} rounded-t-md w-full transition-all duration-500 ease-out" style="height:${h}%"></div>
                            <span class="text-xs text-on-surface-variant text-center break-words w-full truncate px-1" title="${escapeHtml(item.candidateName)}">${escapeHtml(item.candidateName)}</span>
                        </div>
                    `;
                });
                barsContainer.innerHTML = barsHTML;
            }

            // Actualizar Tarjetas de Candidatos (ordenados descendente)
            if (cardsContainer) {
                const sorted = [...data.candidates].sort((a, b) => b.totalVotes - a.totalVotes);
                let cardsHTML = '';
                sorted.forEach((item, idx) => {
                    const pct = Math.round((item.totalVotes / totalVotes) * 100 * 10) / 10;
                    const borderColor = borderPalette[idx % borderPalette.Length];

                    cardsHTML += `
                        <div class="bg-surface-container-lowest rounded-xl border-l-4 ${borderColor} border-t border-r border-b border-border-subtle shadow-card p-4 flex justify-between items-center transition-all duration-300">
                            <div>
                                <p class="font-semibold text-sm">${escapeHtml(item.candidateName)}</p>
                            </div>
                            <div class="text-right">
                                <p class="font-bold">${pct}%</p>
                                <p class="text-xs text-on-surface-variant">${item.totalVotes} votos</p>
                            </div>
                        </div>
                    `;
                });
                cardsContainer.innerHTML = cardsHTML;
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Conectar SignalR
        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/resultsHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveResultsUpdate", function (data) {
                if (data && (data.eventId === eventId || data.EventId === eventId)) {
                    updateUI(data);
                }
            });

            connection.start()
                .then(() => {
                    connection.invoke("JoinEventGroup", eventId).catch(err => console.error("Error al unirse al grupo:", err));
                })
                .catch(err => {
                    console.warn("SignalR fallback a polling activo:", err);
                    startPolling();
                });
        } else {
            startPolling();
        }

        function fetchLatest() {
            fetch(`/Results/GetLiveData/${eventId}`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.ok) {
                        updateUI(data);
                    }
                })
                .catch(err => console.error("Error en polling de resultados:", err));
        }

        function startPolling() {
            setInterval(fetchLatest, 5000);
        }
    })();
</script>
