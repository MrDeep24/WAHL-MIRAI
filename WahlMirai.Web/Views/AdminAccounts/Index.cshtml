@model List<WahlMirai.Web.Services.AdminAccountListItem>
@{
    ViewData["Title"] = "Cuentas administrativas";
    Layout = "_AdminLayout";
}

<div class="fade-in max-w-7xl mx-auto">
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700">@TempData["Error"]</div>
    }

    <div class="mb-6">
        <h1 class="text-3xl font-bold mb-1">Cuentas administrativas</h1>
        <p class="text-on-surface-variant">Gestiona cuentas ADMIN y SUPER_ADMIN. Las contraseñas se entregan únicamente por correo.</p>
    </div>

    <section class="mb-8 bg-surface-container-lowest rounded-xl border border-border-subtle p-5 shadow-card">
        <h2 class="text-lg font-semibold mb-4">Crear cuenta administrativa</h2>
        <form asp-action="Create" method="post" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            @Html.AntiForgeryToken()
            <label class="text-sm font-medium">Documento<input name="Document" required maxlength="50" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <label class="text-sm font-medium">Nombre completo<input name="FullName" required maxlength="150" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <label class="text-sm font-medium">Correo de contacto<input name="ContactEmail" type="email" required maxlength="150" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <label class="text-sm font-medium">Rol<select name="RoleName" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg"><option value="ADMIN">ADMIN</option><option value="SUPER_ADMIN">SUPER_ADMIN</option></select></label>
            <label class="text-sm font-medium">Cargo institucional<input name="PositionTitle" maxlength="100" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <div class="flex items-end"><button type="submit" class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary rounded-lg px-4 py-2.5 font-semibold"><span class="material-symbols-outlined">person_add</span>Crear cuenta</button></div>
        </form>
    </section>

    <div class="bg-surface-container-lowest rounded-xl border border-border-subtle shadow-card overflow-x-auto">
        <table class="w-full text-sm min-w-[900px]">
            <thead class="bg-surface-container-low text-left text-xs uppercase text-on-surface-variant">
                <tr><th class="px-5 py-3">Nombre</th><th class="px-5 py-3">Documento</th><th class="px-5 py-3">Correo</th><th class="px-5 py-3">Rol / Cargo</th><th class="px-5 py-3">Estado</th><th class="px-5 py-3 text-right">Acciones</th></tr>
            </thead>
            <tbody>
            @foreach (var account in Model)
            {
                var deleted = account.Status == "ELIMINADO";
                <tr class="border-t border-border-subtle @(deleted ? "opacity-60" : "")">
                    <td class="px-5 py-4 font-medium">@account.FullName</td>
                    <td class="px-5 py-4">@account.Document</td>
                    <td class="px-5 py-4">@account.ContactEmail</td>
                    <td class="px-5 py-4"><div>@account.RoleName</div><div class="text-xs text-on-surface-variant">@(account.PositionTitle ?? "Sin cargo institucional")</div></td>
                    <td class="px-5 py-4">@account.Status</td>
                    <td class="px-5 py-4">
                        <details class="text-right">
                            <summary class="cursor-pointer text-primary font-semibold">Editar</summary>
                            <form asp-action="Edit" method="post" class="mt-3 grid gap-2 text-left min-w-[260px]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@account.Id" />
                                <input name="Document" value="@account.Document" required maxlength="50" class="px-3 py-2 border border-outline-variant rounded-lg" aria-label="Documento" />
                                <input name="FullName" value="@account.FullName" required maxlength="150" class="px-3 py-2 border border-outline-variant rounded-lg" aria-label="Nombre completo" />
                                <input name="ContactEmail" value="@account.ContactEmail" type="email" required maxlength="150" class="px-3 py-2 border border-outline-variant rounded-lg" aria-label="Correo" />
                                <select name="RoleName" class="px-3 py-2 border border-outline-variant rounded-lg" aria-label="Rol"><option selected="@(account.RoleName == "ADMIN")">ADMIN</option><option selected="@(account.RoleName == "SUPER_ADMIN")">SUPER_ADMIN</option></select>
                                <input name="PositionTitle" value="@account.PositionTitle" maxlength="100" class="px-3 py-2 border border-outline-variant rounded-lg" aria-label="Cargo institucional" />
                                <button type="submit" class="bg-primary text-on-primary rounded-lg px-3 py-2 font-semibold">Guardar cambios</button>
                            </form>
                            @if (deleted)
                            {
                                <form asp-action="Restore" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@account.Id" /><button class="text-emerald-700 font-semibold" type="submit">Restaurar</button></form>
                            }
                            else
                            {
                                <form asp-action="Delete" method="post" class="mt-2" onsubmit="return confirm('¿Eliminar lógicamente esta cuenta?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@account.Id" /><button class="text-rose-700 font-semibold" type="submit">Eliminar lógicamente</button></form>
                            }
                        </details>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <p class="p-8 text-center text-on-surface-variant">No hay cuentas administrativas registradas.</p>
        }
    </div>
</div>