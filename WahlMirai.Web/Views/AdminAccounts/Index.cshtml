@model List<WahlMirai.Web.Services.AdminAccountListItem>
@{
    ViewData["Title"] = "Cuentas administrativas";
    Layout = "_AdminLayout";
}

<div class="fade-in max-w-7xl mx-auto">
    @if (TempData["Success"] != null) { <div class="mb-4 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="mb-4 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700">@TempData["Error"]</div> }

    <div class="flex justify-between items-start gap-4 mb-6 flex-wrap">
        <div>
            <h1 class="text-3xl font-bold mb-1">Cuentas administrativas</h1>
            <p class="text-on-surface-variant">Gestiona cuentas ADMIN y SUPER_ADMIN. Las contraseñas se entregan únicamente por correo.</p>
        </div>
        <button type="button" onclick="openAdminModal('create-admin-modal')" class="flex items-center gap-2 bg-primary text-on-primary rounded-lg px-4 py-2.5 font-semibold transition-colors hover:bg-primary/90 hover:shadow-md">
            <span class="material-symbols-outlined">person_add</span>Nueva cuenta
        </button>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-border-subtle shadow-card overflow-x-auto">
        <table class="w-full text-sm min-w-[900px]">
            <thead class="bg-surface-container-low text-left text-xs uppercase text-on-surface-variant">
                <tr><th class="px-5 py-3">Nombre</th><th class="px-5 py-3">Documento</th><th class="px-5 py-3">Correo</th><th class="px-5 py-3">Rol / Cargo</th><th class="px-5 py-3">Estado</th><th class="px-5 py-3 text-right">Acciones</th></tr>
            </thead>
            <tbody>
            @foreach (var account in Model)
            {
                var deleted = account.Status == "ELIMINADO";
                <tr class="border-t border-border-subtle @(deleted ? "opacity-60" : "")">
                    <td class="px-5 py-4 font-medium">@account.FullName</td>
                    <td class="px-5 py-4">@account.Document</td>
                    <td class="px-5 py-4">@account.ContactEmail</td>
                    <td class="px-5 py-4"><div>@account.RoleName</div><div class="text-xs text-on-surface-variant">@(account.PositionTitle ?? "Sin cargo institucional")</div></td>
                    <td class="px-5 py-4">@account.Status</td>
                    <td class="px-5 py-4 text-right">
                        <button type="button" class="text-primary font-semibold mr-3 transition-colors hover:text-primary/70 hover:underline" onclick='openEditAdmin(@account.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(account.Document)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(account.FullName)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(account.ContactEmail)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(account.RoleName)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(account.PositionTitle ?? "")))'>Editar</button>
                        @if (deleted)
                        {
                            <form asp-action="Restore" method="post" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@account.Id" /><button class="text-emerald-700 font-semibold" type="submit">Restaurar</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any()) { <p class="p-8 text-center text-on-surface-variant">No hay cuentas administrativas registradas.</p> }
    </div>
</div>

<div id="create-admin-modal" class="fixed inset-0 bg-inverse-surface/60 hidden items-end md:items-center justify-center p-0 md:p-6 z-40" onclick="closeOnBackdrop(event, this)">
    <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-lg w-full p-5 md:p-6">
        <div class="flex justify-between items-center mb-5"><h2 class="text-lg font-bold">Nueva cuenta administrativa</h2><button type="button" onclick="closeAdminModal('create-admin-modal')"><span class="material-symbols-outlined">close</span></button></div>
        <form asp-action="Create" method="post" class="grid gap-4" onsubmit="return validateAdminDocument(this)">
            @Html.AntiForgeryToken()
            <label class="text-sm font-semibold">Documento<input name="Document" required maxlength="50" inputmode="numeric" pattern="[0-9]+" title="Ingrese únicamente números" class="admin-document mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" oninput="this.value = this.value.replace(/[^0-9]/g, ''); this.setCustomValidity(this.value.trim() ? '' : 'El documento es obligatorio.');" /></label>
            <label class="text-sm font-semibold">Nombre completo<input name="FullName" required minlength="3" maxlength="150" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü]+(?:[ '\-][A-Za-zÁÉÍÓÚáéíóúÑñÜü]+)*" title="Use solo letras, espacios, guiones o apóstrofes" class="person-name mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" oninput="if (this.value.trim().length < 3) this.setCustomValidity('El nombre debe tener al menos 3 caracteres.'); else this.setCustomValidity('');" /></label>
            <label class="text-sm font-semibold">Correo de contacto<input name="ContactEmail" type="email" required maxlength="150" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <label class="text-sm font-semibold">Rol<select name="RoleName" required class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg"><option value="ADMIN">ADMIN</option><option value="SUPER_ADMIN">SUPER_ADMIN</option></select></label>
            <label class="text-sm font-semibold">Cargo institucional<input name="PositionTitle" maxlength="100" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <button type="submit" class="bg-primary text-on-primary rounded-lg px-4 py-2.5 font-semibold transition-colors hover:bg-primary/90 hover:shadow-md">Crear cuenta</button>
        </form>
    </div>
</div>

<div id="edit-admin-modal" class="fixed inset-0 bg-inverse-surface/60 hidden items-end md:items-center justify-center p-0 md:p-6 z-40" onclick="closeOnBackdrop(event, this)">
    <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-lg w-full p-5 md:p-6">
        <div class="flex justify-between items-center mb-5"><h2 class="text-lg font-bold">Editar cuenta administrativa</h2><button type="button" onclick="closeAdminModal('edit-admin-modal')"><span class="material-symbols-outlined">close</span></button></div>
        <form asp-action="Edit" method="post" class="grid gap-4" onsubmit="return validateAdminDocument(this)">
            @Html.AntiForgeryToken()<input type="hidden" name="Id" id="editAdminId" />
            <label class="text-sm font-semibold">Documento<input name="Document" id="editAdminDocument" required maxlength="50" inputmode="numeric" pattern="[0-9]+" title="Ingrese únicamente números" class="admin-document mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" oninput="this.value = this.value.replace(/[^0-9]/g, ''); this.setCustomValidity(this.value.trim() ? '' : 'El documento es obligatorio.');" /></label>
            <label class="text-sm font-semibold">Nombre completo<input name="FullName" id="editAdminName" required minlength="3" maxlength="150" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü]+(?:[ '\-][A-Za-zÁÉÍÓÚáéíóúÑñÜü]+)*" title="Use solo letras, espacios, guiones o apóstrofes" class="person-name mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" oninput="if (this.value.trim().length < 3) this.setCustomValidity('El nombre debe tener al menos 3 caracteres.'); else this.setCustomValidity('');" /></label>
            <label class="text-sm font-semibold">Correo de contacto<input name="ContactEmail" id="editAdminEmail" type="email" required maxlength="150" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <label class="text-sm font-semibold">Rol<select name="RoleName" id="editAdminRole" required class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg"><option value="ADMIN">ADMIN</option><option value="SUPER_ADMIN">SUPER_ADMIN</option></select></label>
            <label class="text-sm font-semibold">Cargo institucional<input name="PositionTitle" id="editAdminTitle" maxlength="100" class="mt-1 w-full px-3 py-2.5 border border-outline-variant rounded-lg" /></label>
            <button type="submit" class="bg-primary text-on-primary rounded-lg px-4 py-2.5 font-semibold transition-colors hover:bg-primary/90 hover:shadow-md">Guardar cambios</button>
        </form>
        <form asp-action="Delete" method="post" class="mt-3 border-t border-border-subtle pt-3" onsubmit="return confirm('¿Eliminar lógicamente esta cuenta?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteAdminId" />
            <button type="submit" class="text-rose-700 font-semibold transition-colors hover:text-rose-900 hover:underline">Eliminar cuenta lógicamente</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Los modales se comparten entre filas: el formulario de edición se precarga con la cuenta seleccionada.
    function openAdminModal(id) { const modal = document.getElementById(id); modal.classList.remove('hidden'); modal.classList.add('flex'); modal.querySelector('input:not([type="hidden"])')?.focus(); }
    function closeAdminModal(id) { const modal = document.getElementById(id); modal.classList.add('hidden'); modal.classList.remove('flex'); }
    function closeOnBackdrop(event, modal) { if (event.target === modal) closeAdminModal(modal.id); }
    // Reemplaza los mensajes nativos del navegador para que la validación sea consistente en español.
    function setSpanishValidationMessage(input) {
        if (input.validity.valueMissing) input.setCustomValidity('Este campo es obligatorio.');
        else if (input.validity.typeMismatch) input.setCustomValidity('Ingrese un correo electrónico válido.');
        else if (input.validity.tooShort) input.setCustomValidity('Debe tener al menos 3 caracteres.');
        else if (input.validity.patternMismatch) input.setCustomValidity(input.classList.contains('person-name') ? 'El nombre solo puede contener letras, espacios, guiones o apóstrofes.' : 'El documento solo debe contener números.');
        else input.setCustomValidity('');
    }
    // El navegador filtra documentos y nombres; el servidor repite ambas validaciones.
    function validateAdminDocument(form) { const input = form.querySelector('.admin-document'); if (!/^[0-9]+$/.test(input.value.trim())) { input.setCustomValidity('El documento solo debe contener números.'); input.reportValidity(); return false; } input.setCustomValidity(''); return true; }
    function openEditAdmin(id, documentValue, name, email, role, title) { document.getElementById('editAdminId').value = id; document.getElementById('deleteAdminId').value = id; document.getElementById('editAdminDocument').value = documentValue; document.getElementById('editAdminName').value = name; document.getElementById('editAdminEmail').value = email; document.getElementById('editAdminRole').value = role; document.getElementById('editAdminTitle').value = title; openAdminModal('edit-admin-modal'); }
    document.querySelectorAll('#create-admin-modal form, #edit-admin-modal form').forEach(form => {
        form.querySelectorAll('input, select').forEach(input => {
            input.addEventListener('invalid', () => setSpanishValidationMessage(input));
            input.addEventListener('input', () => {
                input.setCustomValidity('');
                if (input.classList.contains('admin-document')) {
                    input.value = input.value.replace(/[^0-9]/g, '');
                }
                if (input.classList.contains('person-name') && input.value.trim().length < 3) {
                    input.setCustomValidity('El nombre debe tener al menos 3 caracteres.');
                }
            });
        });
    });
</script>
}
