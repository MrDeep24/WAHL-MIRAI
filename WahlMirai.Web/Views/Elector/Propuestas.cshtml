@model dynamic
@{
    ViewData["Title"] = "Consulta de Propuestas";
    Layout = "_ElectorLayout";
    var ev = ViewBag.Event as WahlMirai.Web.Models.VotingEvent;
    var candidates = ViewBag.Candidates as List<WahlMirai.Web.Models.Candidate>;
}

@functions {
    string ResolveFileUrl(string? url, string fallback)
    {
        if (string.IsNullOrWhiteSpace(url)) return fallback;
        if (url.EndsWith(".enc", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/uploads/"))
            return $"/Media/Serve?path={Uri.EscapeDataString(url)}";
        return url;
    }
}

<div class="max-w-5xl mx-auto fade-in">
    <!-- Navegación superior -->
    <div class="flex items-center justify-between gap-3 mb-6">
        <div class="flex items-center gap-3 flex-1 min-w-0">
            <a href="/Elector/Dashboard" class="w-10 h-10 min-h-[44px] min-w-[44px] rounded-full hover:bg-surface-container flex items-center justify-center text-on-surface-variant transition-colors" title="Volver al Dashboard">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                    @if (ev?.Status == "ACTIVA")
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-status-active/15 text-status-active border border-status-active/30">
                            <span class="material-symbols-outlined text-xs">how_to_vote</span> Votación en Curso
                        </span>
                        <span class="text-xs text-slate-600 dark:text-slate-300">
                            Cierre: <strong>@ev?.VotingEndDate.ToString("dd/MM/yyyy") @ev?.VotingEndTime.ToString("HH:mm")</strong>
                        </span>
                    }
                    else if (ev?.Status == "FINALIZADA")
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-500/15 text-slate-600 dark:text-slate-300 border border-slate-500/30">
                            <span class="material-symbols-outlined text-xs">flag</span> Proceso Finalizado
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-tertiary/15 text-primary dark:text-blue-400 border border-primary/20">
                            <span class="material-symbols-outlined text-xs">campaign</span> Consulta de Propuestas
                        </span>
                        <span class="text-xs text-slate-600 dark:text-slate-300">
                            Votación inicia el <strong>@ev?.VotingStartDate.ToString("dd/MM/yyyy")</strong> a las <strong>@ev?.VotingStartTime.ToString("HH:mm")</strong>
                        </span>
                    }
                </div>
                <h1 class="text-2xl md:text-3xl font-bold truncate text-on-surface dark:text-slate-50">@ev?.Title</h1>
            </div>
        </div>

        @if (ev?.Status == "ACTIVA")
        {
            <a href="/Elector/Votar/@ev.Id" class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary text-on-primary rounded-xl font-bold text-sm hover:bg-primary/90 transition-all shadow-md shrink-0">
                <span class="material-symbols-outlined text-base">how_to_vote</span> Ir a Votar
            </a>
        }
    </div>

    <!-- Banner informativo -->
    <div class="bg-surface-container-low dark:bg-slate-800/80 border border-border-subtle dark:border-slate-700/60 rounded-2xl p-5 mb-8 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary dark:text-blue-400 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-2xl">menu_book</span>
        </div>
        <div class="flex-1">
            <h2 class="font-bold text-base text-on-surface dark:text-slate-100">Conoce a los candidatos y sus planes de gobierno</h2>
            <p class="text-sm text-slate-600 dark:text-slate-300 mt-0.5">
                Analiza detalladamente las propuestas y el documento oficial de plan de gobierno de cada aspirante para tomar una decisión informada.
            </p>
        </div>
    </div>

    <!-- Grilla de Candidatos y Propuestas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @if (candidates != null && candidates.Any())
        {
            for (int i = 0; i < candidates.Count; i++)
            {
                var c = candidates[i];
                var photoSrc = ResolveFileUrl(c.PhotoUrl, "/images/default-avatar.png");
                var planDocUrl = ResolveFileUrl(c.GovernmentPlanUrl, "");

                <div class="bg-surface-container-lowest dark:bg-slate-900 rounded-2xl border border-border-subtle dark:border-slate-800 shadow-card overflow-hidden flex flex-col">
                    <!-- Cabecera del Candidato -->
                    <div class="p-6 border-b border-border-subtle dark:border-slate-800 bg-surface-container-lowest dark:bg-slate-900 flex items-center gap-4">
                        @if (c.IsBlankVote)
                        {
                            <div class="w-16 h-16 rounded-full bg-surface-container dark:bg-slate-800 flex items-center justify-center text-outline dark:text-slate-400 shrink-0">
                                <span class="material-symbols-outlined text-3xl">front_hand</span>
                            </div>
                        }
                        else
                        {
                            <img src="@photoSrc" alt="@c.Name" class="w-16 h-16 rounded-full object-cover border-2 border-primary/30 dark:border-blue-400/40 bg-surface-container dark:bg-slate-800 shrink-0" onerror="this.src='/images/default-avatar.png'" />
                        }
                        <div class="flex-1 min-w-0">
                            <span class="inline-block text-xs font-bold uppercase tracking-wider text-primary dark:text-blue-400 mb-1">
                                @(c.IsBlankVote ? "Opción Especial" : $"Candidato {(i < 9 ? $"0{i+1}" : $"{i+1}")}")
                            </span>
                            <h3 class="text-lg font-bold text-on-surface dark:text-slate-50 truncate">@c.Name</h3>
                            <p class="text-xs text-slate-600 dark:text-slate-300">
                                @(c.IsBlankVote ? "Voto en Blanco institucional" : (c.Voter?.Grade?.Name ?? "Estudiante"))
                            </p>
                        </div>
                    </div>

                    <!-- Contenido y Propuestas -->
                    <div class="p-6 flex-1 flex flex-col gap-4">
                        @if (c.IsBlankVote)
                        {
                            <p class="text-sm text-slate-600 dark:text-slate-300 italic">
                                El voto en blanco es una opción legítima para electores que no se sienten identificados con ninguna de las candidaturas presentadas.
                            </p>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(c.Slogan))
                            {
                                <div class="bg-surface-container-low dark:bg-slate-800/70 px-4 py-3 rounded-xl border border-border-subtle dark:border-slate-700/60">
                                    <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-300 tracking-wider block mb-1">Lema de Campaña</span>
                                    <p class="text-sm font-medium italic text-on-surface dark:text-slate-100">“@c.Slogan”</p>
                                </div>
                            }

                            <div>
                                <span class="text-xs font-bold uppercase text-slate-600 dark:text-slate-300 tracking-wider block mb-2">Propuestas Registradas</span>
                                @if (c.CandidateProposals != null && c.CandidateProposals.Any())
                                {
                                    <ul class="space-y-2.5">
                                        @foreach (var prop in c.CandidateProposals)
                                        {
                                            <li class="flex items-start gap-2.5 text-sm text-on-surface dark:text-slate-100">
                                                <span class="material-symbols-outlined text-status-active text-base mt-0.5 shrink-0">check_circle</span>
                                                <span class="leading-snug">@prop.Content</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400 italic">No se registraron propuestas adicionales.</p>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(c.GovernmentPlanUrl))
                            {
                                <div class="mt-auto pt-4 border-t border-border-subtle dark:border-slate-800">
                                    <div class="bg-primary/5 dark:bg-blue-500/10 border border-primary/20 dark:border-blue-400/30 p-4 rounded-xl flex items-center justify-between gap-3">
                                        <div class="flex items-center gap-3 min-w-0">
                                            <span class="material-symbols-outlined text-primary dark:text-blue-400 text-2xl shrink-0">description</span>
                                            <div class="min-w-0">
                                                <div class="text-sm font-bold text-on-surface dark:text-slate-100 truncate">Plan de Gobierno Oficial</div>
                                                <div class="text-xs text-slate-600 dark:text-slate-300 truncate">Documento PDF del candidato</div>
                                            </div>
                                        </div>
                                        <button type="button" onclick="openDocumentViewer('@planDocUrl', 'Plan de Gobierno - @c.Name')" class="px-3.5 py-2 bg-primary dark:bg-blue-600 text-white rounded-lg text-xs font-bold flex items-center gap-1.5 hover:bg-primary/90 dark:hover:bg-blue-500 transition-colors shrink-0 shadow-sm cursor-pointer">
                                            <span class="material-symbols-outlined text-sm">visibility</span> Ver Documento
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-2 py-12 text-center text-slate-600 dark:text-slate-300 bg-surface-container-low dark:bg-slate-800/60 rounded-2xl border border-border-subtle dark:border-slate-700">
                <span class="material-symbols-outlined text-5xl mb-2 opacity-50">how_to_reg</span>
                <p class="font-semibold text-base text-on-surface dark:text-slate-100">No hay candidatos aprobados para consulta en este proceso aún.</p>
                <p class="text-xs mt-1 text-slate-500 dark:text-slate-400">Una vez la administración dictamine las postulaciones, podrás revisar aquí sus propuestas.</p>
            </div>
        }
    </div>
</div>
