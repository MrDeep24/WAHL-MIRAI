@model WahlMirai.Web.Services.MyPostulationDto
@{
    Layout = "~/Views/Shared/_ElectorLayout.cshtml";
    ViewData["Title"] = "Estado de Postulación";

    var (badgeBg, badgeText, badgeIcon) = Model.Status switch
    {
        "APROBADO" => ("bg-green-500/10 border-green-500/30 text-green-700 dark:text-green-400", "text-green-700 dark:text-green-400", "check_circle"),
        "RECHAZADO" => ("bg-red-500/10 border-red-500/30 text-red-700 dark:text-red-400", "text-red-700 dark:text-red-400", "cancel"),
        _ => ("bg-amber-500/10 border-amber-500/30 text-amber-700 dark:text-amber-400", "text-amber-700 dark:text-amber-400", "pending")
    };

    var displayStatus = Model.Status == "APROBADO" && Model.ApprovedWithExceptions
        ? "APROBADO CON EXCEPCIÓN"
        : Model.Status;
}

<div class="max-w-2xl mx-auto space-y-6">

    @* ── Back ── *@
    <div class="flex items-center gap-2">
        <a href="/Candidacy" class="p-2 rounded-xl hover:bg-surface-container-low text-on-surface-variant transition-colors">
            <span class="material-symbols-outlined text-xl">arrow_back</span>
        </a>
        <h1 class="text-xl font-bold text-on-surface">Estado de Postulación</h1>
    </div>

    @* ── Estado Badge ── *@
    <div class="bg-surface-container rounded-2xl border border-border-subtle p-6 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <p class="text-lg font-bold text-on-surface">@Model.EventTitle</p>
                <p class="text-sm text-on-surface-variant">Cargo: <span class="font-medium">@Model.PositionName</span></p>
            </div>
            <span class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-semibold border @badgeBg">
                <span class="material-symbols-outlined text-base @badgeText">@badgeIcon</span>
                @displayStatus
            </span>
        </div>

        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-border-subtle text-sm">
            <div>
                <p class="text-xs text-on-surface-variant">Fecha de inscripción</p>
                <p class="font-medium text-on-surface mt-0.5">@Model.EnrolledAt.ToString("dd MMM yyyy HH:mm")</p>
            </div>
            @if (Model.ReviewedAt != null)
            {
                <div>
                    <p class="text-xs text-on-surface-variant">Fecha de revisión</p>
                    <p class="font-medium text-on-surface mt-0.5">@Model.ReviewedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            }
        </div>
    </div>

    @* ── Mensajes del Administrador ── *@
    @if (Model.Status == "PENDIENTE")
    {
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20">
            <span class="material-symbols-outlined text-amber-600 shrink-0 mt-0.5">hourglass_top</span>
            <div>
                <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">Tu postulación está siendo revisada</p>
                <p class="text-xs text-amber-700 dark:text-amber-400 mt-1 opacity-80">
                    El equipo administrativo está evaluando tu documentación. Recibirás una notificación cuando se emita el dictamen.
                    Tu nombre no aparecerá en el tarjetón de votación hasta recibir aprobación.
                </p>
            </div>
        </div>
    }
    else if (Model.Status == "APROBADO" && !Model.ApprovedWithExceptions)
    {
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-green-500/10 border border-green-500/20">
            <span class="material-symbols-outlined text-green-600 shrink-0 mt-0.5">check_circle</span>
            <div>
                <p class="text-sm font-semibold text-green-700 dark:text-green-400">¡Tu candidatura fue aprobada!</p>
                <p class="text-xs text-green-700 dark:text-green-400 mt-1 opacity-80">
                    Tu nombre ya está disponible en el tarjetón de votación. ¡Mucho éxito en el proceso electoral!
                </p>
            </div>
        </div>
    }
    else if (Model.Status == "APROBADO" && Model.ApprovedWithExceptions)
    {
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-green-500/10 border border-green-500/20">
            <span class="material-symbols-outlined text-green-600 shrink-0 mt-0.5">check_circle</span>
            <div>
                <p class="text-sm font-semibold text-green-700 dark:text-green-400">¡Tu candidatura fue aprobada con excepción!</p>
                <p class="text-xs text-green-700 dark:text-green-400 mt-1 opacity-80">
                    Tu nombre ya está disponible en el tarjetón. El administrador aprobó tu candidatura por excepción
                    sin que todos los documentos requeridos estuvieran completos.
                </p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.ExceptionsDetail))
        {
            <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20">
                <p class="text-xs font-semibold text-amber-700 dark:text-amber-400 mb-1 flex items-center gap-1">
                    <span class="material-symbols-outlined text-base">note</span>
                    Constancia de Excepción registrada por el Administrador
                </p>
                <p class="text-sm text-amber-700 dark:text-amber-400 leading-relaxed">@Model.ExceptionsDetail</p>
            </div>
        }
    }
    else if (Model.Status == "RECHAZADO")
    {
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-red-500/10 border border-red-500/20">
            <span class="material-symbols-outlined text-red-600 shrink-0 mt-0.5">cancel</span>
            <div>
                <p class="text-sm font-semibold text-red-700 dark:text-red-400">Tu postulación fue rechazada</p>
                <p class="text-xs text-red-700 dark:text-red-400 mt-1 opacity-80">
                    @if (Model.AllowCorrection)
                    {
                        <span>Puedes corregir tu candidatura cargando los documentos faltantes y volver a postularte.</span>
                    }
                    else
                    {
                        <span>Lamentablemente tu candidatura no cumplió con los requisitos establecidos. El rechazo es definitivo.</span>
                    }
                </p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="p-4 rounded-2xl bg-red-500/10 border border-red-500/20">
                <p class="text-xs font-semibold text-red-700 dark:text-red-400 mb-1 flex items-center gap-1">
                    <span class="material-symbols-outlined text-base">feedback</span>
                    Motivo del rechazo
                </p>
                <p class="text-sm text-red-700 dark:text-red-400 leading-relaxed">@Model.RejectionReason</p>
            </div>
        }
    }

    @* ── Acciones ── *@
    <div class="flex gap-3">
        <a href="/Candidacy" class="flex-1 text-center py-2.5 rounded-xl border border-border-subtle text-on-surface-variant text-sm font-medium hover:bg-surface-container-low transition-colors">
            Volver a Mis Candidaturas
        </a>
        @if (Model.Status == "RECHAZADO" && Model.AllowCorrection)
        {
            <a href="/Candidacy/Apply/@Model.EventId"
               class="flex-1 text-center py-2.5 rounded-xl bg-amber-600 text-white text-sm font-semibold hover:bg-amber-700 active:scale-95 transition-all flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-base">edit</span>
                Corregir Postulación
            </a>
        }
        else
        {
            <a href="/Elector/Dashboard" class="flex-1 text-center py-2.5 rounded-xl bg-primary text-on-primary text-sm font-semibold hover:opacity-90 active:scale-95 transition-all">
                Ir al Panel
            </a>
        }
    </div>
</div>
