@model WahlMirai.Web.ViewModels.PagedResult<WahlMirai.Web.Services.VoterDetailDto>
@{
    ViewData["Title"] = "Censo Electoral";
    Layout = "_AdminLayout";
    var grades = ViewBag.Grades as List<WahlMirai.Web.Models.Grade> ?? new List<WahlMirai.Web.Models.Grade>();
    string? currentSearch = ViewBag.Search as string;
    string? currentGrade = ViewBag.Grade as string;
    string? currentStatus = ViewBag.Status as string;
    byte? currentRoleId = ViewBag.RoleId as byte?;
}

<div class="fade-in">
    <!-- Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 flex justify-between items-start gap-3 fade-in">
            <div class="flex gap-2 items-start">
                <span class="material-symbols-outlined text-xl shrink-0 mt-0.5">check_circle</span>
                <div class="text-sm">@Html.Raw(TempData["Success"])</div>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 flex justify-between items-start gap-3 fade-in">
            <div class="flex gap-2 items-start">
                <span class="material-symbols-outlined text-xl shrink-0 mt-0.5">warning</span>
                <div class="text-sm">@Html.Raw(TempData["Warning"])</div>
            </div>
            <button onclick="this.parentElement.remove()" class="text-amber-700 hover:text-amber-900">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 flex justify-between items-start gap-3 fade-in">
            <div class="flex gap-2 items-start">
                <span class="material-symbols-outlined text-xl shrink-0 mt-0.5">error</span>
                <div class="text-sm">@Html.Raw(TempData["Error"])</div>
            </div>
            <button onclick="this.parentElement.remove()" class="text-rose-700 hover:text-rose-900">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }

    <!-- Encabezado y Acciones -->
    <div class="flex justify-between items-start mb-6 flex-wrap gap-3">
        <div>
            <h1 class="text-3xl font-bold mb-1">Gestión del Censo Electoral</h1>
            <p class="text-on-surface-variant">Administra los estudiantes con cuenta activa habilitados para votar. Ningún registro se borra físicamente (RN-6).</p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <a href="/AdminCensus/DescargarPlantillaCsv"
               class="flex items-center gap-2 border border-outline-variant text-on-surface rounded-lg px-3.5 py-2 text-sm font-semibold hover:bg-surface-container-low transition-colors" title="Descargar plantilla CSV">
                <span class="material-symbols-outlined text-base">download</span> Plantilla CSV
            </a>
            <button onclick="document.getElementById('csv-modal').classList.remove('hidden')"
                    class="flex items-center gap-2 border border-outline-variant rounded-lg px-4 py-2 text-sm font-semibold hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-base">upload_file</span> Carga masiva (CSV)
            </button>
            <button onclick="document.getElementById('add-voter-modal').classList.remove('hidden')"
                    class="flex items-center gap-2 bg-surface-container-high text-primary rounded-lg px-4 py-2 text-sm font-semibold hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-base">person_add</span> Nuevo en lista blanca
            </button>
            <button onclick="document.getElementById('promotion-modal').classList.remove('hidden'); fetchPromotionData();"
                    class="flex items-center gap-2 bg-primary text-on-primary rounded-lg px-4 py-2 text-sm font-semibold hover:bg-primary/90 transition-colors">
                <span class="material-symbols-outlined text-base">school</span> Promoción de año
            </button>
        </div>
    </div>

    <!-- Pestañas de Navegación M02 -->
    <div class="flex border-b border-border-subtle mb-6 gap-6">
        <a href="/AdminCensus/PendingWhitelist" class="pb-3 text-sm font-semibold border-b-2 border-transparent text-on-surface-variant hover:text-primary transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">checklist</span>
            Pendientes por Reclamar
        </a>
        <a href="/AdminCensus/Index" class="pb-3 text-sm font-semibold border-b-2 border-primary text-primary flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">how_to_reg</span>
            Censo Activo (Auto-registrados)
            <span class="px-2 py-0.5 text-xs bg-primary/10 rounded-full font-bold">@Model.TotalCount</span>
        </a>
    </div>

    <!-- Buscador y Filtros Server-Side -->
    <form method="get" action="/AdminCensus/Index" class="flex gap-3 mb-4 flex-wrap">
        <div class="relative flex-1 min-w-[240px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input type="text" name="search" value="@currentSearch"
                   placeholder="Buscar por nombre o correo..."
                   class="w-full pl-10 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary">
        </div>
        <select name="grade" onchange="this.form.submit()" class="px-3 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary min-w-[140px]">
            <option value="">Todos los grados</option>
            @foreach (var g in grades)
            {
                <option value="@g.Name" selected="@(currentGrade == g.Name)">@g.Name</option>
            }
        </select>
        <select name="status" onchange="this.form.submit()" class="px-3 py-2.5 bg-surface-container-lowest border border-outline-variant rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary min-w-[140px]">
            <option value="">Todos los estados</option>
            <option value="ACTIVO" selected="@(currentStatus == "ACTIVO")">Activo</option>
            <option value="ELIMINADO" selected="@(currentStatus == "ELIMINADO")">Eliminado</option>
            <option value="EGRESADO" selected="@(currentStatus == "EGRESADO")">Egresado</option>
        </select>
        <button type="submit" class="px-4 py-2.5 bg-surface-container-high text-primary font-semibold rounded-lg text-sm hover:bg-surface-container transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-base">filter_alt</span> Filtrar
        </button>
        @if (!string.IsNullOrWhiteSpace(currentSearch) || !string.IsNullOrWhiteSpace(currentGrade) || !string.IsNullOrWhiteSpace(currentStatus))
        {
            <a href="/AdminCensus/Index" class="px-3 py-2.5 text-on-surface-variant border border-outline-variant rounded-lg text-sm hover:bg-surface-container-low transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-base">clear</span> Limpiar
            </a>
        }
    </form>

    <!-- Tabla Responsive Única con Display Utilities y ARIA -->
    <div class="md:bg-surface-container-lowest md:rounded-xl md:border md:border-border-subtle md:shadow-card md:overflow-hidden">
        <table class="w-full text-sm block md:table" role="table" id="censusTable" aria-label="Censo electoral de estudiantes">
            <thead class="hidden md:table-header-group" role="rowgroup">
                <tr class="text-left text-xs uppercase text-on-surface-variant bg-surface-container-low" role="row">
                    <th class="px-5 py-3" role="columnheader">Nombre</th>
                    <th class="px-5 py-3" role="columnheader">Documento</th>
                    <th class="px-5 py-3" role="columnheader">Correo / Grado</th>
                    <th class="px-5 py-3" role="columnheader">Estado</th>
                    <th class="px-5 py-3 text-right" role="columnheader">Acciones</th>
                </tr>
            </thead>
            <tbody class="block md:table-row-group" role="rowgroup">
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var v in Model.Items)
                    {
                        var isEliminado = v.Status == "ELIMINADO";
                        <tr class="block md:table-row border border-border-subtle md:border-x-0 md:border-t md:border-b-0 rounded-xl md:rounded-none mb-4 md:mb-0 p-4 md:p-0 bg-surface-container-lowest md:bg-transparent shadow-sm md:shadow-none voter-row @(isEliminado ? "opacity-55" : "") hover:bg-surface-container-low/40 transition-colors"
                            role="row">
                            <td class="block md:table-cell px-0 md:px-5 py-2 md:py-3 font-medium name-cell flex justify-between md:justify-start items-center border-b border-border-subtle md:border-0" role="cell">
                                <span class="font-semibold text-xs text-on-surface-variant md:hidden uppercase" aria-hidden="true">Nombre:</span>
                                <div>
                                    <span class="font-semibold text-on-surface">@v.FullName</span>
                                    @if(v.ExcluirDePromocion)
                                    {
                                        <span class="ml-1.5 px-2 py-0.5 text-[10px] bg-amber-500/10 text-amber-700 rounded font-semibold" title="Marcado como repitente (se omitirá en la promoción masiva)">Repitente</span>
                                    }
                                </div>
                            </td>
                            <td class="block md:table-cell px-0 md:px-5 py-2 md:py-3 font-mono text-xs text-on-surface-variant flex justify-between md:justify-start items-center border-b border-border-subtle md:border-0" role="cell">
                                <span class="font-semibold text-xs text-on-surface-variant md:hidden uppercase" aria-hidden="true">Documento:</span>
                                <span>@v.Document</span>
                            </td>
                            <td class="block md:table-cell px-0 md:px-5 py-2 md:py-3 grade-cell flex justify-between md:justify-start items-center border-b border-border-subtle md:border-0" role="cell">
                                <span class="font-semibold text-xs text-on-surface-variant md:hidden uppercase" aria-hidden="true">Contacto / Grado:</span>
                                <div class="text-xs">
                                    <div class="text-on-surface">@v.ContactEmail</div>
                                    <div class="text-on-surface-variant text-[11px]">Grado: <strong>@(v.GradeName ?? "N/A (Admin)")</strong> | Rol: @v.RoleName</div>
                                </div>
                            </td>
                            <td class="block md:table-cell px-0 md:px-5 py-2 md:py-3 flex justify-between md:justify-start items-center border-b border-border-subtle md:border-0" role="cell">
                                <span class="font-semibold text-xs text-on-surface-variant md:hidden uppercase" aria-hidden="true">Estado:</span>
                                <div>
                                    @if (v.Status == "ACTIVO")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 border border-emerald-500/20">Activo</span>
                                    }
                                    else if (v.Status == "ELIMINADO")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-700 border border-rose-500/20">Eliminado</span>
                                    }
                                    else if (v.Status == "EGRESADO")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-700 border border-blue-500/20">Egresado</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-outline-variant/30 text-on-surface-variant">@v.Status</span>
                                    }
                                </div>
                            </td>
                            <td class="block md:table-cell px-0 md:px-5 py-3 md:py-3 text-right flex justify-end items-center gap-2 md:gap-3 mt-2 md:mt-0 border-t border-border-subtle md:border-0 pt-4 md:pt-3" role="cell">
                                <button title="Ver detalle completo" onclick="openDetailModal(@v.Id)" class="text-on-surface-variant hover:text-primary min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg bg-surface-container-low hover:bg-surface-container transition-colors">
                                    <span class="material-symbols-outlined text-base">visibility</span>
                                </button>
                                @if (isEliminado)
                                {
                                    <form method="post" action="/AdminCensus/RestoreVoter" class="inline" onsubmit="return confirm('¿Restaurar este elector a estado ACTIVO?');">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button title="Restaurar Elector" class="text-primary hover:text-primary/80 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg bg-surface-container-low hover:bg-primary/10 transition-colors">
                                            <span class="material-symbols-outlined text-base">restore</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button title="Editar Elector" onclick="openEditModal(@v.Id)" class="text-primary hover:text-primary/80 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg bg-surface-container-low hover:bg-primary/10 transition-colors">
                                        <span class="material-symbols-outlined text-base">edit</span>
                                    </button>
                                    <form method="post" action="/AdminCensus/ResetPassword" class="inline" onsubmit="return confirm('¿Reasignar contraseña? Se generará una nueva clave aleatoria y se enviará al correo de contacto del elector.');">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button title="Resetear Clave" class="text-amber-600 hover:text-amber-700 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg bg-amber-500/10 transition-colors">
                                            <span class="material-symbols-outlined text-base">lock_reset</span>
                                        </button>
                                    </form>
                                    <form method="post" action="/AdminCensus/DeleteVoter" class="inline" onsubmit="return confirm('¿Confirma la eliminación LÓGICA de este elector? El registro se conservará inactivo.');">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button title="Eliminación Lógica" class="text-rose-600 hover:text-rose-700 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg bg-rose-500/10 transition-colors">
                                            <span class="material-symbols-outlined text-base">delete</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="block md:table-row" role="row">
                        <td colspan="5" class="block md:table-cell px-5 py-12 text-center text-on-surface-variant bg-surface-container-lowest md:bg-transparent rounded-xl md:rounded-none border border-border-subtle md:border-0 shadow-card md:shadow-none" role="cell">
                            <span class="material-symbols-outlined text-4xl mb-2 text-outline block">groups</span>
                            No se encontraron electores activos que coincidan con los filtros aplicados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Controles de Paginación Server-Side -->
        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="px-5 py-4 bg-surface-container-low/40 border-t border-border-subtle flex flex-col sm:flex-row justify-between items-center gap-3 text-sm">
                <div class="text-on-surface-variant text-xs">
                    Mostrando <strong>@Model.StartItemIndex</strong> a <strong>@Model.EndItemIndex</strong> de <strong>@Model.TotalCount</strong> electores
                </div>
                <div class="flex items-center gap-1">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", new { search = currentSearch, grade = currentGrade, status = currentStatus, roleId = currentRoleId, pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize })"
                           class="px-3 py-1.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-xs font-semibold hover:bg-surface-container transition-colors flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">chevron_left</span> Anterior
                        </a>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-lg border border-outline-variant/30 text-outline text-xs font-semibold cursor-not-allowed opacity-50 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">chevron_left</span> Anterior
                        </span>
                    }

                    <span class="px-3 py-1.5 text-xs text-on-surface-variant font-medium">
                        Página @Model.PageNumber de @Model.TotalPages
                    </span>

                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", new { search = currentSearch, grade = currentGrade, status = currentStatus, roleId = currentRoleId, pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize })"
                           class="px-3 py-1.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-xs font-semibold hover:bg-surface-container transition-colors flex items-center gap-1">
                            Siguiente <span class="material-symbols-outlined text-sm">chevron_right</span>
                        </a>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-lg border border-outline-variant/30 text-outline text-xs font-semibold cursor-not-allowed opacity-50 flex items-center gap-1">
                            Siguiente <span class="material-symbols-outlined text-sm">chevron_right</span>
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ── Voter Modal (Crear en Lista Blanca) ── -->
    <div id="add-voter-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
         onclick="if(event.target===this) this.classList.add('hidden')">
        <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-md w-full p-5 md:p-6 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-lg font-bold">Agregar Estudiante a Lista Blanca</h3>
                <button onclick="document.getElementById('add-voter-modal').classList.add('hidden')">
                    <span class="material-symbols-outlined hover:text-error transition-colors">close</span>
                </button>
            </div>
            <form action="/AdminCensus/AddToWhitelist" method="post" class="flex flex-col gap-4">
                <input type="hidden" name="returnUrl" value="/AdminCensus/Index" />
                <div>
                    <label class="text-sm font-semibold block mb-1">Número de Documento <span class="text-error">*</span></label>
                    <input name="document" required pattern="\d+" title="Ingrese únicamente dígitos numéricos" placeholder="Ej. 1020304050"
                           class="w-full px-3 py-2 border border-outline-variant rounded-lg font-mono text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    <p class="text-xs text-on-surface-variant mt-1">El estudiante usará este documento para su auto-registro (RN-1).</p>
                </div>
                <div>
                    <label class="text-sm font-semibold block mb-1">Nombre Completo <span class="text-error">*</span></label>
                    <input name="fullName" required minlength="3" maxlength="150" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü]+(?:[ '\-][A-Za-zÁÉÍÓÚáéíóúÑñÜü]+)*" title="Use solo letras, espacios, guiones o apóstrofes" placeholder="Ej. Juan Pérez"
                           class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                </div>
                <div>
                    <label class="text-sm font-semibold block mb-1">Grado Escolar <span class="text-error">*</span></label>
                    <select name="gradeId" required class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                        @foreach (var g in grades)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </div>
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="excluirDePromocion" value="true">
                    Excluir de la promoción automática (Repitente)
                </label>
                <div class="text-xs text-on-surface-variant bg-surface-container-low rounded-lg p-3">
                    <span class="font-semibold text-primary">Flujo M01-00 / M02:</span> El estudiante completará su propio auto-registro, eligiendo su correo y contraseña personal.
                </div>
                <button type="submit"
                        class="w-full bg-primary text-on-primary font-semibold py-2.5 rounded-lg mt-2 hover:bg-primary/90 transition-colors">
                    Guardar en Lista Blanca
                </button>
            </form>
        </div>
    </div>

    <!-- ── Edit Voter Modal (Editar Elector Activo) ── -->
    <div id="edit-voter-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
         onclick="if(event.target===this) this.classList.add('hidden')">
        <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-md w-full p-5 md:p-6 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-5">
                <h3 class="text-lg font-bold">Modificar Elector</h3>
                <button onclick="document.getElementById('edit-voter-modal').classList.add('hidden')">
                    <span class="material-symbols-outlined hover:text-error transition-colors">close</span>
                </button>
            </div>
            <form action="/AdminCensus/EditVoter" method="post" class="flex flex-col gap-4">
                <input type="hidden" name="id" id="editVoterId" />
                <div>
                    <label class="text-sm font-semibold block mb-1">Documento (Sólo Lectura)</label>
                    <input id="editDocument" readonly class="w-full px-3 py-2 bg-surface-container-low border border-outline-variant rounded-lg font-mono text-sm text-on-surface-variant cursor-not-allowed">
                </div>
                <div>
                    <label class="text-sm font-semibold block mb-1">Nombre Completo <span class="text-error">*</span></label>
                    <input name="fullName" id="editFullName" required minlength="3" maxlength="150"
                           class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary">
                </div>
                <div>
                    <label class="text-sm font-semibold block mb-1">Correo de Contacto <span class="text-error">*</span></label>
                    <input type="email" name="contactEmail" id="editContactEmail" required
                           class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary">
                </div>
                <input type="hidden" name="roleId" id="editRoleId" value="@Roles.Elector" />
                <div id="editGradeContainer">
                    <label class="text-sm font-semibold block mb-1">Grado <span class="text-error">*</span></label>
                    <select name="gradeId" id="editGradeId" class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary">
                        @foreach (var g in grades)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="text-sm font-semibold block mb-1">Estado de Cuenta <span class="text-error">*</span></label>
                    <select name="status" id="editStatus" required class="w-full px-3 py-2 border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary">
                        <option value="ACTIVO">ACTIVO</option>
                        <option value="ELIMINADO">ELIMINADO (Lógico)</option>
                        <option value="EGRESADO">EGRESADO</option>
                    </select>
                </div>
                <label id="editExcluirLabel" class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="excluirDePromocion" id="editExcluirDePromocion" value="true">
                    Excluir de promoción (Repitente)
                </label>
                <button type="submit" class="w-full bg-primary text-on-primary font-semibold py-2.5 rounded-lg mt-2 hover:bg-primary/90 transition-colors">
                    Guardar Cambios
                </button>
            </form>
        </div>
    </div>

    <!-- ── Detail Voter Modal (Ver Detalle) ── -->
    <div id="voter-detail-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
         onclick="if(event.target===this) this.classList.add('hidden')">
        <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-md w-full p-5 md:p-6 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4 border-b border-outline-variant/30 pb-3">
                <h3 class="text-lg font-bold">Detalle del Registro</h3>
                <button onclick="document.getElementById('voter-detail-modal').classList.add('hidden')">
                    <span class="material-symbols-outlined hover:text-error transition-colors">close</span>
                </button>
            </div>
            <div id="detailContent" class="space-y-3 text-sm">
                <p class="text-center text-on-surface-variant">Cargando detalles del elector...</p>
            </div>
            <div class="mt-5 text-right">
                <button onclick="document.getElementById('voter-detail-modal').classList.add('hidden')" class="px-4 py-2 border border-outline-variant rounded-lg font-semibold text-xs hover:bg-surface-container-low">
                    Cerrar
                </button>
            </div>
        </div>
    </div>

    <!-- ── CSV Modal ── -->
    <div id="csv-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
         onclick="if(event.target===this) this.classList.add('hidden')">
        <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-md w-full p-5 md:p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold">Carga masiva a Lista Blanca (CSV)</h3>
                <button onclick="document.getElementById('csv-modal').classList.add('hidden')">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <p class="text-sm text-on-surface-variant mb-3">
                Formato esperado: <span class="font-mono text-xs bg-surface-container-low px-1.5 py-0.5 rounded">documento,nombre,grado_id,excluir_promocion</span>
            </p>
            <form action="/AdminCensus/CargaCsv" method="post" enctype="multipart/form-data">
                <input type="hidden" name="returnUrl" value="/AdminCensus/Index" />
                <div class="border-2 border-dashed border-outline-variant rounded-lg p-6 text-center text-on-surface-variant mb-4">
                    <span class="material-symbols-outlined text-4xl mb-2 text-primary">upload_file</span>
                    <div class="mt-2">
                        <input type="file" name="csvFile" accept=".csv" required class="text-sm w-full" />
                    </div>
                </div>
                <div class="flex justify-between items-center text-xs text-on-surface-variant mb-4">
                    <span>Transacción atómica segura.</span>
                    <a href="/AdminCensus/DescargarPlantillaCsv" class="text-primary font-semibold hover:underline flex items-center gap-1">
                        <span class="material-symbols-outlined text-xs">download</span> Descargar Plantilla
                    </a>
                </div>
                <button type="submit" class="w-full bg-primary text-on-primary font-semibold py-2.5 rounded-lg hover:bg-primary/90 transition-colors">
                    Procesar e Importar Archivo
                </button>
            </form>
        </div>
    </div>

    <!-- ── Promotion Modal ── -->
    <div id="promotion-modal" class="fixed inset-0 bg-inverse-surface/60 flex items-end md:items-center justify-center p-0 md:p-6 z-40 fade-in hidden"
         onclick="if(event.target===this) this.classList.add('hidden')">
        <div class="bg-surface-container-lowest rounded-t-2xl md:rounded-xl shadow-card max-w-lg w-full p-5 md:p-6 max-h-[90vh] overflow-y-auto" id="promotion-content">
            <p class="text-center text-on-surface-variant">Cargando datos de promoción...</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openDetailModal(id) {
            document.getElementById('voter-detail-modal').classList.remove('hidden');
            const container = document.getElementById('detailContent');
            container.innerHTML = '<p class="text-center text-on-surface-variant">Cargando información detallada...</p>';

            try {
                const res = await fetch(`/AdminCensus/GetVoterDetails/${id}`);
                if (!res.ok) throw new Error("No se pudo obtener el detalle.");
                const data = await res.json();

                container.innerHTML = `
                    <div class="space-y-2">
                        <div><strong class="text-on-surface-variant">ID Registro:</strong> ${data.id}</div>
                        <div><strong class="text-on-surface-variant">Documento:</strong> <span class="font-mono bg-surface-container-low px-1.5 py-0.5 rounded">${data.document}</span></div>
                        <div><strong class="text-on-surface-variant">Nombre Completo:</strong> ${data.fullName}</div>
                        <div><strong class="text-on-surface-variant">Correo de Contacto:</strong> ${data.contactEmail}</div>
                        <div><strong class="text-on-surface-variant">Rol:</strong> ${data.roleName}</div>
                        <div><strong class="text-on-surface-variant">Grado Escolar:</strong> ${data.gradeName || 'N/A'}</div>
                        <div><strong class="text-on-surface-variant">Estado:</strong> <span class="font-semibold text-primary">${data.status}</span></div>
                        <div><strong class="text-on-surface-variant">Exclusión de Promoción:</strong> ${data.excluirDePromocion ? 'SÍ (Repitente)' : 'NO'}</div>
                        <div><strong class="text-on-surface-variant">Fecha de Registro:</strong> ${new Date(data.registeredAt).toLocaleString()}</div>
                        ${data.updatedAt ? `<div><strong class="text-on-surface-variant">Última Modificación:</strong> ${new Date(data.updatedAt).toLocaleString()}</div>` : ''}
                        ${data.deletedAt ? `<div class="text-rose-600"><strong class="text-rose-700">Fecha Eliminación Lógica:</strong> ${new Date(data.deletedAt).toLocaleString()}</div>` : ''}
                    </div>
                `;
            } catch (err) {
                container.innerHTML = `<p class="text-rose-600 text-center">${err.message}</p>`;
            }
        }

        async function openEditModal(id) {
            try {
                const res = await fetch(`/AdminCensus/GetVoterDetails/${id}`);
                if (!res.ok) throw new Error("No se pudo consultar el registro.");
                const data = await res.json();

                document.getElementById('editVoterId').value = data.id;
                document.getElementById('editDocument').value = data.document;
                document.getElementById('editFullName').value = data.fullName;
                document.getElementById('editContactEmail').value = data.contactEmail;
                document.getElementById('editRoleId').value = data.roleId;
                document.getElementById('editStatus').value = data.status;
                document.getElementById('editExcluirDePromocion').checked = data.excluirDePromocion;

                if (data.gradeId) {
                    document.getElementById('editGradeId').value = data.gradeId;
                }

                document.getElementById('edit-voter-modal').classList.remove('hidden');
            } catch (err) {
                alert("Error al cargar el elector: " + err.message);
            }
        }

        async function fetchPromotionData() {
            try {
                const response = await fetch('/AdminCensus/PromotionPreview');
                document.getElementById('promotion-content').innerHTML = await response.text();
            } catch (err) {
                document.getElementById('promotion-content').innerHTML = "Error al cargar la previsualización.";
            }
        }
    </script>
}
