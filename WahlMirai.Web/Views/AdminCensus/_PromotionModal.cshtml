@model WahlMirai.Web.Services.PromotionPreview

<div class="flex justify-between items-center mb-4">
    <div>
        <h3 class="text-lg font-bold">Promoción Automática de Año Lectivo (@Model.CurrentYear)</h3>
        <p class="text-xs text-on-surface-variant">Previsualización de avance de grado escolar y graduación</p>
    </div>
    <button onclick="document.getElementById('promotion-modal').classList.add('hidden')" class="p-1 hover:bg-surface-container rounded-lg">
        <span class="material-symbols-outlined">close</span>
    </button>
</div>

@if (Model.HasRunThisYear)
{
    <div class="bg-amber-500/10 border border-amber-500/30 text-amber-600 rounded-lg p-3 text-xs mb-4 flex gap-2 items-center">
        <span class="material-symbols-outlined text-lg shrink-0">warning</span>
        <div>
            <strong>¡Atención!</strong> La promoción ya fue ejecutada anteriormente para el año lectivo <strong>@Model.CurrentYear</strong>
            @(Model.PromotionExecutedAt.HasValue ? $"({Model.PromotionExecutedAt.Value.ToString("dd/MM/yyyy HH:mm")})" : "").
            Se requerirá forzar la re-promoción.
        </div>
    </div>
}

<div class="grid grid-cols-3 gap-3 text-center mb-4">
    <div class="bg-surface-container-low rounded-lg p-3 border border-outline-variant/30">
        <p class="text-2xl font-bold text-primary">@Model.EligibleCount</p>
        <p class="text-xs text-on-surface-variant">A promover</p>
    </div>
    <div class="bg-surface-container-low rounded-lg p-3 border border-outline-variant/30">
        <p class="text-2xl font-bold text-amber-600">@Model.ExcludedCount</p>
        <p class="text-xs text-on-surface-variant">Repitentes (Excluidos)</p>
    </div>
    <div class="bg-surface-container-low rounded-lg p-3 border border-outline-variant/30">
        <p class="text-2xl font-bold text-emerald-600">@Model.ToGraduateCount</p>
        <p class="text-xs text-on-surface-variant">A egresar</p>
    </div>
</div>

<div class="mb-4">
    <h4 class="text-xs font-bold uppercase text-on-surface-variant mb-2">Previsualización de Cambios por Elector</h4>
    <div class="max-h-56 overflow-y-auto border border-outline-variant/40 rounded-lg bg-surface-container-lowest text-xs">
        <table class="w-full text-left">
            <thead class="bg-surface-container-low sticky top-0 border-b border-outline-variant/40">
                <tr>
                    <th class="px-3 py-2">Elector</th>
                    <th class="px-3 py-2">Grado Actual</th>
                    <th class="px-3 py-2">Resultado Promoción</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/20">
                @if (Model.PreviewList != null && Model.PreviewList.Any())
                {
                    foreach (var item in Model.PreviewList.Take(15))
                    {
                        <tr>
                            <td class="px-3 py-1.5 font-medium">@item.FullName</td>
                            <td class="px-3 py-1.5">@item.CurrentGrade</td>
                            <td class="px-3 py-1.5">
                                @if (item.Outcome.StartsWith("PROMOVIDO"))
                                {
                                    <span class="text-primary font-semibold">@item.Outcome</span>
                                }
                                else if (item.Outcome.StartsWith("EGRESADO"))
                                {
                                    <span class="text-emerald-600 font-semibold">@item.Outcome</span>
                                }
                                else
                                {
                                    <span class="text-amber-600 font-semibold">@item.Outcome</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.PreviewList.Count > 15)
                    {
                        <tr>
                            <td colspan="3" class="px-3 py-2 text-center text-on-surface-variant italic">
                                ... y @(Model.PreviewList.Count - 15) electores adicionales.
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-3 py-4 text-center text-on-surface-variant">
                            No hay electores activos registrados para promover.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-xs text-on-surface-variant mb-4 bg-surface-container-low p-2.5 rounded-lg">
    <span class="font-semibold">Nota de trazabilidad:</span> Esta acción es masiva y quedará registrada en el log de auditoría. Los electores repitentes mantendrán su grado y se restablecerá su bandera de exclusión para el próximo periodo.
</p>

<form action="/AdminCensus/RunPromotion" method="post" class="flex gap-3" onsubmit="return confirm('¿Está seguro de ejecutar la promoción de año lectivo para todos los electores? Esta acción modificará los grados en la base de datos.');">
    @if (Model.HasRunThisYear)
    {
        <input type="hidden" name="force" value="true" />
    }
    <button type="button" onclick="document.getElementById('promotion-modal').classList.add('hidden')" class="flex-1 border border-outline-variant rounded-lg py-2.5 font-semibold text-sm hover:bg-surface-container-low transition-colors">
        Cancelar
    </button>
    <button type="submit" class="flex-1 bg-primary text-on-primary rounded-lg py-2.5 font-semibold text-sm hover:bg-primary/90 transition-colors">
        @(Model.HasRunThisYear ? "Forzar Promoción" : "Ejecutar Promoción")
    </button>
</form>

