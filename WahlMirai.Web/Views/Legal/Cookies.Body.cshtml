@model WahlMirai.Web.ViewModels.LegalViewModel

<div lang="es" class="space-y-6 text-on-surface leading-relaxed text-sm">
    <section class="space-y-2">
        <h3 class="text-base font-semibold text-on-surface">1. Declaración General y Ausencia de Publicidad o Analítica</h3>
        <p>
            Wahl Mirai utiliza exclusivamente <strong>cookies técnicas y funcionales</strong> necesarias para la seguridad de la sesión, la integridad de las solicitudes y la selección de preferencias del usuario.
        </p>
        <div class="p-3 bg-surface-container-high border border-border-subtle rounded-xl text-xs text-on-surface">
            <strong>Declaración de no rastreo:</strong> La plataforma <strong>no utiliza cookies con fines publicitarios, no implementa herramientas de analítica ni seguimiento de terceros</strong>, y no realiza perfilamiento comercial de los estudiantes.
        </div>
    </section>

    <!-- Inventario de Cookies -->
    <section class="space-y-3">
        <h3 class="text-base font-semibold text-on-surface">2. Inventario de Cookies Utilizadas</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border border-border-subtle rounded-xl overflow-hidden">
                <thead class="bg-surface-container text-on-surface font-semibold border-b border-border-subtle">
                    <tr>
                        <th class="p-2.5">Nombre</th>
                        <th class="p-2.5">Origen / Tipo</th>
                        <th class="p-2.5">HttpOnly</th>
                        <th class="p-2.5">Secure</th>
                        <th class="p-2.5">SameSite</th>
                        <th class="p-2.5">Duración</th>
                        <th class="p-2.5">Finalidad / Propósito</th>
                        <th class="p-2.5">Clasificación</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle text-on-surface-variant">
                    <tr>
                        <td class="p-2.5 font-mono text-primary font-semibold">.AspNetCore.Cookies</td>
                        <td class="p-2.5">Servidor (autenticación)</td>
                        <td class="p-2.5">Sí</td>
                        <td class="p-2.5">Sí (en producción HTTPS)</td>
                        <td class="p-2.5 font-mono">Lax</td>
                        <td class="p-2.5">2 horas</td>
                        <td class="p-2.5">Mantener la sesión autenticada y validar sesión única activa.</td>
                        <td class="p-2.5 font-medium text-primary">Estrictamente Necesaria</td>
                    </tr>
                    <tr>
                        <td class="p-2.5 font-mono text-primary font-semibold">wm_reg_ticket</td>
                        <td class="p-2.5">Servidor (auto-registro)</td>
                        <td class="p-2.5">Sí</td>
                        <td class="p-2.5">Sí (en HTTPS)</td>
                        <td class="p-2.5 font-mono">Strict</td>
                        <td class="p-2.5">15 minutos (se elimina al completar o cancelar el registro)</td>
                        <td class="p-2.5">Vincular temporalmente el flujo de verificación OTP.</td>
                        <td class="p-2.5 font-medium text-primary">Estrictamente Necesaria</td>
                    </tr>
                    <tr>
                        <td class="p-2.5 font-mono text-primary font-semibold">.AspNetCore.Antiforgery.*</td>
                        <td class="p-2.5">Servidor (seguridad)</td>
                        <td class="p-2.5">Sí</td>
                        <td class="p-2.5">Sí (en HTTPS)</td>
                        <td class="p-2.5 font-mono">Strict</td>
                        <td class="p-2.5">Sesión</td>
                        <td class="p-2.5">Prevención de ataques CSRF en formularios.</td>
                        <td class="p-2.5 font-medium text-primary">Seguridad / Esencial</td>
                    </tr>
                    <tr>
                        <td class="p-2.5 font-mono text-primary font-semibold">CurrentCulture</td>
                        <td class="p-2.5">Cliente (preferencias)</td>
                        <td class="p-2.5">No</td>
                        <td class="p-2.5">Sí (en HTTPS)</td>
                        <td class="p-2.5 font-mono">Lax</td>
                        <td class="p-2.5">365 días</td>
                        <td class="p-2.5">Recordar el idioma seleccionado por el usuario.</td>
                        <td class="p-2.5 font-medium text-primary">Funcional</td>
                    </tr>
                    <tr>
                        <td class="p-2.5 font-mono text-primary font-semibold">.AspNetCore.Culture</td>
                        <td class="p-2.5">Cliente (preferencias)</td>
                        <td class="p-2.5">No</td>
                        <td class="p-2.5">Sí (en HTTPS)</td>
                        <td class="p-2.5 font-mono">Lax</td>
                        <td class="p-2.5">365 días</td>
                        <td class="p-2.5">Recordar el idioma seleccionado por el usuario.</td>
                        <td class="p-2.5 font-medium text-primary">Funcional</td>
                    </tr>
                    <tr>
                        <td class="p-2.5 font-mono text-primary font-semibold">theme</td>
                        <td class="p-2.5">Cliente (preferencias)</td>
                        <td class="p-2.5">No</td>
                        <td class="p-2.5">Sí (en HTTPS)</td>
                        <td class="p-2.5 font-mono">Lax</td>
                        <td class="p-2.5">365 días (se emite únicamente cuando el usuario cambia manualmente el tema)</td>
                        <td class="p-2.5">Respaldo de preferencia visual claro/oscuro.</td>
                        <td class="p-2.5 font-medium text-primary">Funcional</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Almacenamiento Web (LocalStorage / SessionStorage) -->
    <section class="space-y-2">
        <h3 class="text-base font-semibold text-on-surface">3. Almacenamiento en el Navegador (Web Storage)</h3>
        <p>El sistema utiliza almacenamiento local y de sesión del navegador exclusivamente para funciones operativas:</p>
        <ul class="list-disc pl-5 space-y-1 text-on-surface-variant">
            <li><strong><code>localStorage['theme']</code>:</strong> Almacenamiento principal de la preferencia de tema claro/oscuro (la cookie <code>theme</code> actúa como respaldo).</li>
            <li><strong><code>localStorage['wm_ayuda_banner_seen']</code>:</strong> Registra que el usuario cerró el banner informativo de primera visita en la sección de Ayuda.</li>
            <li><strong><code>sessionStorage['pqr_draft_escalation']</code>:</strong> Almacena temporalmente el borrador de conversación al escalar desde el chatbot de ayuda y <strong>se elimina automáticamente al cargar el formulario de creación de PQR</strong> (tras precargar asunto y mensaje) o al cerrar la pestaña del navegador.</li>
        </ul>
    </section>

    <!-- Recursos Estáticos Locales y Autonomía -->
    <section class="space-y-2">
        <h3 class="text-base font-semibold text-on-surface">4. Recursos Estáticos Locales y Alojamiento Interno</h3>
        <p>
            Todos los recursos estáticos requeridos por la plataforma (incluyendo tipografías Inter y Courier Prime, iconos Material Symbols y librerías JavaScript como SignalR) se encuentran alojados y son servidos localmente desde el propio servidor de la aplicación.
        </p>
        <p class="text-on-surface-variant">
            La plataforma no realiza peticiones ni transfiere direcciones IP de los usuarios a redes de terceros o CDNs (tales como Google Fonts o Cloudflare CDN), garantizando la privacidad de los electores y la resiliencia operativa en redes institucionales o escolares sin salida a Internet externa.
        </p>
    </section>
</div>
