@model WahlMirai.Web.ViewModels.LegalViewModel
@{
    Layout = (User.IsInRole(Roles.AdminName) || User.IsInRole(Roles.SuperAdminName))
        ? "_AdminLayout"
        : (User.Identity?.IsAuthenticated == true ? "_ElectorLayout" : "_Layout");

    ViewData["Title"] = "Marco Legal y Políticas";
}

<div class="p-4 md:p-8 max-w-4xl mx-auto w-full space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border-subtle pb-5">
        <div>
            <div class="flex items-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1 text-xs">
                    <span class="material-symbols-outlined text-base">arrow_back</span>
                    <span>Volver al Inicio</span>
                </a>
            </div>
            <h1 class="text-2xl font-bold text-on-surface mt-1">Marco Legal y Políticas</h1>
            <p class="text-xs text-on-surface-variant">Centro de transparencia, privacidad y condiciones de uso de Wahl Mirai.</p>
        </div>
        <div class="text-xs text-on-surface-variant bg-surface-container p-3 rounded-xl border border-border-subtle shrink-0">
            <div><span class="font-semibold text-on-surface">Versión:</span> @Model.Version</div>
            <div><span class="font-semibold text-on-surface">Última actualización:</span> @Model.LastUpdated</div>
        </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
        <!-- Tarjeta Privacidad -->
        <a asp-controller="Legal" asp-action="Privacidad" class="bg-surface-container-low hover:bg-surface-container transition p-5 rounded-2xl border border-border-subtle flex flex-col justify-between gap-3 group">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-primary font-semibold">
                    <span class="material-symbols-outlined">security</span>
                    <span>Política de Privacidad</span>
                </div>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    Tratamiento de datos personales, régimen especial de menores de edad, garantías del secreto del voto y procedimiento para el ejercicio de derechos (Ley 1581 de 2012).
                </p>
            </div>
            <div class="text-xs text-primary font-medium flex items-center gap-1 mt-2 group-hover:translate-x-1 transition-transform">
                <span>Consultar política</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </div>
        </a>

        <!-- Tarjeta Cookies -->
        <a asp-controller="Legal" asp-action="Cookies" class="bg-surface-container-low hover:bg-surface-container transition p-5 rounded-2xl border border-border-subtle flex flex-col justify-between gap-3 group">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-primary font-semibold">
                    <span class="material-symbols-outlined">cookie</span>
                    <span>Política de Cookies</span>
                </div>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    Inventario de cookies técnicas y almacenamiento local en el navegador. Ausencia de rastreo analítico o comercial y mención de proveedores de recursos estáticos.
                </p>
            </div>
            <div class="text-xs text-primary font-medium flex items-center gap-1 mt-2 group-hover:translate-x-1 transition-transform">
                <span>Ver inventario</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </div>
        </a>

        <!-- Tarjeta Términos -->
        <a asp-controller="Legal" asp-action="Terminos" class="bg-surface-container-low hover:bg-surface-container transition p-5 rounded-2xl border border-border-subtle flex flex-col justify-between gap-3 group">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-primary font-semibold">
                    <span class="material-symbols-outlined">description</span>
                    <span>Términos y Condiciones</span>
                </div>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    Reglamento de uso de la plataforma, roles del sistema, deber de custodia de credenciales, sesión única activa y normas del proceso electoral y candidaturas.
                </p>
            </div>
            <div class="text-xs text-primary font-medium flex items-center gap-1 mt-2 group-hover:translate-x-1 transition-transform">
                <span>Leer términos</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </div>
        </a>

        <!-- Tarjeta Contacto -->
        <a asp-controller="Legal" asp-action="Contacto" class="bg-surface-container-low hover:bg-surface-container transition p-5 rounded-2xl border border-border-subtle flex flex-col justify-between gap-3 group">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-primary font-semibold">
                    <span class="material-symbols-outlined">contact_support</span>
                    <span>Canales de Contacto</span>
                </div>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    Mecanismos de comunicación directa con la institución, canal de atención de Habeas Data y acceso al centro de Ayuda y radicación de PQR.
                </p>
            </div>
            <div class="text-xs text-primary font-medium flex items-center gap-1 mt-2 group-hover:translate-x-1 transition-transform">
                <span>Ver canales</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </div>
        </a>
    </div>
</div>
