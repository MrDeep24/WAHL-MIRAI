@model WahlMirai.Web.ViewModels.LegalViewModel
@{
    Layout = (User.IsInRole(Roles.AdminName) || User.IsInRole(Roles.SuperAdminName))
        ? "_AdminLayout"
        : (User.Identity?.IsAuthenticated == true ? "_ElectorLayout" : "_Layout");

    ViewData["Title"] = "Canales de Contacto";
}

<div class="p-4 md:p-8 max-w-4xl mx-auto w-full space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border-subtle pb-5">
        <div>
            <div class="flex items-center gap-2">
                <a asp-controller="Legal" asp-action="Index" class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1 text-xs">
                    <span class="material-symbols-outlined text-base">arrow_back</span>
                    <span>Volver a Marco Legal</span>
                </a>
            </div>
            <h1 class="text-2xl font-bold text-on-surface mt-1">Canales de Contacto</h1>
        </div>
        <div class="text-xs text-on-surface-variant bg-surface-container p-3 rounded-xl border border-border-subtle shrink-0">
            <div><span class="font-semibold text-on-surface">Versión:</span> @Model.Version</div>
            <div><span class="font-semibold text-on-surface">Última actualización:</span> @Model.LastUpdated</div>
        </div>
    </div>

    <nav aria-label="Marco Legal y Políticas" class="flex flex-wrap gap-2 text-xs">
        <a asp-controller="Legal" asp-action="Privacidad" class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-colors border border-border-subtle">Política de Privacidad</a>
        <a asp-controller="Legal" asp-action="Cookies" class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-colors border border-border-subtle">Política de Cookies</a>
        <a asp-controller="Legal" asp-action="Terminos" class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant transition-colors border border-border-subtle">Términos y Condiciones</a>
        <span aria-current="page" class="px-3 py-1.5 rounded-lg bg-primary/10 text-primary font-semibold border border-primary/20">Canales de Contacto</span>
    </nav>

    <div role="note" class="flex items-center gap-2.5 p-3.5 bg-surface-container rounded-xl border border-border-subtle text-xs text-on-surface-variant">
        <span class="material-symbols-outlined text-primary text-base shrink-0">info</span>
        <span>Este documento oficial vinculante se publica en español, idioma institucional conforme a la legislación aplicable.</span>
    </div>

    <div class="bg-surface-container-lowest p-6 rounded-2xl border border-border-subtle shadow-sm">
        <partial name="Contacto.Body" model="Model" />
    </div>
</div>
