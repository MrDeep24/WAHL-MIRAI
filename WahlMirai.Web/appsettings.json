{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "LoginPermitPerMinute": 180,
    "RecoveryPermitPerMinute": 30,
    "RegisterPermitPerMinute": 180,
    "RegisterFailureThreshold": 30
  },
  "CandidacyUploads": {
    "BasePath": "App_Data/candidacy-uploads"
  },
  "DataProtection": {
    // Ruta donde se persisten las llaves de Data Protection.
    // IMPORTANTE: En despliegues con contenedores o múltiples instancias, esta ruta
    // DEBE apuntar a un volumen compartido (ej. NFS, Azure Blob, AWS S3).
    // Si las llaves se pierden, los documentos cifrados quedan IRRECUPERABLES.
    // Sobreescribir con variable de entorno: DataProtection__KeysPath=/ruta/segura
    "KeysPath": "keys"
  },
  "EmailSettings": {
    "BaseUrl": "",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "",
    "SenderPassword": "",
    "SenderDisplayName": "Wahl Mirai — Gestión Electoral",
    "UseStartTls": true,
    "RateLimitPerMinute": 20
  },
  "Institution": {
    "Name": "",
    "Nit": "",
    "Address": "",
    "City": "",
    "ContactEmail": "",
    "DataProtectionEmail": "",
    "RetentionNote": "",
    "HostingProvider": "",
    "HostingRegion": "",
    "RequireLegalData": false
  }
}